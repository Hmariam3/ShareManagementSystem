@model Shareholder_Management_System.ViewModel.UserProfileViewModel
@{
    ViewBag.Title = "User Profile";
    var resetPasswordModel = new Shareholder_Management_System.Models.ResetPasswordViewModel();
}

<!-- Include SweetAlert2 and Select2 CSS/JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm//typography@0.5.10/dist/typography.min.css">
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.12.0/dist/cdn.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-datatables@1.13.4/dist/jquery.dataTables.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jquery-datatables@1.13.4/dist/jquery.dataTables.min.css" />

<!-- Notification Script -->
@if (TempData["Message"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            Swal.fire({
                toast: true,
                position: 'top-right',
                icon: 'info',
                title: '@TempData["Message"]',
                showConfirmButton: false,
                timer: 5000,
                timerProgressBar: true,
                showCloseButton: true
            });
        });
    </script>
}

<!-- Success/Error Popups -->
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            Swal.fire({
                toast: true,
                position: 'top-right',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                showCloseButton: true
            });
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            Swal.fire({
                toast: true,
                position: 'top-right',
                icon: 'error',
                title: '@TempData["ErrorMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                showCloseButton: true
            });
        });
    </script>
}

<!-- Main Content -->
<div class="min-h-screen bg-gray-100 dark:bg-gray-900 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto" x-data="{ activeTab: 1 }">
        <!-- Tab Navigation -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg mb-6">
            <div class="border-b border-gray-200 dark:border-gray-700">
                <nav class="flex space-x-2 p-4" aria-label="Tabs">
                    <button class="flex-1 py-3 px-4 text-sm font-medium text-center rounded-lg transition-colors duration-200"
                            :class="{ 'bg-blue-500 text-white': activeTab === 1, 'bg-gray-100 text-gray-500 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600': activeTab !== 1 }"
                            @@click="activeTab = 1">
                        <svg class="h-5 w-5 mx-auto mb-1 inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 13.121a4 4 0 010-5.656L9.879 2.707a4 4 0 015.656 0l4.758 4.758a4 4 0 010 5.656L14.121 19.88a4 4 0 01-5.656 0l-4.758-4.758z" />
                        </svg>
                        User Information
                    </button>
                    <button class="flex-1 py-3 px-4 text-sm font-medium text-center rounded-lg transition-colors duration-200"
                            :class="{ 'bg-blue-500 text-white': activeTab === 2, 'bg-gray-100 text-gray-500 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600': activeTab !== 2 }"
                            @@click="activeTab = 2">
                        <svg class="h-5 w-5 mx-auto mb-1 inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-7a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        User Activity
                    </button>
                </nav>
            </div>
        </div>

        <!-- Tab Content -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
            <!-- User Information Tab -->
            <div x-show="activeTab === 1" x-transition>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">User Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Full Name</span>
                        <span class="text-lg font-semibold text-gray-900 dark:text-white">@Model.User.FullName</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Username</span>
                        <span class="text-lg font-semibold text-gray-900 dark:text-white">@Model.User.UserName</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Status</span>
                        <span class="text-lg font-semibold text-gray-900 dark:text-white">
                            @(Model.User.Status.HasValue ? (Model.User.Status.Value ? "Active" : "Inactive") : "Unknown")
                        </span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Role</span>
                        <span class="text-lg font-semibold text-gray-900 dark:text-white">@Model.User.Role</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Creation Date</span>
                        <span class="text-lg font-semibold text-gray-900 dark:text-white">@Model.User.CreatedDate</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Branch</span>
                        <span class="text-lg font-semibold text-gray-900 dark:text-white">@Model.User.Branch1.BranchName</span>
                    </div>
                </div>
            </div>

            <!-- User Activity Tab -->
            <div x-show="activeTab === 2" x-transition>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">User Activity</h2>
                @if (Model.AuditLogs != null && Model.AuditLogs.Any())
                {
                    <div class="overflow-x-auto">
                        <table id="auditLogTable" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                            <thead class="bg-gray-50 dark:bg-gray-700">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Performed Type</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Action Type</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Message</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Branch</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Date</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Action</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                                @foreach (var log in Model.AuditLogs)
                                {
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@log.TableName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white uppercase">@log.ActionType</td>
                                        <td class="px-6 py-4 text-sm text-gray-900 dark:text-white">@log.Message</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@log.PerformerBranch</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@log.TransactionDate</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            @if (log.TableName == "User")
                                            {
                                                string encryptedId = TripleDESEncryptionHelper.Encrypt(log.TransactionID.ToString());
                                                string encodedId = HttpUtility.UrlEncode(encryptedId);
                                                <a href="@Url.Action("View", "Users", new { id = encodedId })" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
                                                    <svg class="h-5 w-5 inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 5c-7 0-9 7-9 7s2 7 9 7 9-7 9-7-2-7-9-7z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3z" />
                                                    </svg>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-gray-500 dark:text-gray-400 mt-4">No activity logs found for this user.</p>
                }
            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex justify-between mt-6">
            <button type="button"
                    class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors duration-200"
                    :disabled="activeTab === 1"
                    @@click="activeTab--">
                Previous
            </button>
            <button type="button"
                    class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors duration-200"
                    :disabled="activeTab === 2"
                    @@click="activeTab++">
                Next
            </button>
        </div>
    </div>
</div>

<!-- DataTable Initialization -->
<script>
    $(document).ready(function () {
        $('#auditLogTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50, 100],
            ordering: true,
            searching: true,
            paging: true,
            responsive: true
        });
    });
</script>