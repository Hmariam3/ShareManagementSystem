@model Shareholder_Management_System.ViewModel.UserProfileViewModel
@{
    /**/

    var resetPasswordModel = new Shareholder_Management_System.Models.ResetPasswordViewModel();
}


@{
    ViewBag.Title = "Profile";
}

<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>

<!-- basic -->
<div class="mb-5" x-data="{ activeTab: 1 }">
    <div class="inline-block w-full">
        <ul class="mb-5 grid grid-cols-3 text-center">
            <li>
                <a href="javascript:void(0);"
                   class="bg-[#f3f2ee] dark:bg-[#1b2e4b] p-2 block rounded-full"
                   :class="{ '!bg-primary text-white': activeTab === 1 }"
                   x-on:click="activeTab = 1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 13.121a4 4 0 010-5.656L9.879 2.707a4 4 0 015.656 0l4.758 4.758a4 4 0 010 5.656L14.121 19.88a4 4 0 01-5.656 0l-4.758-4.758z" />
                    </svg>
                    <span class="block mt-1 text-sm">User Information</span>
                </a>
            </li>
            <li>
                <a href="javascript:void(0);"
                   class="bg-[#f3f2ee] dark:bg-[#1b2e4b] p-2 block rounded-full"
                   :class="{ '!bg-primary text-white': activeTab === 2 }"
                   x-on:click="activeTab = 2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-7a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="block mt-1 text-sm">User Activity</span>
                </a>
            </li>
            <li>
                <a href="javascript:void(0);"
                   class="bg-[#f3f2ee] dark:bg-[#1b2e4b] p-2 block rounded-full"
                   :class="{ '!bg-primary text-white': activeTab === 3 }"
                   x-on:click="activeTab = 3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0-3 1.5-5 3-6 1.5 0 3 2 3 6h0a9 9 0 11-18 0h0c0-4 1.5-6 3-6 1.5 0 3 3 3 6" />
                    </svg>
                    <span class="block mt-1 text-sm">Reset Password</span>
                </a>
            </li>
        </ul>

        <div>
            <!-- Tab Content -->
            <div x-show="activeTab === 1" class="bg-white shadow-md rounded-lg overflow-hidden panel">
                <div class="max-w-4xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg panel">
                    <h2 class="text-3xl font-bold text-gray-800 mb-8 border-b pb-2">User Details</h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-600">Full Name</span>
                            <span class="text-gray-400 font-extrabold">@Model.User.FullName</span>
                        </div>

                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-600">Username</span>
                            <span class="text-gray-400 font-extrabold">@Model.User.UserName</span>
                        </div>

                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-600">@Model.User.Status</span>
                            <span class="text-gray-400 font-extrabold">
                                @if (Model.User.Status)
                                {
                                    <span class="text-gray-400 font-extrabold">Active</span>
                                }
                                else
                                {
                                    <span class="text-gray-400 font-extrabold">Inactive</span>
                                }
                            </span>
                        </div>

                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-600">Role</span>
                            <span class="text-gray-400 font-extrabold">@Model.User.Role</span>
                        </div>

                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-600">Creation Date</span>
                            <span class="text-gray-400 font-extrabold">@Model.User.CreatedDate</span>
                        </div>

                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-600">Branch</span>
                            <span class="text-gray-400 font-extrabold">@Model.User.Branch1.BranchName</span>
                        </div>
                    </div>
                </div>
            </div>
            <div x-show="activeTab === 2" class="bg-white shadow-md rounded-lg overflow-hidden panel">
                <!-- User Activity Logs -->
                <h3 class="text-2xl font-bold text-gray-800 mt-10">User Activity</h3>
                @if (Model.AuditLogs != null && Model.AuditLogs.Any())
                {
                    <table id="auditLogTable" class="min-w-full table-auto mt-6 panel">
                        <thead class="panel">
                            <tr>
                                <th class="px-4 py-2">Performed On</th>
                                <th class="px-4 py-2">Action Type</th>
                                <th class="px-4 py-2">Message</th>
                                <th class="px-4 py-2">Branch Performed In</th>
                                <th class="px-4 py-2">Performed Date</th>
                            </tr>
                        </thead>
                        <tbody class="panel">
                            @foreach (var log in Model.AuditLogs)
                            {
                                <tr>
                                    <td class="border px-4 py-2">@log.TableName</td>
                                    <td class="border px-4 py-2" style="text-transform: uppercase;">@log.ActionType</td>
                                    <td class="border px-4 py-2">@log.Message</td>
                                    <td class="border px-4 py-2">@log.PerformerBranch</td>
                                    <td class="border px-4 py-2">@log.TransactionDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-gray-600 mt-4">No activity logs found for this user.</p>
                }
            </div>
            <div x-show="activeTab === 3" class="bg-white shadow-md rounded-lg overflow-hidden panel">
                <div class="max-w-lg mx-auto my-10 p-6 bg-white border rounded-lg shadow-md panel">
                    <h2 class="text-2xl font-semibold mb-6">Reset Password</h2>
                    @using (Html.BeginForm("ResetPasswordOwn", "Users", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="CurrentPassword" class="block text-gray-700 font-medium mb-2">Current Password</label>
                            @Html.EditorFor(model => resetPasswordModel.CurrentPassword, new { htmlAttributes = new { @class = "form-input mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", type = "password" } })
                            @Html.ValidationMessageFor(model => resetPasswordModel.CurrentPassword, "", new { @class = "text-red-500" })
                        </div>

                        <div class="mb-4">
                            <label for="NewPassword" class="block text-gray-700 font-medium mb-2">New Password</label>
                            @Html.EditorFor(model => resetPasswordModel.NewPassword, new { htmlAttributes = new { @class = "form-input mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", type = "password" } })
                            @Html.ValidationMessageFor(model => resetPasswordModel.NewPassword, "", new { @class = "text-red-500" })
                        </div>

                        <div class="mb-4">
                            <label for="ConfirmPassword" class="block text-gray-700 font-medium mb-2">Confirm Password</label>
                            @Html.EditorFor(model => resetPasswordModel.ConfirmPassword, new { htmlAttributes = new { @class = "form-input mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", type = "password" } })
                            @Html.ValidationMessageFor(model => resetPasswordModel.ConfirmPassword, "", new { @class = "text-red-500" })
                        </div>

                        <div class="flex justify-end">
                            <button type="submit" class="px-4 py-2 bg-blue-500 text-white font-semibold rounded-md shadow-sm hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50" style="background-color: darkblue;">
                                Reset Password
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>
        <div class="flex justify-between mt-4">
            <button type="button" class="btn btn-primary"
                    :disabled="activeTab === 1"
                    x-on:click="activeTab--">
                Back
            </button>
            <button type="button" class="btn btn-primary"
                    :disabled="activeTab === 3"
                    x-on:click="activeTab++">
                Next
            </button>
        </div>
    </div>
</div>



@if (TempData["SuccessMessage"] != null)
{
    <div id="successPopup" class="fixed top-0 right-0 z-50 hidden" style="color: green;">
        <div class="bg-green-500 border border-green-400 text-white px-4 py-3 rounded-l-lg shadow-lg m-4" style="color: green;" role="alert">
            <strong class="font-bold">Success:</strong>
            <span class="block sm:inline">@TempData["SuccessMessage"]</span>
            <button id="closeSuccess" class="absolute top-0 right-0 mt-1 mr-2 text-white">&times;</button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorPopup" class="fixed top-5 right-0 z-50 hidden" style="color: red;">
        <div class="bg-red-500 border border-red-400 text-white px-4 py-3 rounded-l-lg shadow-lg m-4" style="color: red;" role="alert">
            <strong class="font-bold">Error:</strong>
            <span class="block sm:inline">@TempData["ErrorMessage"]</span>
            <button id="closeError" class="absolute top-0 right-0 mt-1 mr-2 text-white">&times;</button>
        </div>
    </div>
}

<script>
    // Show and hide the success popup if it exists
    if (document.getElementById("successPopup")) {
        document.getElementById("successPopup").classList.remove("hidden");

        // Automatically hide after 3 seconds
        setTimeout(function () {
            document.getElementById("successPopup").classList.add("hidden");
        }, 3000);

        document.getElementById("closeSuccess").onclick = function () {
            document.getElementById("successPopup").classList.add("hidden");
        };
    }

    // Show and hide the error popup if it exists
    if (document.getElementById("errorPopup")) {
        document.getElementById("errorPopup").classList.remove("hidden");

        // Automatically hide after 3 seconds
        setTimeout(function () {
            document.getElementById("errorPopup").classList.add("hidden");
        }, 3000);

        document.getElementById("closeError").onclick = function () {
            document.getElementById("errorPopup").classList.add("hidden");
        };
    }
</script>



<script>
    $(document).ready(function () {
        $('#auditLogTable').DataTable({
            "pageLength": 5,  // Show 5 records per page
            "lengthMenu": [5, 10, 25, 50, 100], // Custom options for number of records per page
            "ordering": true,  // Enable column sorting
            "searching": false, // Enable search functionality
            "paging": true,    // Enable pagination
        });
    });
</script>
