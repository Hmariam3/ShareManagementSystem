@model Shareholder_Management_System.Models.User

@{
    ViewBag.Title = "Details";
}


<link rel="stylesheet" type="text/css" media="screen" href="~/css/all.min.css" />
<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>

<div class="bg-white shadow-md rounded-lg overflow-hidden panel">
    <div class="max-w-4xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md panel">
        <h2 class="text-2xl font-bold dark:text-white-light mb-6">User Details</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <div class="font-semibold text-gray-600">@Html.DisplayNameFor(model => model.FullName)</div>
                <div class="text-gray-400 font-extrabold">@Html.DisplayFor(model => model.FullName)</div>
            </div>

            <div>
                <div class="font-semibold text-gray-600">@Html.DisplayNameFor(model => model.UserName)</div>
                <div class="text-gray-400 font-extrabold">@Html.DisplayFor(model => model.UserName)</div>
            </div>

            <div>
                <div class="font-semibold text-gray-600">@Html.DisplayNameFor(model => model.Status)</div>
                <div class="text-gray-400 font-extrabold">
                    @if (Model.Status ?? false)
                    {
                        <span class="text-green-500">Active</span>
                    }
                    else
                    {
                        <span class="text-red-500">Inactive</span>
                    }
                </div>

            </div>

            <div>
                <div class="font-semibold text-gray-600">@Html.DisplayNameFor(model => model.Role)</div>
                <div class="text-gray-400 font-extrabold">@Html.DisplayFor(model => model.Role)</div>
            </div>

            <div>
                <div class="font-semibold text-gray-600">@Html.DisplayNameFor(model => model.CreatedDate)</div>
                <div class="text-gray-400 font-extrabold">@Html.DisplayFor(model => model.CreatedDate)</div>
            </div>

            <div>
                <div class="font-semibold text-gray-600">@Html.DisplayNameFor(model => model.Branch1.BranchName)</div>
                <div class="text-gray-400 font-extrabold">@Html.DisplayFor(model => model.Branch1.BranchName)</div>
            </div>
        </div>

        <div class="mt-8 flex justify-end space-x-4">
            @{
                string encryptedId = TripleDESEncryptionHelper.Encrypt(Model.UID.ToString());
            }
            <a href="@Url.Action("Edit", new { id = encryptedId })" class="flex items-center text-teal-500 hover:text-teal-700 font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 11l3.536-3.536a1.5 1.5 0 112.121 2.122L11 13m1-1L9 15l-2 2m2-2l3 3 5-5-2.828-2.828a1.5 1.5 0 00-2.122 0L11 11z" />
                </svg>Edit
            </a>
            <a href="@Url.Action("Index")" class="flex items-center text-gray-600 hover:text-gray-800 font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg> Back to List
            </a>
        </div>
    </div>
</div>