﻿@model Shareholder_Management_System.Models.User

@{
    ViewBag.Title = "Create";
}

<link rel="stylesheet" type="text/css" media="screen" href="~/css/all.min.css" />
<link href="~/css/tailwind.min.css" rel="stylesheet" type="text/css" media="screen" />

<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>

<!-- Modal Structure -->
@if (TempData["Message"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
        @TempData["Message"]
    </div>
}

<div class="bg-white shadow-md rounded-lg overflow-hidden panel">
    <div class="user-form-container bg-white p-8 rounded-lg shadow-lg max-w-4xl mx-auto mt-10 panel">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="text-center mb-6">
                <h2 class="text-3xl font-bold text-dark dark:text-white-light mb-4" padding: 15px; border-radius: 8px;">
                    Create User Account
                </h2>
                @Html.ValidationSummary(true, "", new { @class = "text-red-500 mb-4" })
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="form-group">
                    @Html.LabelFor(model => model.FullName, new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                    @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" } })
                    @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.UserName, new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                    @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" } })
                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Password, new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { type = "password", @class = "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Role, new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                    @Html.DropDownListFor(model => model.Role,
                        new SelectList(new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Administrator", Value = "Administrator" },
                            new SelectListItem { Text = "Initiator", Value = "Initiator" },
                            new SelectListItem { Text = "Authorizer", Value = "Authorizer" }
                        }, "Value", "Text"),
                        "Select Role",
                        new { @class = "form-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" })
                    @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group col-span-2">
                    @Html.LabelFor(model => model.Branch, "Branch", new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })

                    <div style="position: relative;">
                        <input type="text" id="branch-search" class="form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" placeholder="Search for a branch..." />

                        <div id="branch-results" class="mt-2"></div>
                    </div>

                    @Html.HiddenFor(model => model.Branch, new { @id = "Branch" }) <!-- Hidden input for storing selected branch ID -->

                    @Html.ValidationMessageFor(model => model.Branch, "", new { @class = "text-red-500 text-sm" })
                </div>
            </div>
            <!-- Save Button and Back Link -->
            <div style="display: flex; justify-content: center; align-items: center; margin-top: 10px;">
                <button type="submit"
                        style="background-color: #00ADEF; color: white; display: block; visibility: visible; position: relative; z-index: 10; border-radius: 0.375rem; font-size: 0.875rem; padding: 0.625rem 2rem; width: 200px;"
                        class="hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                    <i class="fas fa-plus mr-2"></i> Create
                </button>
            </div>
            <div class="flex justify-between items-center mt-8" style="display: flex; justify-content: center; align-items: center; margin-bottom: 10px;">
                <a href="@Url.Action("Index")" class="flex text-sm text-blue-500 hover:text-blue-800 font-semibold">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>Back to List
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}