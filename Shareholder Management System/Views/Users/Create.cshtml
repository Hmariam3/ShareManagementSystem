@model Shareholder_Management_System.Models.User

@{
    ViewBag.Title = "Create User";
}

<style>
    :root {
        --primary-color: #00ADEF;
        --primary-dark: #0095d1;
        --bg-dark: #1a1f2d;
        --bg-card: #242837;
        --text-primary: #e2e8f0;
        --text-secondary: #94a3b8;
        --border-color: #374151;
        --input-bg: #1e2233;
        --input-border: #374151;
        --input-focus: #00ADEF;
    }

    .main-container {
        min-height: calc(100vh - 60px); /* Adjust based on your layout's header height */
        background: var(--bg-dark);
        margin: -15px; /* Counteract layout padding */
        padding: 2rem;
        color: var(--text-primary);
    }

    .page-header {
        background: linear-gradient(135deg, rgba(0, 173, 239, 0.2) 0%, rgba(0, 86, 179, 0.2) 100%);
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        border: 1px solid rgba(0, 173, 239, 0.1);
    }

    .page-title {
        font-size: 2rem;
        font-weight: 600;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .content-card {
        background: var(--bg-card);
        border-radius: 15px;
        border: 1px solid var(--border-color);
        overflow: hidden;
    }

    .card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(0, 0, 0, 0.2);
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .card-body {
        padding: 2rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

        .form-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 0.875rem 1rem;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--text-primary);
        background-color: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: 0.5rem;
        transition: all 0.2s ease-in-out;
    }

        .form-control:focus {
            border-color: var(--input-focus);
            outline: none;
            box-shadow: 0 0 0 3px rgba(0, 173, 239, 0.1);
        }

        .form-control::placeholder {
            color: var(--text-secondary);
        }

    .search-results {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        margin-top: 0.25rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        max-height: 200px;
        overflow-y: auto;
    }

    .search-item {
        padding: 0.75rem 1rem;
        cursor: pointer;
        color: var(--text-primary);
        transition: all 0.2s;
    }

        .search-item:hover {
            background: rgba(0, 173, 239, 0.1);
        }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.5;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        cursor: pointer;
        border: 1px solid transparent;
        border-radius: 0.5rem;
        transition: all 0.2s ease-in-out;
        gap: 0.5rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        border: none;
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 173, 239, 0.2);
        }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
    }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.15);
        }

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .alert {
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        color: #10b981;
    }

    .validation-message {
        color: #ef4444;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    select.form-control {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2394a3b8' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 0.75rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
        padding-right: 2.5rem;
    }

    .readonly {
        background-color: rgba(0, 0, 0, 0.2);
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: var(--bg-dark);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--text-secondary);
        }

    @@media (max-width: 768px) {
        .main-container {
            padding: 1rem;
        }

        .page-header {
            padding: 1.5rem;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .card-body {
            padding: 1.5rem;
        }

        .page-title {
            font-size: 1.5rem;
        }
    }
</style>

<div class="main-container">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Message"]</span>
        </div>
    }

    <div class="page-header">
        <h1 class="page-title">Create New User</h1>
        <p class="page-subtitle">Add a new user to the system with specific roles and permissions</p>
    </div>

    <div class="content-card">
        <div class="card-header">
            <h2 class="card-title">User Information</h2>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Back to List
            </a>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "validation-message" })

                <div class="form-grid">
                    <div class="form-group">
                        <label for="fullname-search">Full Name</label>
                        <div style="position: relative;">
                            <input type="text" id="fullname-search" class="form-control" placeholder="Search by display name..." />
                            <div id="fullname-results" class="search-results"></div>
                        </div>
                        @Html.HiddenFor(model => model.FullName, new { @id = "FullName" })
                        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "validation-message" })
                    </div>

                    <div class="form-group">
                        <label for="UserName">Username</label>
                        @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control readonly", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "validation-message" })
                    </div>

                    @Html.HiddenFor(model => model.Password, new { @value = "123456" })

                    <div class="form-group">
                        <label for="Role">Role</label>
                        @Html.DropDownListFor(model => model.Role,
                            new SelectList(new List<SelectListItem>
                            {
                                new SelectListItem { Text = "SuperAdmin", Value = "SuperAdmin" },
                                new SelectListItem { Text = "SuperUser", Value = "SuperUser" },
                                new SelectListItem { Text = "Administrator", Value = "Administrator" },
                                new SelectListItem { Text = "Initiator", Value = "Initiator" },
                                new SelectListItem { Text = "Authorizer", Value = "Authorizer" }
                            }, "Value", "Text"),
                            "Select Role",
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Role, "", new { @class = "validation-message" })
                    </div>

                    <div class="form-group">
                        <label for="branch-search">Branch</label>
                        <div style="position: relative;">
                            <input type="text" id="branch-search" class="form-control" placeholder="Search for a branch..." />
                            <div id="branch-results" class="search-results"></div>
                        </div>
                        @Html.HiddenFor(model => model.Branch, new { @id = "Branch" })
                        @Html.ValidationMessageFor(model => model.Branch, "", new { @class = "validation-message" })
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i>
                        Create User
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // LDAP FullName search
        $('#fullname-search').on('keyup', function () {
            var query = $(this).val();
            if (query.length > 2) {
                $.ajax({
                    url: '@Url.Action("SuggestDisplayNames", "Login")',
                    type: 'GET',
                    data: { term: query },
                    success: function (data) {
                        $('#fullname-results').empty();
                        if (data.success && data.suggestions.length > 0) {
                            $.each(data.suggestions, function (index, name) {
                                $('#fullname-results').append('<div class="search-item" data-name="' + name + '">' + name + '</div>');
                            });
                        } else {
                            $('#fullname-results').append('<div class="search-item">No users found</div>');
                        }
                    },
                    error: function () {
                        $('#fullname-results').empty().append('<div class="search-item">Error retrieving users</div>');
                    }
                });
            } else {
                $('#fullname-results').empty();
            }
        });

        // Handle FullName selection
        $(document).on('click', '.search-item', function () {
            var displayName = $(this).data('name');
            if (displayName) {
                $.ajax({
                    url: '@Url.Action("GetUserByDisplayName", "Login")',
                    type: 'GET',
                    data: { displayName: displayName },
                    success: function (data) {
                        if (data.success) {
                            $('#fullname-search').val(data.user.DisplayName);
                            $('#FullName').val(data.user.DisplayName);
                            $('#UserName').val(data.user.UserName);
                            $('#fullname-results').empty();
                        } else {
                            $('#fullname-results').empty().append('<div class="search-item">' + data.message + '</div>');
                        }
                    },
                    error: function () {
                        $('#fullname-results').empty().append('<div class="search-item">Error retrieving user details</div>');
                    }
                });
            }
        });

        // Branch search
        $('#branch-search').on('keyup', function () {
            var query = $(this).val();
            if (query.length > 2) {
                $.ajax({
                    url: '@Url.Action("SearchBranches", "Users")',
                    type: 'GET',
                    data: { searchTerm: query },
                    success: function (data) {
                        $('#branch-results').empty();
                        if (data.length > 0) {
                            $.each(data, function (index, branch) {
                                $('#branch-results').append('<div class="search-item" data-id="' + branch.Value + '">' + branch.Text + '</div>');
                            });
                        } else {
                            $('#branch-results').append('<div class="search-item">No branches found</div>');
                        }
                    },
                    error: function () {
                        $('#branch-results').empty().append('<div class="search-item">Error retrieving branches</div>');
                    }
                });
            } else {
                $('#branch-results').empty();
            }
        });

        // Handle Branch selection
        $(document).on('click', '#branch-results .search-item', function () {
            var branchId = $(this).data('id');
            var branchName = $(this).text();
            if (branchId) {
                $('#branch-search').val(branchName);
                $('#Branch').val(branchId);
                $('#branch-results').empty();
            }
        });

        // Close search results when clicking outside
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.form-group').length) {
                $('.search-results').empty();
            }
        });
    });
</script>