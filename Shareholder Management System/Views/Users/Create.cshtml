@model Shareholder_Management_System.Models.User

@{
    ViewBag.Title = "Create";
}

<!-- Modal Structure -->
@if (TempData["Message"] != null)
{
    @TempData["Message"];
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl text-white font-bold text-gray-800 mb-6" style="background-color: cyan;">Create User Account</h2>
        @Html.ValidationSummary(true, "", new { @class = "text-red-500 mb-4" })

        <div class="space-y-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.FullName, new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                    @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" } })
                    @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.UserName, new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                    @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" } })
                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-red-500 text-sm" })
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Password, new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Role, new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                    @Html.DropDownListFor(model => model.Role,
                        new SelectList(new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Administrator", Value = "Administrator" },
                            new SelectListItem { Text = "Initiator", Value = "Initiator" },
                            new SelectListItem { Text = "Authorizer", Value = "Authorizer" }
                        }, "Value", "Text"),
                        "Select Role",
                        new { @class = "form-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" })
                    @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-red-500 text-sm" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Branch, "Branch", new { @class = "block text-gray-700 text-sm font-bold mb-2" })

                <input type="text" id="branch-search" class="form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" placeholder="Search for a branch..." />

                <div id="branch-results" class="mt-2"></div>
                @Html.HiddenFor(model => model.Branch, new { @id = "Branch" }) <!-- Hidden input for storing selected branch ID -->

                @Html.ValidationMessageFor(model => model.Branch, "", new { @class = "text-red-500 text-sm" })
            </div>

            <div class="flex items-center justify-between">
                <button class="bg-cyan hover:bg-blue-800 text-black font-bold py-2 px-4 rounded-full border border-blue-700" style="background-color: cyan;" type="submit">
                    Create
                </button>
                <a href="@Url.Action("Index")" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800">
                    Back to List
                </a>
            </div>
        </div>
    </div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
