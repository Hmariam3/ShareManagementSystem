@model Shareholder_Management_System.Models.User

@{
    ViewBag.Title = "Edit";
}

<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>

<div class="bg-white shadow-md rounded-lg overflow-hidden panel">
    <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">Edit User</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.UID)
        <div class="space-y-6">
            @Html.ValidationSummary(true, "", new { @class = "text-red-500 mb-4" })

            <!-- Grid container for two panels -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 p-6 overflow-x-auto">
                <!-- Left panel -->
                <div>
                    <div class="form-group mb-4">
                        @Html.LabelFor(model => model.FullName, htmlAttributes: new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                        @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-red-500 text-sm" })
                    </div>

                    <div class="form-group mb-4">
                        @Html.LabelFor(model => model.UserName, htmlAttributes: new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                        @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-red-500 text-sm" })
                    </div>

                    <div class="form-group mb-4" style="display: none;">
                        @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                        @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-input mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50" } })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-red-500 text-sm" })
                    </div>

                    <div class="form-group mb-4">
                        @Html.LabelFor(model => model.Role, htmlAttributes: new { @class = "block text-gray-700 text-sm font-bold mb-2" })

                        <!-- Dropdown for Role -->
                        @Html.DropDownListFor(model => model.Role,
                            new SelectList(new List<SelectListItem>
                            {
                                new SelectListItem { Text = "SuperAdmin", Value = "SuperAdmin" },
                                new SelectListItem { Text = "SuperUser", Value = "SuperUser" },
                                new SelectListItem { Text = "Administrator", Value = "Administrator" },
                                new SelectListItem { Text = "Initiator", Value = "Initiator" },
                                new SelectListItem { Text = "Authorizer", Value = "Authorizer" }
                            }, "Value", "Text"),
                            "Select Role",
                            new { @class = "form-select mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50" })

                        @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-red-500 text-sm" })
                    </div>
                </div>

                <!-- Right panel -->
                <div>
                    <div class="form-group mb-4">
                        @Html.LabelFor(model => model.Branch, "Branch", htmlAttributes: new { @class = "block text-gray-700 text-sm font-bold mb-2" })
                        @Html.DropDownList("Branch", null, htmlAttributes: new { @class = "form-select mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 focus:ring-opacity-50", id = "BranchID" })
                        @Html.ValidationMessageFor(model => model.Branch, "", new { @class = "text-red-500 text-sm" })
                    </div>

                    <div class="form-group mb-4">
                        @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "block text-gray-700 text-sm font-bold mb-2" })

                        <!-- Display the CreatedDate as read-only -->
                        <span class="block mt-1 dark:text-white-light font-semibold font-semibold text-sm font-medium">
                            @Html.DisplayFor(model => model.CreatedDate)
                        </span>

                        <!-- Hidden field to ensure the CreatedDate is sent to the server -->
                        @Html.HiddenFor(model => model.CreatedDate)

                        @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-red-500 text-sm" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "block text-gray-700 text-sm font-bold mb-2" })

                        <!-- Conditional Display for Status -->
                        <span class="block mt-1 text-gray-700 text-sm font-medium">
                            @(Model.Status.HasValue ? (Model.Status.Value ? "Active" : "Inactive") : "Unknown")
                        </span>

                        <!-- Checkbox for boolean status -->
                        @Html.CheckBox("Status", Model.Status ?? false, new { @class = "form-checkbox mt-1" })

                        @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-red-500 text-sm" })
                    </div>
                </div>
            </div>

            <!-- Save Button and Back Link -->
            <div style="display: flex; justify-content: center; align-items: center;">
                <button type="submit"
                        style="background-color: #1d4ed8; color: white; display: block; visibility: visible; position: relative; z-index: 10; border-radius: 0.375rem; font-size: 0.875rem; padding: 0.625rem 2rem; width: 200px;"
                        class="hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                    Save
                </button>
            </div>
            <div class="flex justify-between items-center mt-8" style="display: flex; justify-content: center; align-items: center;">
                <a href="@Url.Action("Index")" class="flex items-center text-sm text-blue-500 hover:text-blue-800 font-semibold">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                    Back to List
                </a>
            </div>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        $('#BranchID').select2({
            placeholder: 'Select a Branch',
            allowClear: true
        });
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}