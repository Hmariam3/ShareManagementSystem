@model Shareholder_Management_System.ViewModel.UserAuditLogViewModel

@{
    ViewBag.Title = "View";
}

<div class="panel p-6 bg-white shadow-md rounded-lg">
    <div class="flex flex-wrap justify-between gap-4 px-4">
        <div class="text-2xl dark:text-white-light font-semibold">User Information</div>
        <div class="shrink-0 dark:text-white-light font-semibold">
            @Html.DisplayFor(model => model.User.Role)
        </div>
    </div>

    <div class="px-4 ltr:text-right rtl:text-left">
        <div class="mt-6 space-y-1 text-white-dark">
            <div class="dark:text-white-light font-semibold">@Html.DisplayFor(model => model.User.FullName)</div>
            <div class="dark:text-white-light font-semibold">@Html.DisplayFor(model => model.User.UserName)</div>
            <div class="dark:text-white-light font-semibold">@Html.DisplayFor(model => model.User.Branch1.BranchName)</div>
            <div class="dark:text-white-light font-semibold">
                Created Date: @(Model.User.CreatedDate.HasValue ? Model.User.CreatedDate.Value.ToString("dd/MM/yyyy") : "N/A")
            </div>
        </div>
    </div>

    <hr class="my-6 border-gray-300">

    <!-- Display the Latest AuditLog Data -->
    @if (Model.Message != null)
    {
        <div class="text-gray-600">
            <div class="font-semibold dark:text-white-light">Last Changed By:</div>
            <div class="font-semibold dark:text-white-light">Performed By: @Model.PerformedBy</div>
            <div class="font-semibold dark:text-white-light">Action Performed: <span class="badge rounded-full bg-info/20 text-success hover:top-0">@Model.ActionType</span></div>
            <div class="font-semibold dark:text-white-light">Transaction Date: @Model.TransactionDate.ToString("dd/MM/yyyy")</div>
        </div>
    }
    else
    {
        <div class="text-gray-600">No audit log data available for this user.</div>
    }
    <hr class="my-6 border-gray-300">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Left Column -->
        <div>
            <div class="mb-4">
                <span class="font-semibold dark:text-white-light">Full Name:</span>
                <span class="dark:text-white-light">@Html.DisplayFor(model => model.User.FullName)</span>
            </div>
            <div class="mb-4">
                <span class="dark:text-white-light font-semibold">Username:</span>
                <span class="dark:text-white-light">@Html.DisplayFor(model => model.User.UserName)</span>
            </div>
            <div class="mb-4">
                <span class="dark:text-white-light font-semibold">Branch:</span>
                <span class="dark:text-white-light">@Html.DisplayFor(model => model.User.Branch1.BranchName)</span>
            </div>
            <div class="mb-4">
                <span class="dark:text-white-light font-semibold">Role:</span>
                <span class="dark:text-white-light">@Html.DisplayFor(model => model.User.Role)</span>
            </div>
        </div>

        <!-- Right Column -->
        <div>
            <div class="mb-4">
                <span class="dark:text-white-light font-semibold">Created Date:</span>
                <span class="dark:text-white-light">
                    @(Model.User.CreatedDate.HasValue ? Model.User.CreatedDate.Value.ToString("dd/MM/yyyy") : "N/A")
                </span>
            </div>
            <div class="mb-4">
                <span class="dark:text-white-light font-semibold">Status:</span>
                <span class="badge rounded-full hover:top-0"
                      class="@(Model.User.Status.HasValue && Model.User.Status.Value ? "bg-success/20 text-success" : "bg-danger/20 text-danger")">
                    @(Model.User.Status.HasValue ? (Model.User.Status.Value ? "Active" : "Inactive") : "Unknown")
                </span>
            </div>
        </div>
    </div>

    <div class="mt-6 grid grid-cols-1 px-4 sm:grid-cols-2">
        <div></div>
        <div class="space-y-2 text-gray-600 text-right">
            @{
                int sessionId = 0;
                if (Session["ID"] != null)
                {
                    if (Session["ID"] is int id)
                    {
                        sessionId = id;
                    }
                    else if (int.TryParse(Session["ID"].ToString(), out int result))
                    {
                        sessionId = result;
                    }
                }
                string encryptedId = TripleDESEncryptionHelper.Encrypt(sessionId.ToString());
            }
            <a href="@Url.Action("Profile", "Users", new { id = encryptedId })" class="btn flex text-left"
               style="text-align: center; background-color: #00ADEF; color: white; display: block; visibility: visible; position: relative; z-index: 10; border-radius: 0.375rem; font-size: 0.875rem; padding: 0.625rem 2rem; width: 180px;">
                Back to Profile
            </a>
        </div>
    </div>
</div>