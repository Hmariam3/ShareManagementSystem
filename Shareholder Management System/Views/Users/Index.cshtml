﻿@model IEnumerable<Shareholder_Management_System.Models.User>

@{
    ViewBag.Title = "Index";
}

@{
    string errorMessage = TempData["ErrorMessage"] as string;
    string successMessage = TempData["SuccessMessage"] as string;
    string Message = TempData["Message"] as string;
}

<link rel="stylesheet" type="text/css" media="screen" href="~/css/all.min.css" />
<!-- Include SweetAlert Library -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/sweetalert2.min.css">
<script src="~/js/sweetalert.js"></script>
<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>

@if (TempData["ResetMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to show message
            const showMessage = (msg = 'Example notification text.', position = 'top-right', showCloseButton = true, duration = 5000) => {
                const toast = Swal.mixin({
                    toast: true,
                    position: position,
                    showConfirmButton: false,
                    timer: duration,
                    showCloseButton: showCloseButton,
                });

                toast.fire({
                    title: msg,
                });
            };

            // Call the showMessage function with the TempData message
            showMessage('@TempData["ResetMessage"]', 'top-right', true, 5000);
        });
    </script>
}

<div class="bg-white shadow-md rounded-lg overflow-hidden panel">
    <div class="flex justify-between px-6 py-4 border-b border-gray-200 items-center">
        <h2 class="text-xl font-semibold dark:text-white-light">User Information</h2>
        <p>
            <button onclick="location.href='@Url.Action("Create")'"
                    class="flex items-center inline-block px-6 py-3 text-white font-semibold text-sm uppercase rounded-md shadow-lg focus:outline-none focus:ring-2 focus:ring-opacity-50 transition duration-150 ease-in-out"
                    style="background-color: #00ADEF; hover:bg: #008bb5; focus:ring-color: #00ADEF;">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Add New
            </button>
        </p>
    </div>
    <div class="p-6 overflow-x-auto">
        <table id="userTable" class="min-w-full leading-normal">
            <thead>
                <tr class="bg-gray-100 text-gray-600 text-left text-sm uppercase font-semibold tracking-wider">
                    <th class="px-5 py-3 border-b-2 border-gray-200"> @Html.DisplayNameFor(model => model.FullName) </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200"> @Html.DisplayNameFor(model => model.UserName) </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200"> @Html.DisplayNameFor(model => model.Role) </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200"> @Html.DisplayNameFor(model => model.CreatedDate) </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200"> @Html.DisplayNameFor(model => model.Branch1.BranchCode) </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200"> @Html.DisplayNameFor(model => model.Status) </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200"> Actions </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-5 py-4 border-b border-gray-200 text-sm"> @Html.DisplayFor(modelItem => item.FullName) </td>
                        <td class="px-5 py-4 border-b border-gray-200 text-sm"> @Html.DisplayFor(modelItem => item.UserName) </td>
                        <td class="px-5 py-4 border-b border-gray-200 text-sm"> @Html.DisplayFor(modelItem => item.Role) </td>
                        <td class="px-5 py-4 border-b border-gray-200 text-sm"> @Html.DisplayFor(modelItem => item.CreatedDate) </td>
                        <td class="px-5 py-4 border-b border-gray-200 text-sm"> @Html.DisplayFor(modelItem => item.Branch1.BranchName) </td>
                        <td class="px-5 py-4 border-b border-gray-200 text-sm">
                            @if (item.Status)
                            {
                                <span class="badge rounded-full bg-info/20 text-success hover:top-0">Active</span>
                            }
                            else
                            {
                                <span class="badge rounded-full bg-danger/20 text-danger hover:top-0">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="flex space-x-4">
                                @{
                                    string encryptedId = TripleDESEncryptionHelper.Encrypt(item.UID.ToString());
                                }
                                <a href="@Url.Action("Edit", new { id = encryptedId })" class="text-blue-500 hover:text-blue-700" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 11l3.536-3.536a1.5 1.5 0 112.121 2.122L11 13m1-1L9 15l-2 2m2-2l3 3 5-5-2.828-2.828a1.5 1.5 0 00-2.122 0L11 11z" />
                                    </svg>
                                </a>
                                <a href="@Url.Action("Details", new { id = encryptedId })" class="text-cyan-500 hover:text-cyan-700" title="Details">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M19 12c0-3.866-3.134-7-7-7S5 8.134 5 12s3.134 7 7 7 7-3.134 7-7z" />
                                    </svg>
                                </a>
                                <a href="javascript:void(0);" onclick="confirmResetPassword('@Url.Action("Reset", new { id = encryptedId })')" class="text-red-500 hover:text-red-700" title="Reset Password">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a4 4 0 00-4 4v5H5a2 2 0 00-2 2v5a2 2 0 002 2h14a2 2 0 002-2v-5a2 2 0 00-2-2h-3V7a4 4 0 00-8 0v5h8" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 15v2a2 2 0 004 0v-2" />
                                    </svg>
                                </a>
                                @if (item.Status == false)
                                {
                                    <a href="javascript:void(0);" onclick="confirmActive('@Url.Action("Activate", new { id = encryptedId })')" class="text-red-500 hover:text-red-700" title="Activate Account">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="green" class="w-6 h-6">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                            <circle cx="12" cy="12" r="9" stroke="green" stroke-width="2" fill="none" />
                                        </svg>
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:void(0);" onclick="confirmInactive('@Url.Action("Inactivate", new { id = encryptedId })')" class="text-red-500 hover:text-red-700" title="Inactivate Account">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="red" class="w-6 h-6">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                            <circle cx="12" cy="12" r="9" stroke="red" stroke-width="2" fill="none" />
                                        </svg>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#userTable').DataTable({
            pageLength: 5, // Number of rows to show per page
            lengthMenu: [5, 10, 15, 25] // Options for the number of rows per page
        });
    });
</script>

<script>
    function confirmResetPassword(url) {
        console.log("Generated URL: ", url); // Print the URL to the console
        if (confirm("Do you want to reset the password?")) {
            window.location.href = url; // Redirect to the reset action if user confirms
        }
    }
    function confirmActive(url) {
        console.log("Generated URL: ", url); // Print the URL to the console
        if (confirm("Do you want to Activate the Account?")) {
            window.location.href = url; // Redirect to the reset action if user confirms
        }
    }
    function confirmInactive(url) {
        console.log("Generated URL: ", url); // Print the URL to the console
        if (confirm("Do you want to Deactivate the Account?")) {
            window.location.href = url; // Redirect to the reset action if user confirms
        }
    }
</script>