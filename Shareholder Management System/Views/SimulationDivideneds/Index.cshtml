﻿@model IEnumerable<Shareholder_Management_System.Models.SimulationDividened>

@{
    ViewBag.Title = "Index";
}

<script src="~/Scripts/JS/simple-datatables.js"></script>
<script src="~/Scripts/JS/xlsx.full.min.js"></script>

<div class="animate__animated p-6" :class="[$store.app.animation]">
    @{
        var computedBY = Model.FirstOrDefault();
        if (computedBY != null)
        {
            <div class="panel h-full overflow-hidden border-0 p-0">
                <div class="min-h-[190px] bg-gradient-to-r from-[#4361ee] to-[#160f6b] p-6">
                    <div class="mb-6 flex items-center justify-between">
                        <div class="flex items-center rounded-full bg-black/50 p-1 font-semibold text-white ltr:pr-3 rtl:pl-3 p-2">
                            Fisical Year: @computedBY.Dividend.FiscalYear
                        </div>
                        <button type="button" class="flex items-center justify-between rounded-md   hover:opacity-80 ltr:ml-auto rtl:mr-auto">
                            <span class="badge badge-outline-warning rounded-full bg-[#1b2e4b] px-4 py-1.5 text-xs text-white before:inline-block before:h-1.5 before:w-1.5 before:rounded-full before:bg-white ltr:before:mr-2 rtl:before:ml-2">Pending</span>
                        </button>

                    </div>
                    <div class="flex items-center justify-between text-white">
                        <p class="text-xl font-bold">Profit To Be Distributed </p>
                        <h5 class="text-2xl ltr:ml-auto rtl:mr-auto  font-bold"><span class="text-white-light">ETB  </span>@computedBY.Dividend.Profit</h5>
                    </div>
                </div>
                <div class="-mt-12 grid grid-cols-2 gap-2 px-8">
                    <div class="rounded-md bg-white px-4 py-2.5 shadow dark:bg-[#060818]">
                        <span class="mb-4 flex items-center justify-between dark:text-white">
                            Total Weighted Average
                        </span>
                        <div class="btn w-full border-0 bg-[#ebedf2] py-1 text-base text-[#515365] shadow-none dark:bg-black dark:text-[#bfc9d4]">
                            @computedBY.Dividend.TotalWASA
                        </div>
                    </div>
                    <div class="rounded-md bg-white px-4 py-2.5 shadow dark:bg-[#060818]">
                        <span class="mb-4 flex items-center justify-between dark:text-white">
                            Profit Per Share
                        </span>
                        <div class="btn w-full border-0 bg-[#ebedf2] py-1 text-base text-[#515365] shadow-none dark:bg-black dark:text-[#bfc9d4] ">
                            @computedBY.Dividend.DivPerShare
                        </div>
                    </div>
                </div>
                <div class="p-5">
                    <div class="mb-5 space-y-1">
                        <div class="flex items-center justify-around">
                            <p class="font-semibold text-[#515365]">Computed BY:</p>
                            <p class="text-base"><span class="font-semibold">@computedBY.Dividend.User.FullName</span></p>
                        </div>
                        <div class="flex items-center justify-around">
                            <p class="font-semibold text-[#515365]">Computed Date:</p>
                            <p class="text-base"><span class="font-semibold">@computedBY.Dividend.CreationDate.ToString()</span></p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    <!-- start main content section -->
    <div x-data="dividendSimulation">
        <div class="space-y-6 !mt-6">
            <div class="panel sticky-column ">
                <div class="relative">
                    <div class="flex flex-wrap items-center sm:absolute">
                        <a :href="'@Url.Action("ExportToExcel", "SimulationDivideneds")'" class="btn btn-primary btn-sm m-1">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                                <path d="M15.3929 4.05365L14.8912 4.61112L15.3929 4.05365ZM19.3517 7.61654L18.85 8.17402L19.3517 7.61654ZM21.654 10.1541L20.9689 10.4592V10.4592L21.654 10.1541ZM3.17157 20.8284L3.7019 20.2981H3.7019L3.17157 20.8284ZM20.8284 20.8284L20.2981 20.2981L20.2981 20.2981L20.8284 20.8284ZM14 21.25H10V22.75H14V21.25ZM2.75 14V10H1.25V14H2.75ZM21.25 13.5629V14H22.75V13.5629H21.25ZM14.8912 4.61112L18.85 8.17402L19.8534 7.05907L15.8947 3.49618L14.8912 4.61112ZM22.75 13.5629C22.75 11.8745 22.7651 10.8055 22.3391 9.84897L20.9689 10.4592C21.2349 11.0565 21.25 11.742 21.25 13.5629H22.75ZM18.85 8.17402C20.2034 9.3921 20.7029 9.86199 20.9689 10.4592L22.3391 9.84897C21.9131 8.89241 21.1084 8.18853 19.8534 7.05907L18.85 8.17402ZM10.0298 2.75C11.6116 2.75 12.2085 2.76158 12.7405 2.96573L13.2779 1.5653C12.4261 1.23842 11.498 1.25 10.0298 1.25V2.75ZM15.8947 3.49618C14.8087 2.51878 14.1297 1.89214 13.2779 1.5653L12.7405 2.96573C13.2727 3.16993 13.7215 3.55836 14.8912 4.61112L15.8947 3.49618ZM10 21.25C8.09318 21.25 6.73851 21.2484 5.71085 21.1102C4.70476 20.975 4.12511 20.7213 3.7019 20.2981L2.64124 21.3588C3.38961 22.1071 4.33855 22.4392 5.51098 22.5969C6.66182 22.7516 8.13558 22.75 10 22.75V21.25ZM1.25 14C1.25 15.8644 1.24841 17.3382 1.40313 18.489C1.56076 19.6614 1.89288 20.6104 2.64124 21.3588L3.7019 20.2981C3.27869 19.8749 3.02502 19.2952 2.88976 18.2892C2.75159 17.2615 2.75 15.9068 2.75 14H1.25ZM14 22.75C15.8644 22.75 17.3382 22.7516 18.489 22.5969C19.6614 22.4392 20.6104 22.1071 21.3588 21.3588L20.2981 20.2981C19.8749 20.7213 19.2952 20.975 18.2892 21.1102C17.2615 21.2484 15.9068 21.25 14 21.25V22.75ZM21.25 14C21.25 15.9068 21.2484 17.2615 21.1102 18.2892C20.975 19.2952 20.7213 19.8749 20.2981 20.2981L21.3588 21.3588C22.1071 20.6104 22.4392 19.6614 22.5969 18.489C22.7516 17.3382 22.75 15.8644 22.75 14H21.25ZM2.75 10C2.75 8.09318 2.75159 6.73851 2.88976 5.71085C3.02502 4.70476 3.27869 4.12511 3.7019 3.7019L2.64124 2.64124C1.89288 3.38961 1.56076 4.33855 1.40313 5.51098C1.24841 6.66182 1.25 8.13558 1.25 10H2.75ZM10.0298 1.25C8.15538 1.25 6.67442 1.24842 5.51887 1.40307C4.34232 1.56054 3.39019 1.8923 2.64124 2.64124L3.7019 3.7019C4.12453 3.27928 4.70596 3.02525 5.71785 2.88982C6.75075 2.75158 8.11311 2.75 10.0298 2.75V1.25Z" fill="currentColor"></path>
                                <path opacity="0.5" d="M13 2.5V5C13 7.35702 13 8.53553 13.7322 9.26777C14.4645 10 15.643 10 18 10H22" stroke="currentColor" stroke-width="1.5"></path>
                            </svg>
                            Excell
                        </a>

                        <button type="button" class="btn btn-primary btn-sm m-1" @@click="printTable">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                                <path d="M6 17.9827C4.44655 17.9359 3.51998 17.7626 2.87868 17.1213C2 16.2426 2 14.8284 2 12C2 9.17157 2 7.75736 2.87868 6.87868C3.75736 6 5.17157 6 8 6H16C18.8284 6 20.2426 6 21.1213 6.87868C22 7.75736 22 9.17157 22 12C22 14.8284 22 16.2426 21.1213 17.1213C20.48 17.7626 19.5535 17.9359 18 17.9827" stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5" d="M9 10H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                <path d="M19 14L5 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                <path d="M18 14V16C18 18.8284 18 20.2426 17.1213 21.1213C16.2426 22 14.8284 22 12 22C9.17157 22 7.75736 22 6.87868 21.1213C6 20.2426 6 18.8284 6 16V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                <path opacity="0.5" d="M17.9827 6C17.9359 4.44655 17.7626 3.51998 17.1213 2.87868C16.2427 2 14.8284 2 12 2C9.17158 2 7.75737 2 6.87869 2.87868C6.23739 3.51998 6.06414 4.44655 6.01733 6" stroke="currentColor" stroke-width="1.5"></path>
                                <circle opacity="0.5" cx="17" cy="10" r="1" fill="currentColor"></circle>
                                <path opacity="0.5" d="M15 16.5H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                <path opacity="0.5" d="M13 19H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                            </svg>
                            PRINT
                        </button>

                    </div>

                    <div class="mb-5 sm:absolute sm:top-0 sm:mb-0 sm:ltr:right-56 sm:rtl:left-56">
                        <div class="flex items-center">
                            <a :href="'@Url.Action("ComputeDividend", "SimulationDivideneds")'" class="hover:text-dark btn btn-primary mr-2">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-white">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.59L6.42 13l1.41-1.41L10 13.17l6.59-6.59L18 8l-8 8z"
                                          fill="currentColor"></path>
                                </svg>
                                Approve
                            </a>
                            <a :href="'@Url.Action("Reject", "SimulationDivideneds")'" class="hover:text-dark btn btn-danger gap-2 mr-2">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-danger">
                                    <path d="M15 9L9 15M9 9l6 6" stroke="white" stroke-width="1.5" stroke-linecap="round" />
                                    <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.5" fill="none" />
                                </svg>
                                Reject
                            </a>




                            <div class="theme-dropdown relative" x-data="{ columnDropdown: false }"
                                 @@click.outside="columnDropdown = false">

                                <a href="javascript:;"
                                   class="flex items-center rounded-md border border-[#e0e6ed] px-4 py-2 text-sm font-semibold dark:border-[#253b5c] dark:bg-[#1b2e4b] dark:text-white-dark"
                                   @@click="columnDropdown = ! columnDropdown">
                                    <span class="ltr:mr-1 rtl:ml-1">Columns Visibility</span>
                                    <svg class="h-5 w-5" viewbox="0 0 24 24" fill="none"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <path d="M19 9L12 15L5 9" stroke="currentColor" stroke-width="1.5"
                                              stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </a>
                                <div class="absolute top-11 z-[10] hidden w-[100px] min-w-[150px] rounded bg-white py-2 text-dark shadow ltr:left-0 rtl:right-0 dark:bg-[#1b2e4b] dark:text-white-light"
                                     :class="columnDropdown && '!block'">
                                    <ul class="space-y-2 px-4 font-semibold">
                                        <template x-for="(col,i) in columns" :key="i">
                                            <li>
                                                <div>
                                                    <label class="cursor-pointer">
                                                        <input type="checkbox" class="form-checkbox"
                                                               :id="`chk-${i}`" :value="(i)"
                                                               @@change="col.hidden=  $event.target.checked,showHideColumns(i,$event.target.checked)"
                                                               :checked="col.hidden">
                                                        <span :for="`chk-${i}`" class="ltr:ml-2 rtl:mr-2"
                                                              x-text="col.name"></span>
                                                    </label>
                                                </div>
                                            </li>
                                        </template>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <table id="myTable1" class="whitespace-nowrap">
                        <thead>
                            <tr>

                            <tr>
                        </thead>
                        <tbody>
                            <!-- Data will be populated by Alpine.js and SimpleDatatables -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


    </div>
    <!-- end main content section -->

</div>

<script>
    // main section
    document.addEventListener('alpine:init', () => {
        Alpine.data('dividendSimulation', () => ({
            columns: [
                { name: 'Shareholder ID', hidden: true },
                { name: 'Shareholder Name', hidden: true },
                { name: 'Categories', hidden: true },
                { name: 'Payment Amount', hidden: true },
                { name: 'Payment Mode', hidden: true },
                { name: 'Payment Date', hidden: true },
                { name: 'Fiscal Year', hidden: false },
                { name: 'Outstanding Days', hidden: false },
                { name: 'WASA', hidden: false },
                { name: 'Rate', hidden: false },
                { name: 'Dividend Payable', hidden: false },
                { name: 'Transferror ', hidden: false },
                { name: 'Transferee', hidden: false },
                { name: 'Dividend Agreement', hidden: false },
                { name: 'Transfer Date', hidden: false },
            ],

            hideCols: [],
            showCols: [0, 1, 2, 3, 4, 5],

            showHideColumns(col, value) {
                if (value) {
                    this.showCols.push(col);
                    this.hideCols = this.hideCols.filter((d) => d != col);
                } else {
                    this.hideCols.push(col);
                    this.showCols = this.showCols.filter((d) => d != col);
                }
                let headers = this.datatable1.columns();
                headers.hide(this.hideCols);
                headers.show(this.showCols);
            },

            datatable1: null,


            init() {
                let headers = this.columns.map((col) => {
                    return col.name;
                });
                this.datatable1 = new simpleDatatables.DataTable('#myTable1', {
                    data: {
                        headings: headers,
                        data: [
                            @foreach (var item in Model)
                            {
                                    <text>
                                    [
                                        "@item.Shareholder.ShareID",
                                        "@item.Shareholder.FullNameEng",
                                        "@item.Shareholder.SHCategory",
                                        "@item.Payment1.PaidAmount",
                                        "@item.Payment1.PaymentMode",
                                        "@(item.Payment1.PaymentDate.HasValue ? item.Payment1.PaymentDate.Value.ToString("yyyy-MM-dd") : "")",
                                        "@item.Dividend.FiscalYear",
                                        "@item.OutstandingDays",
                                        "@item.WASA",
                                        "@item.Dividend.DivPerShare",
                                        `
                                            @{
                                                var wasa = item.WASA;
                                                var rate = item.Dividend.DivPerShare / 100;

                                                var dividend = wasa * rate;

                                                <span> @dividend</span>
                                            }
                                        `,
                                        "@(item.Payment1.TransferID != null ? item.Payment1.ShareTransfer.Shareholder.FullNameEng : "")",
                                        "@(item.Payment1.TransferID != null ? item.Payment1.ShareTransfer.Shareholder1.FullNameEng : "")",
                                        "@(item.Payment1.TransferID != null ? item.Payment1.ShareTransfer.DividenedFor : "")",
                                        "@(item.Payment1.TransferID != null ? item.Payment1.ShareTransfer.TransferDate.Value.ToString("yyyy-MM-dd") : "")",

                                    ],
                                </text>

                            }
                         ]
                    },
                    perPage: 15,
                    perPageSelect: [10, 20, 30, 50, 100],

                    firstLast: true,
                    firstText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M13 19L7 12L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> <path opacity="0.5" d="M16.9998 19L10.9998 12L16.9998 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    lastText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M11 19L17 12L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> <path opacity="0.5" d="M6.99976 19L12.9998 12L6.99976 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    prevText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M15 5L9 12L15 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    nextText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    labels: {
                        perPage: '{select}',
                    },
                    layout: {
                        top: '{search}',
                        bottom: '{info}{select}{pager}',
                    },
                });
                let cols = this.datatable1.columns();
                cols.hide(this.hideCols);
                cols.show(this.showCols);
            },

            dividendSimulation(eType) {
                var data = {
                    type: eType,
                    filename: 'Dividend Preview',
                    download: true,
                };

                if (data.type === 'csv') {
                    data.lineDelimiter = '\n';
                    data.columnDelimiter = ';';
                }
                this.datatable1.export(data);
            },

            printTable() {
                this.datatable1.print();
            },

        }));
    });

    // Success message function (Toast)
    async function showMessage(msg = '', type = 'success') {
        const toast = window.Swal.mixin({
            toast: true,
            position: 'top',
            showConfirmButton: false,
            timer: 3000,
        });
        toast.fire({
            icon: type,
            title: msg,
            padding: '10px 20px',
        });
    }

</script>