@model Shareholder_Management_System.Models.Payment

@{
    ViewBag.Title = "Edit";
}

<link rel="stylesheet" type="text/css" href="~/Content/CSS/nice-select2.css">
<script src="~/Scripts/JS/nice-select2.js"></script>

@{
    string errorMessage = TempData["ErrorMessage"] as string;
    string successMessage = TempData["Message"] as string;
}

@using (Html.BeginForm("Edit", "Payments", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div x-data="form" class="grid grid-cols-2 gap-6 pt-5 lg:grid-cols-2">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.PayID)
        <div class="col-span-1">
            <div class="panel">
                <div class="mb-5 flex items-center justify-between" style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                    <h5 class="text-lg font-semibold" style="padding:7px;">Share Holder Detail</h5>
                </div>
                <div class="mb-5">
                    <div class="flex items-center">
                        <span class="text-red-500">*</span>
                        <label for="ShID" class="block dark:text-white-light text-sm font-semibold mb-2">Share Holder</label>
                    </div>
                    @Html.DropDownList(
                        "ShID",
                        new SelectList(ViewBag.Shareholders1, "Value", "Text", Model.ShID),
                        htmlAttributes: new { id = "seachable-select", disabled = "disabled" }
                    )
                    @Html.HiddenFor(model => model.ShID)
                    <span class="text-danger" id="shareholderError"></span>
                </div>
                <div class="table-responsive mt-4 mb-5" style="max-height: 300px; overflow-y: auto;">
                    <table class="table-auto w-full border-collapse border border-gray-300 mt-8" id="subscriptionTable">
                        <thead class="bg-gray-100">
                            <tr class="text-left">
                                <th class="px-4 py-2">Select</th>
                                <th class="px-4 py-2">Sub ID</th>
                                <th class="px-4 py-2">Sh ID</th>
                                <th class="px-4 py-2">No of Shares</th>
                                <th class="px-4 py-2">Subscription Amount</th>
                                <th class="px-4 py-2">Paid Subscription</th>
                                <th class="px-4 py-2">Unpaid Subscription</th>
                                <th class="px-4 py-2">Authorization Status</th>
                                <th class="px-4 py-2">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Subscriptions != null)
                            {
                                foreach (var subscription in ViewBag.Subscriptions)
                                {
                                    <tr>
                                        <td class="px-4 py-2">
                                            <input type="radio" name="selectedSubscription" class="form-radio subscription-radio" value="@subscription.SubID"
                                                   data-unpaid="@subscription.UnpaidSubscription"
                                                   @(subscription.SubID == Model.SubID ? "checked" : "") disabled="disabled" />
                                        </td>
                                        <td class="px-4 py-2">@subscription.SubID</td>
                                        <td class="px-4 py-2">@subscription.ShID</td>
                                        <td class="px-4 py-2">@subscription.SubNumShares</td>
                                        <td class="px-4 py-2">@subscription.SubAmount</td>
                                        <td class="px-4 py-2">@subscription.PaidSubscription</td>
                                        <td class="px-4 py-2">@subscription.UnpaidSubscription</td>
                                        <td class="px-4 py-2">@subscription.SubAuthorizationStatus</td>
                                        <td class="px-4 py-2">@subscription.SubStatus</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="px-4 py-2 text-center text-gray-500">No subscriptions found for this shareholder.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-danger mt-2" id="subscriptionError"></div>
                </div>
                @Html.HiddenFor(model => model.SubID, new { @id = "selectedSubID" })
                @{
                    var subscriptions = ViewBag.Subscriptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
                    var selectedSubscription = subscriptions.FirstOrDefault(s => (int)s.SubID == Model.SubID);
                    var unpaidSubscriptionValue = selectedSubscription != null ? (decimal)selectedSubscription.UnpaidSubscription : 0;
                }
                @Html.Hidden("UnpaidSubscription", null, new { id = "UnpaidSubscription", value = unpaidSubscriptionValue })
            </div>
        </div>

        <div class="col-span-1">
            <div class="panel">
                <div class="mb-5 flex items-center justify-between" style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color: white;">
                    <h5 class="text-lg font-semibold" style="padding: 7px;">Payment Details</h5>
                </div>
                <div class="flex items-center">
                    <span class="text-red-500">*</span>
                    @Html.Label("Payment Mode", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                </div>
                <div x-data="form" class="grid grid-cols-1 gap-6 pt-0 lg:grid-cols-2">
                    <div class="col-span-1">
                        <div class="space-y-4">
                            <div class="flex items-center space-x-2">
                                @Html.Label("Cash", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                <div class="amount-input-container flex flex-col ml-4">
                                    <input type="number" name="cashAmount" class="form-input payment-field" min="0" step="0.01"
                                           value="@(ViewBag.CashAmount != null ? ViewBag.CashAmount.ToString() : string.Empty)" />
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                @Html.Label("Account", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                <div class="amount-input-container flex flex-col ml-4">
                                    <input type="number" name="accountAmount" class="form-input payment-field" min="0" step="0.01"
                                           value="@(ViewBag.AccountAmount != null ? ViewBag.AccountAmount.ToString() : string.Empty)" />
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                @Html.Label("CPO", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                <div class="amount-input-container flex flex-col ml-4">
                                    <input type="number" name="cpoAmount" class="form-input payment-field" min="0" step="0.01"
                                           value="@(ViewBag.CpoAmount != null ? ViewBag.CpoAmount.ToString() : string.Empty)" />
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                @Html.Label("Bonus", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                <div class="amount-input-container flex flex-col ml-4">
                                    <input type="number" name="Bonusamount" class="form-input payment-field" min="0" step="0.01"
                                           value="@(ViewBag.Bonusamount != null ? ViewBag.Bonusamount.ToString() : string.Empty)" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-span-1">
                        <div class="space-y-4">
                            <div class="flex items-center space-x-2">
                                @Html.Label("Dividend", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                <div class="amount-input-container flex flex-col ml-4">
                                    <input type="number" name="dividendAmount" class="form-input payment-field" min="0" step="0.01"
                                           value="@(ViewBag.DividendAmount != null ? ViewBag.DividendAmount.ToString() : string.Empty)" />
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                @Html.Label("Cheque", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                <div class="amount-input-container flex flex-col ml-4">
                                    <input type="number" name="chequeAmount" class="form-input payment-field" min="0" step="0.01"
                                           value="@(ViewBag.ChequeAmount != null ? ViewBag.ChequeAmount.ToString() : string.Empty)" />
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                @Html.Label("RTGS", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                <div class="amount-input-container flex flex-col ml-4">
                                    <input type="number" name="RTGSamount" class="form-input payment-field" min="0" step="0.01"
                                           value="@(ViewBag.RTGSamount != null ? ViewBag.RTGSamount.ToString() : string.Empty)" />
                                </div>
                            </div>
                            <span class="text-danger" id="paymentFieldsError"></span>
                            <div class="flex items-center justify-between">
                                <div class="block dark:text-white-light text-sm font-semibold mb-2">Paid Amount</div>
                                <div id="PaidAmount" class="text-blue-700">
                                    ETB @(Model.PaidAmount.HasValue ? Model.PaidAmount.Value.ToString("0.00") : "0.00")
                                </div>
                                <span class="text-danger" id="PaidAmountValidationMessage">
                                    @Html.ValidationMessageFor(model => model.PaidAmount)
                                </span>
                                @Html.HiddenFor(model => model.PaidAmount, new { id = "PaidAmountHidden" })
                            </div>
                            @if (TempData["Message"] != null)
                            {
                                <div class="alert alert-success">@TempData["Message"]</div>
                            }
                        </div>
                    </div>
                </div>
                <hr class="my-6 border-[#e0e6ed] dark:border-[#1b2e4b]">
                <div x-data="form" class="grid grid-cols-1 gap-6 pt-0 lg:grid-cols-2">
                    <div class="col-span-1">
                        <div class="space-y-4">
                            <div class="mb-5">
                                <div class="flex items-center">
                                    <span class="text-red-500">*</span>
                                    @Html.Label("Reference Number", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                                </div>
                                <div class="amount-input-container flex flex-col ml-4">
                                    @Html.EditorFor(model => model.ReferenceNum, new { htmlAttributes = new { @class = "form-input" } })
                                    @Html.ValidationMessageFor(model => model.ReferenceNum, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-span-1">
                        <div class="space-y-4">
                            <div class="mb-5">
                                <div class="flex items-center">
                                    <span class="text-red-500">*</span>
                                    @Html.Label("Date of Payment", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                                </div>
                                <div class="col-md-10">
                                    @Html.TextBoxFor(model => model.PaymentDate, "{0:yyyy-MM-dd}", new { @class = "form-input border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500", type = "date", @id = "payment-date-picker", max = DateTime.Now.ToString("yyyy-MM-dd") })
                                    <span class="text-danger" id="paymentDateError"></span>
                                </div>
                            </div>
                            <div class="mb-5">
                                @Html.Label("Upload Document", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                                <div class="custom-file-container" data-upload-id="myFirstImage">
                                    <div class="custom-file-container__image-preview">
                                        <input type="file" class="form-input file:py-2 file:px-4 file:border-0 file:font-semibold p-0 file:bg-primary/90 ltr:file:mr-5 rtl:file:ml-5 file:text-white file:hover:bg-primary" accept="*" name="uploadedFile" aria-label="Upload Document">
                                        <span class="text-danger" id="uploadedFileError"></span>
                                    </div>
                                </div>
                                @if (ViewBag.ExistingDocumentName != null)
                                {
                                    <div class="mt-2">
                                        <span>Current File: </span>
                                        <a href="@Url.Action("Download", "Documents", new { id = ViewBag.DocumentId })" target="_blank">
                                            @ViewBag.ExistingDocumentName
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-5">
                    <div class="flex items-center">
                        @Html.Label("Remark", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                    </div>
                    <div class="amount-input-container flex flex-col ml-4">
                        @Html.TextAreaFor(model => model.Remark, 1, 40, new { @class = "form-input" })
                        @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="mt-6 flex justify-end">
                <button type="submit" class="btn btn-primary mr-2" id="submitButton" style="width: 200px; height: 50px">Update Payment</button>
            </div>
        </div>
    </div>
}

<style>
    .shareholder-item:hover {
        background-color: #3b82f6;
        color: white;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function (e) {
        var options = { searchable: true };
        NiceSelect.bind(document.getElementById("seachable-select"), options);
    });
</script>

<script>
    var upload = new FileUploadWithPreview('myFirstImage', {
        images: {
            baseImage: '~/assets/images/file-preview.png',
            backgroundImage: '',
        },
    });
</script>

<script>
    $(document).ready(function () {
        $('.payment-field').on('input', function () {
            var total = 0;
            $('.payment-field').each(function () {
                total += parseFloat($(this).val()) || 0;
            });
            $('#PaidAmount').text('ETB ' + total.toFixed(2));
            $('#PaidAmountHidden').val(total.toFixed(2));
            var unpaidSubscription = parseFloat($('#UnpaidSubscription').val()) || 0;
            if (total > unpaidSubscription) {
                $('#PaidAmountValidationMessage').text('Paid Amount cannot exceed Unpaid Subscription.');
            } else {
                $('#PaidAmountValidationMessage').text('');
            }
        });

        // Initial calculation on page load
        $('.payment-field').trigger('input');
    });
</script>

<script>
    $(document).ready(function () {
        const $form = $('form');
        const $submitButton = $('#submitButton');

        function validateForm(showErrors = false) {
            let isValid = true;

            function clearError(selector) {
                $(selector).text('');
            }

            function setError(selector, message) {
                $(selector).text(message);
            }

            // Validate Shareholder (already disabled, just check for value)
            if (!$('#ShID').val()) {
                isValid = false;
                if (showErrors) setError('#shareholderError', 'Shareholder is required.');
            } else {
                clearError('#shareholderError');
            }

            // Validate Subscription (already disabled, just check for selection)
            if ($('#subscriptionTable tbody input[type="radio"]:checked').length === 0) {
                isValid = false;
                if (showErrors) setError('#subscriptionError', 'Please select a subscription.');
            } else {
                clearError('#subscriptionError');
            }

            // Validate Payment Modes
            const paymentFields = ['cashAmount', 'accountAmount', 'cpoAmount', 'Bonusamount', 'dividendAmount', 'chequeAmount', 'RTGSamount'];
            let isPaymentFieldFilled = paymentFields.some(field => parseFloat($(`input[name="${field}"]`).val()) > 0);
            let totalPaid = 0;
            paymentFields.forEach(field => totalPaid += parseFloat($(`input[name="${field}"]`).val()) || 0);
            const unpaidSubscription = parseFloat($('#UnpaidSubscription').val()) || 0;

            if (!isPaymentFieldFilled) {
                isValid = false;
                if (showErrors) setError('#paymentFieldsError', 'At least one payment mode is required.');
            } else if (totalPaid > unpaidSubscription) {
                isValid = false;
                if (showErrors) setError('#paymentFieldsError', 'Total payment cannot exceed unpaid subscription.');
            } else {
                clearError('#paymentFieldsError');
            }

            // Validate Reference Number
            if ($('#ReferenceNum').val().trim() === "") {
                isValid = false;
                if (showErrors) setError('#ReferenceNum + .text-danger', 'Reference number is required.');
            } else {
                clearError('#ReferenceNum + .text-danger');
            }

            // Validate Payment Date
            const paymentDateValue = $('#payment-date-picker').val();
            const paymentDate = new Date(paymentDateValue);
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (!paymentDateValue) {
                isValid = false;
                if (showErrors) setError('#paymentDateError', 'Payment date is required.');
            } else if (paymentDate > today) {
                isValid = false;
                if (showErrors) setError('#paymentDateError', 'Payment date cannot be in the future.');
            } else {
                clearError('#paymentDateError');
            }

            // Validate Uploaded File (optional, only if a new file is uploaded)
            const uploadedFile = $("input[name='uploadedFile']")[0].files[0];
            if (uploadedFile) {
                const maxFileSize = 2 * 1024 * 1024; // 1 MB
                const allowedTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/jpg', 'image/apng', 'image/jfif', 'image/pjpeg'];

                if (uploadedFile.size > maxFileSize) {
                    isValid = false;
                    if (showErrors) setError('#uploadedFileError', 'File size must not exceed 2 MB.');
                } else if (!allowedTypes.includes(uploadedFile.type)) {
                    isValid = false;
                    if (showErrors) setError('#uploadedFileError', 'Only PDF or image (JPG, JPEG, PNG, etc.) files are allowed.');
                } else {
                    clearError('#uploadedFileError');
                }
            } else {
                clearError('#uploadedFileError');
            }

            // Keep submit button enabled, rely on error messages
            return isValid;
        }

        // Real-time validation
        $('#ReferenceNum, #payment-date-picker, input[name="uploadedFile"]').on('input change', function () {
            validateForm(false);
        });

        $('.payment-field').on('input', function () {
            validateForm(false);
        });

        // Form submission
        $form.on('submit', function (event) {
            event.preventDefault();
            if (validateForm(true)) {
                $submitButton.text('Updating...'); // Optional: Change text during submission
                $form.off('submit').submit(); // Proceed with submission
            } else {
                // Optionally, you could alert the user here if you want more visibility
                // alert('Please correct the errors before submitting.');
            }
        });

        // Initial validation
        validateForm(false);
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}