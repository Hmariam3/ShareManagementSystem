                                                new SelectListItem { Text = "Bank Account", Value = "Bank Account" },
                                                new SelectListItem { Text = "Dividend", Value = "Dividend" },
                                                new SelectListItem { Text = "Bonus", Value = "Bonus" }
                                            }, "Value", "Text"),
                                            "Select Source of funds",
                                            new { @class = "form-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50 hover-style", @id = "sourceOfFunds" })  Added ID for JavaScript
                                        @Html.ValidationMessageFor(model => model.SourceOfFunds, "", new { @class = "text-danger" })

                                    </div>*@
                                <div class="mb-5">
                                    <div class="flex items-center">

                                        @Html.Label("Reference Number", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })

                                    </div>
                                    <div class="amount-input-container flex flex-col ml-4">
                                        @Html.EditorFor(model => model.ReferenceNum, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter reference number" } })
                                        @Html.ValidationMessageFor(model => model.ReferenceNum, "", new { @class = "text-danger" })
                                    </div>
                                </div>

