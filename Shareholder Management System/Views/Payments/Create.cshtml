                        @Html.Label("Payment Mode", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                    </div>
                    <div x-data="form" class="grid grid-cols-1 gap-6 pt-0 lg:grid-cols-2">
                        <div class="col-span-1">
                            <div class="space-y-4">
                                <div class="flex items-center space-x-2">
                                    @Html.Label("Cash", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                    <div class="amount-input-container flex flex-col ml-4">
                                        <input type="number" name="cashAmount" class="form-input payment-field" min="0" step="0.01" placeholder="Enter cash amount" />
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    @Html.Label("Account", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                    <div class="amount-input-container flex flex-col ml-4">
                                        <input type="number" name="AccountAmount" class="form-input payment-field" min="0" step="0.01" placeholder="Enter account amount" />
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    @Html.Label("CPO", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                    <div class="amount-input-container flex flex-col ml-4">
                                        <input type="number" name="cpoAmount" class="form-input payment-field" min="0" step="0.01" placeholder="Enter CPO amount" />
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    @Html.Label("Bonus", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                    <div class="amount-input-container flex flex-col ml-4">
                                        <input type="number" name="Bonusamount" class="form-input payment-field" min="0" step="0.01" placeholder="Enter CPO amount" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-span-1">
                            <div class="space-y-4">
                                <div class="flex items-center space-x-2">
                                    @Html.Label("Dividend", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                    <div class="amount-input-container flex flex-col ml-4">
                                        <input type="number" name="dividendAmount" class="form-input payment-field" min="0" step="0.01" placeholder="Enter dividend amount" />
                                    </div>
                                </div>

                                <div class="flex items-center space-x-2">
                                    @Html.Label("Cheque", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                    <div class="amount-input-container flex flex-col ml-4">
                                        <input type="number" name="chequeAmount" class="form-input payment-field" min="0" step="0.01" placeholder="Enter cheque amount" />
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    @Html.Label("RTGS", htmlAttributes: new { @class = "mb-0 w-1/3 ltr:mr-2 rtl:ml-2" })
                                    <div class="amount-input-container flex flex-col ml-4">
                                        <input type="number" name="RTGSamount" class="form-input payment-field" min="0" step="0.01" placeholder="Enter CPO amount" />
                                    </div>
