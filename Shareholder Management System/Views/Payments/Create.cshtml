<script>
    $(document).ready(function () {
        $('.payment-field').on('input', function () {
            var total = 0;
            $('.payment-field').each(function () {
                total += parseFloat($(this).val()) || 0;
            });
            $('#PaidAmount').text(total.toFixed(2) + 'ETB');
            $('#PaidAmountHidden').val(total.toFixed(2)); // Set hidden field value
            // Validate against UnpaidSubscription
            var unpaidSubscription = parseFloat($('#UnpaidSubscription').val()) || 0;
            if (total > unpaidSubscription) {
                $('#PaidAmount').next('.text-danger').text('Paid Amount cannot exceed Unpaid Subscription.');
            } else {
                $('#PaidAmount').next('.text-danger').text('');
            }
        });
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



<script>
    $(document).ready(function () {
        // Initialize Select2 with custom search handling
        $('#searchable-select').select2({
            placeholder: "Select a Shareholder",
            allowClear: true,
            width: '100%',
            matcher: function (params, data) {
                if ($.trim(params.term) === '') {
                    return data;
                }

                // Match against each part of the search term
                const terms = params.term.toLowerCase().split(' ');
                const text = data.text.toLowerCase();

                return terms.every(term => text.includes(term)) ? data : null;
            }
        });

        // Trigger when a shareholder is selected
        $('#searchable-select').on('change', function () {
            var shareholderId = $(this).val();
            if (shareholderId) {
                fetchSubscriptions(shareholderId);
            } else {
                $('#subscriptionTable tbody').empty().append(
                    '<tr><td colspan="9" class="px-4 py-2 text-center text-gray-500">Select a shareholder to view subscriptions.</td></tr>'
                );
            }
        });

        // Validate PaidAmount against UnpaidSubscription
        $('#PaidAmount').on('input', function () {
            var paidAmount = parseFloat($(this).val()); // Get the PaidAmount
            var unpaidSubscription = parseFloat($('#UnpaidSubscription').val()); // Get the UnpaidSubscription

            // Check if PaidAmount is greater than UnpaidSubscription
            if (paidAmount > unpaidSubscription) {
                $('#PaidAmount').next('.text-danger').text('Paid Amount cannot be greater than Unpaid Subscription.');
            } else {
                $('#PaidAmount').next('.text-danger').text(''); // Clear the error message
            }
        });
    });

    // Function to fetch subscriptions for the selected shareholder
    function fetchSubscriptions(shareholderId) {
        $.ajax({
            url: '@Url.Action("GetSubscriptionsByShareholder", "Payments")',
            type: 'GET',
            data: { shId: shareholderId },
            success: function (subscriptions) {
                var tbody = $('#subscriptionTable tbody');
                tbody.empty(); // Clear the table before populating new data

                if (subscriptions.length > 0) {
                    $.each(subscriptions, function (index, subscription) {
                        tbody.append(
                            '<tr>' +
                            '<td class="px-4 py-2"><input type="radio" class="form-radio" name="selectedSubscription" value="' + subscription.SubID + '" data-unpaid="' + subscription.UnpaidSubscription + '"></td>' +
                            '<td class="px-4 py-2">' + subscription.SubID + '</td>' +
                            '<td class="px-4 py-2">' + subscription.ShID + '</td>' +
                            '<td class="px-4 py-2">' + subscription.SubNumShares + '</td>' +
                            '<td class="px-4 py-2">' + subscription.SubAmount + '</td>' +
                            '<td class="px-4 py-2">' + subscription.PaidSubscription + '</td>' +
                            '<td class="px-4 py-2">' + subscription.UnpaidSubscription + '</td>' +
                            '<td class="px-4 py-2">' + subscription.SubAuthorizationStatus + '</td>' +
                            '<td class="px-4 py-2">' + subscription.SubStatus + '</td>' +
                            '</tr>'
                        );
                    });

                    // Handle radio button selection
                    $('input[name="selectedSubscription"]').on('change', function () {
                        var selectedSubID = $(this).val();
                        var unpaidSubscription = $(this).data('unpaid');
                        $('#selectedSubID').val(selectedSubID); // Set hidden input value
                        $('#UnpaidSubscription').val(unpaidSubscription); // Set hidden input value for UnpaidSubscription
                    });
                } else {
                    tbody.append(
                        '<tr><td colspan="9" class="px-4 py-2 text-center text-gray-500">No subscriptions found for this shareholder.</td></tr>'
                    );
                }
            },
            error: function () {
                alert('Error retrieving subscriptions.');
            }
        });
    }
</script>

<script>
    $(document).ready(function () {
        $('form').on('submit', function (event) {
            let isValid = true;

            // Validate Shareholder dropdown
            if ($('#searchable-select').val() === "") {
                isValid = false;
                $('#searchable-select').siblings('.text-danger').text('Please select a shareholder.');
            } else {
                $('#searchable-select').siblings('.text-danger').text('');
            }

            // Validate Source of Funds dropdown
            if ($('#sourceOfFunds').val() === "") {
                isValid = false;
                $('#sourceOfFunds').siblings('.text-danger').text('Please select a source of funds.');
            } else {
                $('#sourceOfFunds').siblings('.text-danger').text('');
            }

            // Validate Reference Number
            if ($('#ReferenceNum').val().trim() === "") {
                isValid = false;
                $('#ReferenceNum').siblings('.text-danger').text('Please provide a reference number.');
            } else {
                $('#ReferenceNum').siblings('.text-danger').text('');
            }

            // Validate Date of Payment
            const paymentDateValue = $('#payment-date-picker').val();
            const paymentDate = new Date(paymentDateValue);

            if (paymentDateValue === "") {
                isValid = false;
                $('#payment-date-picker').siblings('.text-danger').text('Please select a payment date.');
            } else if (paymentDate > new Date()) {
                isValid = false;
                $('#payment-date-picker').siblings('.text-danger').text('Payment date cannot be in the future.');
            } else {
                $('#payment-date-picker').siblings('.text-danger').text('');
            }

            //// Validate the uploaded file
            //const uploadedFile = $("input[name='uploadedFile']")[0].files[0];
            //const uploadedFileErrorElement = $('#uploadedFileError');

            //if (!uploadedFile) {
            //    isValid = false;
            //    uploadedFileErrorElement.text('Please upload a document.');
            //} else {
            //    uploadedFileErrorElement.text('');
            //}

            // Validate Payment Mode fields
            const paymentFields = ['cashAmount', 'AccountAmount', 'cpoAmount', 'dividendAmount', 'chequeAmount', 'RTGSamount', 'Bonusamount'];
            let isPaymentFieldFilled = false; // Flag to check if any payment field is filled

            paymentFields.forEach(function (field) {
                const value = parseFloat($(`input[name="${field}"]`).val()) || 0;
                // Check if any field has a value greater than 0 (i.e., is filled)
                if (value > 0) {
                    isPaymentFieldFilled = true;
                }
            });

            // If no payment field is filled, show error
            if (!isPaymentFieldFilled) {
                isValid = false;
                $('#paymentFieldsError').text('At least one payment mode is required.');
            } else {
                $('#paymentFieldsError').text('');
            }

            // Prevent form submission if validation fails
            if (!isValid) {
                event.preventDefault();
            }
        });
    });
</script>
<script>
    document.querySelector('#paymentForm').addEventListener('submit', function (e) {
        const submitButton = document.querySelector('#paymentForm button[type="submit"]');
        submitButton.disabled = true; // Disable the button
        submitButton.textContent = 'Submitting...'; // Change button text

        // Use setTimeout to allow the form to submit and handle validation
        setTimeout(function () {
            // Check if the form is still visible (i.e., submission failed)
            if (document.querySelector('#paymentForm').checkValidity() === false) {
                submitButton.disabled = false; // Re-enable the button
                submitButton.textContent = 'Submit Payment'; // Revert button text
            }
        }, 0);
    });
</script>