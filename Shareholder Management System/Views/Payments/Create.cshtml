<script>
    $(document).ready(function () {
        function validatePayment() {
            var total = 0;
            $('.payment-field').each(function () {
                total += parseFloat($(this).val()) || 0;
            });

            // Format with commas and two decimal places for display
            $('#PaidAmount').text(total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ETB');
            // Keep unformatted value for hidden input
            $('#PaidAmountHidden').val(total.toFixed(2));

            var unpaidSubscription = parseFloat($('#UnpaidSubscription').val()) || 0;
            var errorMessage = '';

            if (total > unpaidSubscription) {
                errorMessage = 'Paid Amount cannot exceed Unpaid Subscription.';
                $('#submitButton').prop('disabled', true); // Disable submit button
            } else {
                $('#submitButton').prop('disabled', false); // Enable submit button
            }

            $('#PaidAmount').next('.text-danger').text(errorMessage);
        }

        // Run validation when input changes
        $('.payment-field').on('input', function () {
            validatePayment();
        });

        // Ensure form submission works correctly
        $('form').on('submit', function (e) {
            var totalPaid = parseFloat($('#PaidAmountHidden').val()) || 0;
            var unpaidSubscription = parseFloat($('#UnpaidSubscription').val()) || 0;

            if (totalPaid > unpaidSubscription) {

                alert('Paid Amount cannot exceed Unpaid Subscription.');
                e.preventDefault(); // Prevent form submission
                validatePayment();
            } else {
                $('#submitButton').prop('disabled', false); // Ensure the button is enabled before submission
                return true; // Allow the form to submit
            }
        });

        // Run validation on page load in case of pre-filled values
        validatePayment();
    });
</script>




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



<script>
$(document).ready(function () {
    // Initialize Select2 for shareholder dropdown
    $('#shareholderDropdown').select2({
        placeholder: "Select a Shareholder",
        allowClear: true,
        width: '100%',
        minimumInputLength: 3,
        ajax: {
            url: '@Url.Action("SearchShareholders", "Payments")',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    term: params.term || '',
                    page: params.page || 1
                };
            },
            processResults: function (data, params) {
                params.page = params.page || 1;
                return {
                    results: data.items.map(function (item) {
                        return {
                            id: item.id,
                            text: item.text
                        };
                    }),
                    pagination: {
                        more: data.hasMore
                    }
                };
            },
            cache: true
        }
    });

    // Pre-select shareholder if provided
    @if (ViewBag.SelectedShId != null)
    {
        <text>
        $('#shareholderDropdown').val('@ViewBag.SelectedShId').trigger('change');
        </text>
    }

    // Fetch subscriptions when shareholder changes
    $('#shareholderDropdown').on('change', function () {
        var shareholderId = $(this).val();
        if (shareholderId) {
            fetchSubscriptions(shareholderId);
        } else {
            $('#subscriptionTable tbody').empty().append(
                '<tr><td colspan="9" class="px-4 py-2 text-center text-gray-500">Select a shareholder to view subscriptions.</td></tr>'
            );
            $('#selectedSubID').val('');
            $('#UnpaidSubscription').val('');
            $('#submitButton').prop('disabled', true);
        }
    });

    // Function to fetch subscriptions
    function fetchSubscriptions(shareholderId) {
        $.ajax({
            url: '@Url.Action("GetSubscriptionsByShareholder", "Payments")',
            type: 'GET',
            data: { shId: shareholderId },
            success: function (subscriptions) {
                var tbody = $('#subscriptionTable tbody');
                tbody.empty();

                if (subscriptions.length > 0) {
                    $.each(subscriptions, function (index, subscription) {
                        tbody.append(
                            '<tr>' +
                            '<td class="px-4 py-2"><input type="radio" class="form-radio" name="selectedSubscription" value="' + subscription.SubID + '" data-unpaid="' + subscription.UnpaidSubscription + '" data-pending="' + subscription.HasPendingOrRejected + '"></td>' +
                            '<td class="px-4 py-2">' + subscription.SubID + '</td>' +
                            '<td class="px-4 py-2">' + subscription.ShID + '</td>' +
                            '<td class="px-4 py-2">' + subscription.SubNumShares + '</td>' +
                            '<td class="px-4 py-2">' + (subscription.SubAmount ? parseFloat(subscription.SubAmount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0.00') + '</td>' +
                            '<td class="px-4 py-2">' + (subscription.PaidSubscription ? parseFloat(subscription.PaidSubscription).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0.00') + '</td>' +
                            '<td class="px-4 py-2">' + (subscription.UnpaidSubscription ? parseFloat(subscription.UnpaidSubscription).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0.00') + '</td>' +
                            '<td class="px-4 py-2">' + subscription.SubAuthorizationStatus + '</td>' +
                            '<td class="px-4 py-2">' + subscription.SubStatus + '</td>' +
                            '</tr>'
                        );
                    });

                    // Handle subscription selection
                    $('input[name="selectedSubscription"]').on('change', function () {
                        var selectedSubID = $(this).val();
                        var unpaidSubscription = $(this).data('unpaid');
                        var hasPending = $(this).data('pending') === true || $(this).data('pending') === 'true';

                        $('#selectedSubID').val(selectedSubID);
                        $('#UnpaidSubscription').val(unpaidSubscription);

                        if (hasPending) {
                            $('#pendingPaymentError').text('Please approve the previous payment of this Subscription before submitting a new one.');
                            $('#submitButton').prop('disabled', true);
                        } else {
                            $('#pendingPaymentError').text('');
                            $('#submitButton').prop('disabled', false);
                            validateForm(false); // Re-run other validations
                        }
                    });
                } else {
                    tbody.append(
                        '<tr><td colspan="9" class="px-4 py-2 text-center text-gray-500">No subscriptions found for this shareholder.</td></tr>'
                    );
                    $('#selectedSubID').val('');
                    $('#UnpaidSubscription').val('');
                    $('#submitButton').prop('disabled', true);
                }
            },
            error: function () {
                alert('Error retrieving subscriptions.');
                $('#selectedSubID').val('');
                $('#UnpaidSubscription').val('');
                $('#submitButton').prop('disabled', true);
            }
        });
    }
});
</script>

<script>
$(document).ready(function () {
    const $form = $('form');
    const $submitButton = $('#submitButton');
    let hasPendingOrRejectedPayment = false;

    // Load used reference numbers from sessionStorage or initialize empty array
    let usedReferenceNumbers = JSON.parse(sessionStorage.getItem('usedReferenceNumbers')) || [];

    // Debounce function to limit AJAX calls
    function debounce(func, wait) {
        let timeout;
        return function (...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(this, args), wait);
        };
    }

    function validateForm(showErrors = false) {
        let isValid = true;

        function clearError(selector) {
            $(selector).siblings('.text-danger').text('');
        }

        function setError(selector, message) {
            $(selector).siblings('.text-danger').text(message);
        }

        // Validate Shareholder dropdown
        if ($('#shareholderDropdown').val() === "" || $('#shareholderDropdown').val() === null) {
            isValid = false;
            if (showErrors) setError('#shareholderDropdown', 'Please select a shareholder.');
        } else {
            clearError('#shareholderDropdown');
        }

        // Validate Subscription
        if ($('#subscriptionTable tbody input[type="radio"]:checked').length === 0) {
            isValid = false;
            if (showErrors) $('#subscriptionError').text('Please select a subscription.');
        } else {
            $('#subscriptionError').text('');
        }

        // Check Pending/Rejected Payments
        if (hasPendingOrRejectedPayment) {
            isValid = false;
            if (showErrors) $('#pendingPaymentError').text('Approve the previous payment before submitting a new one.');
        } else {
            $('#pendingPaymentError').text('');
        }

        // Validate Reference Number (client-side only in validateForm)
        const referenceNum = $('#ReferenceNum').val().trim();
        if (referenceNum === "") {
            isValid = false;
            if (showErrors) setError('#ReferenceNum', 'Please provide a reference number.');
        } else if (usedReferenceNumbers.includes(referenceNum)) {
            //isValid = false;
            //if (showErrors) setError('#ReferenceNum', 'This reference number has already been used in this session.');
        } else {
            clearError('#ReferenceNum');
        }

        // Validate Date of Payment
        const paymentDateValue = $('#payment-date-picker').val();
        const paymentDate = new Date(paymentDateValue);
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(today.getDate() + 1); // Set to tomorrow
        tomorrow.setHours(0, 0, 0, 0); // Normalize to midnight

        // Validate tomorrow's date
        if (isNaN(tomorrow.getTime())) {
            isValid = false;
            if (showErrors) setError('#payment-date-picker', 'Invalid system date.');
            return; // Exit early if tomorrow is invalid
        }

        // Validate payment date
        if (paymentDateValue === "") {
            isValid = false;
            if (showErrors) setError('#payment-date-picker', 'Please select a payment date.');
        } else if (isNaN(paymentDate.getTime())) {
            isValid = false;
            if (showErrors) setError('#payment-date-picker', 'Invalid payment date.');
        } else if (paymentDate > tomorrow) {
            isValid = false;
            if (showErrors) setError('#payment-date-picker', 'Payment date cannot be after tomorrow.');
        } else {
            clearError('#payment-date-picker');
        }

        // Validate Uploaded File
        const uploadedFile = $("input[name='uploadedFile']")[0].files[0];
        const maxFileSize = 2 * 1024 * 1024;
        const allowedTypes = ['application/pdf', 'image/jpeg', 'image/pjp',
            'image/apng', 'image/jfif', 'image/pdf', 'image/pjpeg', 'image/png', 'image/jpg'];

        if (!uploadedFile) {
            isValid = false;
            if (showErrors) $('#uploadedFileError').text('Please upload a document.');
        } else if (uploadedFile.size > maxFileSize) {
            isValid = false;
            if (showErrors) $('#uploadedFileError').text('File size must not exceed 2 MB.');
        } else if (!allowedTypes.includes(uploadedFile.type)) {
            isValid = false;
            if (showErrors) $('#uploadedFileError').text('Only PDF or Image(JPG, JPEG, or PNG ...) files are allowed.');
        } else {
            $('#uploadedFileError').text('');
        }

        // Validate Payment Mode fields
        const paymentFields = ['cashAmount', 'AccountAmount', 'cpoAmount', 'dividendAmount', 'chequeAmount', 'RTGSamount', 'Bonusamount'];
        let isPaymentFieldFilled = paymentFields.some(field => parseFloat($(`input[name="${field}"]`).val()) > 0);

        if (!isPaymentFieldFilled) {
            isValid = false;
            if (showErrors) $('#paymentFieldsError').text('At least one payment mode is required.');
        } else {
            $('#paymentFieldsError').text('');
        }

        return isValid;
    }

    function checkExistingPayment(subId) {
        $.ajax({
            url: '@Url.Action("CheckExistingPayment", "Payments")',
            type: 'GET',
            data: { subId: subId },
            success: function (response) {
                hasPendingOrRejectedPayment = response.hasPendingOrRejected;
                if (hasPendingOrRejectedPayment) {
                    $('#pendingPaymentError').text('Approve the previous payment before submitting a new one.');
                    $submitButton.prop('disabled', true);
                } else {
                    $('#pendingPaymentError').text('');
                    validateForm(false);
                }
            },
            error: function () {
                $('#pendingPaymentError').text('Error checking payment status. Please try again.');
                hasPendingOrRejectedPayment = true;
                $submitButton.prop('disabled', true);
            }
        });
    }

    // Real-time server-side validation for ReferenceNum
    const checkReferenceNum = debounce(function (referenceNum) {
        if (referenceNum === "") {
            $('#ReferenceNum').siblings('.text-danger').text('Please provide a reference number.');
            return;
        }
        if (usedReferenceNumbers.includes(referenceNum)) {
            //$('#ReferenceNum').siblings('.text-danger').text('This reference number has already been used in this session.');
            //return;
        }
        $.ajax({
            url: '@Url.Action("CheckReferenceNum", "Payments")',
            type: 'GET',
            data: { referenceNum: referenceNum },
            success: function (response) {
                if (!response.isUnique) {
                    $('#ReferenceNum').siblings('.text-danger').text('This reference number has already been used.');
                } else {
                    $('#ReferenceNum').siblings('.text-danger').text('');
                }
            },
            error: function () {
                $('#ReferenceNum').siblings('.text-danger').text('Error checking reference number.');
            }
        });
    }, 500); // Wait 500ms after typing stops

    $('#ReferenceNum').on('input change', function () {
        const referenceNum = $(this).val().trim();
        checkReferenceNum(referenceNum);
        validateForm(false); // Update isValid for other fields
    });

    // Real-time validation for other fields (no immediate errors)
    $('#shareholderDropdown, #payment-date-picker, input[name="uploadedFile"], #subscriptionTable input[type="radio"]')
        .on('input change', function () {
            validateForm(false);
        });

    // Payment mode fields
    $('input[name="cashAmount"], input[name="AccountAmount"], input[name="cpoAmount"], input[name="dividendAmount"], input[name="chequeAmount"], input[name="RTGSamount"], input[name="Bonusamount"]')
        .on('input change', function () {
            validateForm(false);
        });

    $('#subscriptionTable input[type="radio"]').on('change', function () {
        checkExistingPayment($(this).val());
    });

    // Form submission
    $form.on('submit', function (event) {
        event.preventDefault();
        if (validateForm(true)) {
            const referenceNum = $('#ReferenceNum').val().trim();
            usedReferenceNumbers.push(referenceNum); // Add to used list
            sessionStorage.setItem('usedReferenceNumbers', JSON.stringify(usedReferenceNumbers)); // Save to sessionStorage
            $submitButton.prop('disabled', true).text('Submitting...');
            $form.off('submit').submit();
        }
    });

    // Initial validation on page load
    validateForm(false);
});
</script>


<script>
    let isFormSubmitted = false;

    $(document).ready(function () {
        $('form').on('submit', function () {
            if (isFormSubmitted) {
                return false; // Prevent duplicate submission
            }
            isFormSubmitted = true; // Set the flag
        });
    });
</script>