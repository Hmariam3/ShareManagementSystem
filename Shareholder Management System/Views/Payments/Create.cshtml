                                    </div>

                                </div>
                                <div class="mb-5">
                                    @Html.Label("Upload Document", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })
                                    <div class="custom-file-container" data-upload-id="myFirstImage">
                                        <div class="custom-file-container__image-preview">
                                            <input type="file" class="form-input file:py-2 file:px-4 file:border-0 file:font-semibold p-0 file:bg-primary/90 ltr:file:mr-5 rtl:file:ml-5 file:text-white file:hover:bg-primary" accept="*" name="uploadedFile">
                                            <span class="custom-file-container__custom-file__custom-file-control"></span>
                                        </div>
                                        <span class="text-danger" id="uploadedFileError"></span> <!-- Error message here -->
                                    </div>
                                </div>


                            </div>

                        </div>
                    </div>

                    <div class="mb-5">
                        <div class="flex items-center">
                            @Html.Label("Remark", htmlAttributes: new { @class = "block dark:text-white-light text-sm font-semibold mb-2" })

                        </div>
                        <div class="amount-input-container flex flex-col ml-4">
