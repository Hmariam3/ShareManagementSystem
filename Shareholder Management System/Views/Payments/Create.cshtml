                                    </div>
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.PaymentDate, new { htmlAttributes = new {
                                            type = "date",
                                            @class = "form-input border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                                            @id = "payment-date-picker",
                                            max = DateTime.Now.ToString("yyyy-MM-dd") // Set max date to today
                                        }})
