                    Authorization Date
                    <span class="mt-1 block text-xs font-normal text-white-dark dark:text-white-light">
                        @Html.DisplayFor(model => model.AuthorizationDate)
                    </span>
                </h6>
            </div>
        </div>*@

                <!-- Subscription Status -->
                <div class="border-b border-[#ebedf2] dark:border-[#1b2e4b]">
                    <div class="flex items-start justify-between py-3">
                        <h6 class="text-[15px] font-bold text-[#515365] dark:text-white-dark">
                            Subscription Status
                            <span class="mt-1 block text-xs font-normal text-white-dark dark:text-white-light">
                                @Html.DisplayFor(model => model.Subscribtion.SubStatus)
                            </span>
                        </h6>
                    </div>
                </div>
                <!-- Remarks -->
                <div class="border-b border-[#ebedf2] dark:border-[#1b2e4b]">
                    <div class="flex items-start justify-between py-3">
                        <h6 class="text-[15px] font-bold text-[#515365] dark:text-white-dark">
                            Remarks
                            <span class="mt-1 block text-xs font-normal text-white-dark dark:text-white-light">
                                @Html.DisplayFor(model => model.Remark)
                            </span>
                        </h6>
                    </div>
                </div>
            </div>
        </div>
        <div class="w-full flex justify-between mt-6">
            @if (Model.PaymentAuthorizationStatus == "Pending" || Model.PaymentAuthorizationStatus == "Rejected")
            {
                @Html.ActionLink("Edit", "Edit", new { id = Model.PayID }, new { @class = "btn btn-primary" })
            }
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success px-4 py-2 bg-green-500 hover:bg-green-600 rounded text-white" })
        </div>

