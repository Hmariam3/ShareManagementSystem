<p>
    @using (Html.BeginForm("Authorize", "Payments", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="flex justify-center mt-5">
            <div>
                <div class="flex justify-between">
                    @if (Model.PaymentAuthorizationStatus == "Approved")
                    {
                        <button type="submit" class="btn btn-primary mt-6" disabled>Authorize</button>
                    }
                    else
                    {
                        <button type="submit" name="action" value="approve" class="btn btn-primary mt-6">Authorize</button>
                    }
                </div>
            </div>

            <div>
                <div class="flex justify-between" style="margin-left:5px">
                    @if (Model.PaymentAuthorizationStatus == "Rejected")
                    {
                        <button type="submit" class="btn btn-danger mt-6" disabled>Reject</button>
                    }
                    else
                    {
                        <button type="submit" name="action" value="reject" class="btn btn-danger mt-6">Reject</button>
                    }
                </div>
            </div>
        </div>

        <a href="@Url.Action("Index")" class="btn btn-success px-4 py-2 mt-5 text-white bg-green-500 hover:bg-green-600 rounded">
            Back To List
        </a>
    }
</p>
