@model IEnumerable<Shareholder_Management_System.Models.User>
@{
    ViewBag.Title = "Home Page";
}

@{
    var userRole = Session["Roles"]?.ToString();
}

@if (userRole == "Administrator")
{
    <div class="animate__animated p-6">
        <div >
            <div class="pt-5">
                <div class="mb-6 grid grid-cols-1 gap-6 text-white sm:grid-cols-2 xl:grid-cols-4">
                    <!-- Users Visit -->
                    <div class="panel bg-gradient-to-r from-cyan-500 to-cyan-400">
                        <div class="flex justify-between">
                            <div class="text-md font-semibold ltr:mr-1 rtl:ml-1">Users Registered</div>
                            <div x-data="dropdown" x-on:click.outside="open = false" class="dropdown">
                                <a href="javascript:;" x-on:click="toggle">
                                    <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70 hover:opacity-80">
                                        <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                    </svg>
                                </a>
                            </div>
                        </div>
                        <div class="mt-5 flex items-center">
                            <div class="text-3xl font-bold ltr:mr-3 rtl:ml-3">@ViewBag.countUser</div>
                            <div class="badge bg-white/30">Entire Users Registred in the System</div>
                        </div>
                        <div class="mt-5 flex items-center font-semibold">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 ltr:mr-2 rtl:ml-2">
                                <path opacity="0.5" d="M3.27489 15.2957C2.42496 14.1915 2 13.6394 2 12C2 10.3606 2.42496 9.80853 3.27489 8.70433C4.97196 6.49956 7.81811 4 12 4C16.1819 4 19.028 6.49956 20.7251 8.70433C21.575 9.80853 22 10.3606 22 12C22 13.6394 21.575 14.1915 20.7251 15.2957C19.028 17.5004 16.1819 20 12 20C7.81811 20 4.97196 17.5004 3.27489 15.2957Z" stroke="currentColor" stroke-width="1.5"></path>
                                <path d="M15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" stroke="currentColor" stroke-width="1.5"></path>
                            </svg>

                        </div>
                    </div>

                    <!-- Sessions -->
                    <div class="panel bg-gradient-to-r from-violet-500 to-violet-400">
                        <div class="flex justify-between">
                            <div class="text-md font-semibold ltr:mr-1 rtl:ml-1">Active Users</div>
                            <div x-data="dropdown" x-on:click.outside="open = false" class="dropdown">
                                <a href="javascript:;" x-on:click="toggle">
                                    <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70 hover:opacity-80">
                                        <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                    </svg>
                                </a>
                            </div>
                        </div>
                        <div class="mt-5 flex items-center">
                            <div class="text-3xl font-bold ltr:mr-3 rtl:ml-3">@ViewBag.countActive</div>
                            <div class="badge bg-white/30">Current Active Users</div>
                        </div>
                        <div class="mt-5 flex items-center font-semibold">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 ltr:mr-2 rtl:ml-2">
                                <path opacity="0.5" d="M3.27489 15.2957C2.42496 14.1915 2 13.6394 2 12C2 10.3606 2.42496 9.80853 3.27489 8.70433C4.97196 6.49956 7.81811 4 12 4C16.1819 4 19.028 6.49956 20.7251 8.70433C21.575 9.80853 22 10.3606 22 12C22 13.6394 21.575 14.1915 20.7251 15.2957C19.028 17.5004 16.1819 20 12 20C7.81811 20 4.97196 17.5004 3.27489 15.2957Z" stroke="currentColor" stroke-width="1.5"></path>
                                <path d="M15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" stroke="currentColor" stroke-width="1.5"></path>
                            </svg>

                        </div>
                    </div>

                    <!-- Time On-Site -->
                    <div class="panel bg-gradient-to-r from-blue-500 to-blue-400">
                        <div class="flex justify-between">
                            <div class="text-md font-semibold ltr:mr-1 rtl:ml-1">Inactive Users</div>
                            <div x-data="dropdown" x-on:click.outside="open = false" class="dropdown">
                                <a href="javascript:;" x-on:click="toggle">
                                    <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70 hover:opacity-80">
                                        <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                    </svg>
                                </a>
                            </div>
                        </div>
                        <div class="mt-5 flex items-center">
                            <div class="text-3xl font-bold ltr:mr-3 rtl:ml-3">@ViewBag.countInactive</div>
                            <div class="badge bg-white/30">By Management Decision</div>
                        </div>
                        <div class="mt-5 flex items-center font-semibold">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 ltr:mr-2 rtl:ml-2">
                                <path opacity="0.5" d="M3.27489 15.2957C2.42496 14.1915 2 13.6394 2 12C2 10.3606 2.42496 9.80853 3.27489 8.70433C4.97196 6.49956 7.81811 4 12 4C16.1819 4 19.028 6.49956 20.7251 8.70433C21.575 9.80853 22 10.3606 22 12C22 13.6394 21.575 14.1915 20.7251 15.2957C19.028 17.5004 16.1819 20 12 20C7.81811 20 4.97196 17.5004 3.27489 15.2957Z" stroke="currentColor" stroke-width="1.5"></path>
                                <path d="M15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" stroke="currentColor" stroke-width="1.5"></path>
                            </svg>

                        </div>
                    </div>

                    <!-- Bounce Rate -->
                    <div class="panel bg-gradient-to-r from-fuchsia-500 to-fuchsia-400">
                        <div class="flex justify-between">
                            <div class="text-md font-semibold ltr:mr-1 rtl:ml-1">Locked User</div>
                            <div x-data="dropdown" x-on:click.outside="open = false" class="dropdown">
                                <a href="javascript:;" x-on:click="toggle">
                                    <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70 hover:opacity-80">
                                        <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                    </svg>
                                </a>
                            </div>
                        </div>
                        <div class="mt-5 flex items-center">
                            <div class="text-3xl font-bold ltr:mr-3 rtl:ml-3">@ViewBag.countLocked</div>
                            <div class="badge bg-white/30">Locked Due to Password</div>
                        </div>
                        <div class="mt-5 flex items-center font-semibold">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 ltr:mr-2 rtl:ml-2">
                                <path opacity="0.5" d="M3.27489 15.2957C2.42496 14.1915 2 13.6394 2 12C2 10.3606 2.42496 9.80853 3.27489 8.70433C4.97196 6.49956 7.81811 4 12 4C16.1819 4 19.028 6.49956 20.7251 8.70433C21.575 9.80853 22 10.3606 22 12C22 13.6394 21.575 14.1915 20.7251 15.2957C19.028 17.5004 16.1819 20 12 20C7.81811 20 4.97196 17.5004 3.27489 15.2957Z" stroke="currentColor" stroke-width="1.5"></path>
                                <path d="M15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" stroke="currentColor" stroke-width="1.5"></path>
                            </svg>

                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
                    <!-- Favorites -->
                    <div>
                        <div class="mb-5 flex items-center font-bold">
                            <span class="text-lg">Role</span>
                            @*<a href="~/Users/Index" class="text-primary hover:text-black ltr:ml-auto rtl:mr-auto dark:hover:text-white-dark">
                                    See All
                                </a>*@
                        </div>
                        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 md:mb-5">
                            <!-- Bitcoin -->
                            <div class="panel">
                                <div class="mb-5 flex items-center font-semibold">
                                    <div class="grid h-10 w-10 shrink-0 place-content-center rounded-full">
                                        <svg class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                                        </svg>
                                    </div>
                                    <div class="ltr:ml-2 rtl:mr-2">
                                        <h6 class="text-dark dark:text-white-light">ADM</h6>
                                        <p class="text-xs text-white-dark">Administrator</p>
                                    </div>
                                </div>
                                <div class="mb-5 overflow-hidden">
                                    <div x-ref="bitcoin"></div>
                                </div>
                                <div class="flex items-center justify-between text-base font-bold" style="color: #00ADEF">
                                    @ViewBag.countAdmin<span class="text-sm font-normal text-success"></span>
                                </div>
                            </div>

                            <!-- Ethereum -->
                            <div class="panel">
                                <div class="mb-5 flex items-center font-semibold">
                                    <div class="grid h-10 w-10 shrink-0 place-content-center rounded-full">
                                        <svg class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                        </svg>
                                    </div>
                                    <div class="ltr:ml-2 rtl:mr-2">
                                        <h6 class="text-dark dark:text-white-light">INS</h6>
                                        <p class="text-xs text-white-dark">Initiator</p>
                                    </div>
                                </div>
                                <div class="mb-5 overflow-hidden">
                                    <div x-ref="ethereum"></div>
                                </div>
                                <div class="flex items-center justify-between text-base font-bold" style="color: #EE7B28">
                                    @ViewBag.countIntiator<span class="text-sm font-normal text-danger"></span>
                                </div>
                            </div>

                            <!-- Litecoin -->
                            <div class="panel">
                                <div class="mb-5 flex items-center font-semibold">
                                    <div class="grid h-10 w-10 shrink-0 place-content-center rounded-full">
                                        <svg class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <div class="ltr:ml-2 rtl:mr-2">
                                        <h6 class="text-dark dark:text-white-light">AUT</h6>
                                        <p class="text-xs text-white-dark">Authorizer</p>
                                    </div>
                                </div>
                                <div class="mb-5 overflow-hidden">
                                    <div x-ref="litecoin"></div>
                                </div>
                                <div class="flex items-center justify-between text-base font-bold">
                                    @ViewBag.countAuthorizer<span class="text-sm font-normal text-success"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Live Transaction -->
                    <div>
                        <div class="mb-5 flex items-center font-bold">
                            <span class="text-lg">Live Transactions</span>
                        </div>
                        <div class="mb-6 grid grid-cols-1 gap-6 sm:grid-cols-4">
                            <!-- Share Holder -->
                            <div class="panel">
                                <div class="mb-5 flex items-center font-semibold">
                                    <div class="grid h-10 w-10 shrink-0 place-content-center rounded-full">
                                        <svg class="h-8 w-8 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                                            <polyline points="16 6 12 2 8 6" />
                                            <line x1="12" y1="2" x2="12" y2="15" />
                                        </svg>
                                    </div>
                                    <div class="ltr:ml-2 rtl:mr-2">
                                        <h6 class="text-dark dark:text-white-light">ShH</h6>
                                        <p class="text-xs text-white-dark">Share Holders</p>
                                    </div>
                                </div>
                                <div class="mb-5 overflow-hidden">
                                    <div x-ref="tether"></div>
                                </div>
                                <div class="flex items-center justify-between text-base font-bold">
                                    @ViewBag.countShare
                                    <span class="text-sm font-normal text-success" title="@ViewBag.PercentageCurrentYearShareholders Percentage of Shareholders Registered This Year">
                                        @ViewBag.PercentageCurrentYearShareholders %
                                    </span>
                                </div>
                            </div>

                            <!-- Subsctiobtion -->
                            <div class="panel">
                                <div class="mb-5 flex items-center font-semibold">
                                    <div class="grid h-10 w-10 shrink-0 place-content-center rounded-full">
                                        <svg class="h-8 w-8 text-red-500" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" />
                                            <circle cx="6" cy="12" r="3" />
                                            <circle cx="18" cy="6" r="3" />
                                            <circle cx="18" cy="18" r="3" />
                                            <line x1="8.7" y1="10.7" x2="15.3" y2="7.3" />
                                            <line x1="8.7" y1="13.3" x2="15.3" y2="16.7" />
                                        </svg>
                                    </div>
                                    <div class="ltr:ml-2 rtl:mr-2">
                                        <h6 class="text-dark dark:text-white-light">SUB</h6>
                                        <p class="text-xs text-white-dark">Subscription</p>
                                    </div>
                                </div>
                                <div class="mb-5 overflow-hidden">
                                    <div x-ref="tether"></div>
                                </div>
                                <div class="flex items-center justify-between text-base font-bold">
                                    @ViewBag.countSub
                                    <span class="text-sm font-normal text-success" title="@ViewBag.PercentageSubs Percentage of Subscribtions Given This Year">
                                        @ViewBag.PercentageSubs %
                                    </span>
                                </div>
                            </div>

                            <!-- Payment -->
                            <div class="panel">
                                <div class="mb-5 flex items-center font-semibold">
                                    <div class="grid h-10 w-10 shrink-0 place-content-center rounded-full bg-warning p-2">
                                        <svg class="h-8 w-8 text-red-500" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" />
                                            <circle cx="6" cy="12" r="3" />
                                            <circle cx="18" cy="6" r="3" />
                                            <circle cx="18" cy="18" r="3" />
                                            <line x1="8.7" y1="10.7" x2="15.3" y2="7.3" />
                                            <line x1="8.7" y1="13.3" x2="15.3" y2="16.7" />
                                        </svg>
                                    </div>
                                    <div class="ltr:ml-2 rtl:mr-2">
                                        <h6 class="text-dark dark:text-white-light">PAY</h6>
                                        <p class="text-xs text-white-dark">Payment</p>
                                    </div>
                                </div>
                                <div class="mb-5 overflow-hidden">
                                    <div x-ref="solana"></div>
                                </div>
                                <div class="flex items-center justify-between text-base font-bold">
                                    @ViewBag.countPay
                                    <span class="text-sm font-normal text-danger" title="@ViewBag.PercentagePay Percentage of Paments made This Year">
                                        @ViewBag.PercentagePay %
                                    </span>
                                </div>
                            </div>

                            <!-- Transfer -->
                            <div class="panel">
                                <div class="mb-5 flex items-center font-semibold">
                                    <div class="grid h-10 w-10 shrink-0 place-content-center rounded-full bg-warning p-2">
                                        <svg class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                                        </svg>
                                    </div>
                                    <div class="ltr:ml-2 rtl:mr-2">
                                        <h6 class="text-dark dark:text-white-light">TRA</h6>
                                        <p class="text-xs text-white-dark">Transfer</p>
                                    </div>
                                </div>
                                <div class="mb-5 overflow-hidden">
                                    <div x-ref="solana"></div>
                                </div>
                                <div class="flex items-center justify-between text-base font-bold">
                                    @ViewBag.countTran
                                    <span class="text-sm font-normal text-danger" title="@ViewBag.percentageTrans Percentage of Tranfers made This Year">
                                        @ViewBag.percentageTrans %
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
                    <div class="grid gap-6 xl:grid-flow-row">
                        <!-- Current Year Statement -->
                        <div class="panel overflow-hidden">
                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="text-lg font-bold">Paid Up Capital Statement</div>
                                    <div class="text-success">Paid Up To @DateTime.Now.ToString("MMMM dd, yyyy")</div>
                                </div>
                                <div x-data="dropdown" x-on:click.outside="open = false" class="dropdown">
                                    <a href="javascript:;" x-on:click="toggle">
                                        <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70 hover:opacity-80">
                                            <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                            <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                            <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                            <div class="relative mt-10">
                                <div class="absolute -bottom-12 h-24 w-24 ltr:-right-12 rtl:-left-12">
                                    <svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full text-success opacity-20">
                                        <circle opacity="0.5" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"></circle>
                                        <path d="M8.5 12.5L10.5 14.5L15.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                                <div class="grid grid-cols-2 gap-6 md:grid-cols-3">
                                    <div>
                                        <div class="text-primary">Paid Up Capital</div>
                                        <div class="mt-2 text-2xl font-semibold">Birr @ViewBag.PaidUpCapital</div>
                                    </div>
                                    <div>
                                        <div class="text-primary">Unpaid Capital</div>
                                        <div class="mt-2 text-2xl font-semibold">Birr @ViewBag.UnpaidCapital</div>
                                    </div>
                                    <div>
                                        <div class="text-primary">Total Capital</div>
                                        <div class="mt-2 text-2xl font-semibold">Birr @ViewBag.TotalCapital</div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>

                    <!-- Recent Transactions -->
                    <div class="panel">
                        <div class="mb-5 text-lg font-bold">Recently Added Users</div>
                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th class="ltr:rounded-l-md rtl:rounded-r-md">ID</th>
                                        <th>DATE</th>
                                        <th>NAME</th>
                                        <th>Role</th>
                                        <th class="text-center ltr:rounded-r-md rtl:rounded-l-md">STATUS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => user.UID)</td>
                                            <td>@user.CreatedDate.ToString("MMM dd, yyyy")</td>
                                            <td>@user.FullName</td>
                                            <td>
                                                @if (@user.Role == "Initiator")
                                                {
                                                    <span class="badge rounded-full bg-success/20 text-success hover:top-0">@user.Role</span>
                                                }
                                                else if (@user.Role == "Authorizer")
                                                {
                                                    <span class="badge rounded-full bg-info/20 text-info hover:top-0">@user.Role</span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-full bg-danger/20 text-danger hover:top-0">@user.Role</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.Status == true)
                                                {
                                                    <span class="badge rounded-full bg-success/20 text-success hover:top-0">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-full bg-danger/20 text-danger hover:top-0">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
