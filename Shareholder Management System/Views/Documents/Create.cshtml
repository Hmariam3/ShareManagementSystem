<script>
    // Add event listener for the "Pinned" button
document.querySelector('[x-on\\:click="activeTab = \'tab-pinned\'"]').addEventListener("click", function () {
    fetch('@Url.Action("GetPinnedDocuments", "Documents")')
        .then(response => {
            if (!response.ok) {
                throw new Error("Network response was not ok");
            }
            return response.json();
        })
        .then(data => {
            if (data.success === false) {
                console.error("Error fetching pinned documents:", data.message);
            } else {
                // Update the chart with sorted data
                updateChart(data);

                // Update the table with sorted data
                populateTable(data);
            }
        })
        .catch(error => console.error("Error fetching pinned documents:", error));
});
</script>


<script>
   document.querySelectorAll("#fetchShareholderDocs").forEach(button => {
    button.addEventListener("click", function () {
        // Get the document type from the data-doctype attribute
        const doctype = this.getAttribute("data-doctype");

        fetch('@Url.Action("GetShareholderDocuments", "Documents")?doctype=' + doctype)
            .then(response => response.json())
            .then(data => {
                if (data.success === false) {
                    console.error("Error fetching documents:", data.message);
                } else {
                    populateTable(data); // Populate the table with documents data
                }
            })
            .catch(error => console.error("Error fetching documents:", error));
    });
});
    function populateTable(documents) {
        const tableContainer = document.getElementById("documentsTableContainer");
        tableContainer.innerHTML = ""; // Clear any existing content

        // Create and add search bar
        const searchContainer = document.createElement("div");
