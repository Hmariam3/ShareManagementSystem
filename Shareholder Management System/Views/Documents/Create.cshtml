// Function to update the chart
function updateChart(data) {
    const docTypes = data.map(d => d.DocType);
    const docCounts = data.map(d => d.Count);

    // Destroy the existing chart if it exists
    if (window.docTypePieChart) {
        window.docTypePieChart.destroy();
    }

    // Create a new chart
    var ctx = document.getElementById('docTypePieChart').getContext('2d');
    window.docTypePieChart = new Chart(ctx, {
        type: 'pie',
        data: {
            labels: docTypes,
            datasets: [{
                label: 'Document Types',
                data: docCounts,
                backgroundColor: [
                    '#FF6384', // Color for each slice
                    '#36A2EB',
                    '#FFCE56',
                    '#4BC0C0',
                    '#9966FF',
                    '#9966FF',
                ]
            }]
        },
        options: {
            responsive: false, // Set to false to maintain the fixed dimensions
            plugins: {
                legend: {
                    position: 'top'
                },
                tooltip: {
                    enabled: true
                }
            }
        }
    });
}

