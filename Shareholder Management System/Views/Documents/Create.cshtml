<div class="table-container" id="documentsTableContainer">
    <!-- This will be populated with the document table -->
</div>

<script>
   document.querySelectorAll("#fetchShareholderDocs").forEach(button => {
    button.addEventListener("click", function () {
        // Get the document type from the data-doctype attribute
        const doctype = this.getAttribute("data-doctype");

        fetch('@Url.Action("GetShareholderDocuments", "Documents")?doctype=' + doctype)
            .then(response => response.json())
            .then(data => {
                if (data.success === false) {
                    console.error("Error fetching documents:", data.message);
                } else {
                    populateTable(data); // Populate the table with documents data
                }
            })
            .catch(error => console.error("Error fetching documents:", error));
    });
});
    function populateTable(documents) {
        const tableContainer = document.getElementById("documentsTableContainer");
        tableContainer.innerHTML = ""; // Clear any existing content

        // Create and add search bar
        const searchContainer = document.createElement("div");
        searchContainer.className = "search-container";
        const searchInput = document.createElement("input");
        searchInput.type = "text";
        searchInput.id = "searchBar";
        searchInput.placeholder = "Search...";
        searchInput.addEventListener("input", function () {
            filterTable(searchInput.value.toLowerCase());
        });
        searchContainer.appendChild(searchInput);
        tableContainer.appendChild(searchContainer);

        // Create the table wrapper
        const tableWrapper = document.createElement("div");
        tableWrapper.className = "table-wrapper";

        const table = document.createElement("table");
        table.className = "document-table";

        // Define table headers
        const headers = [
            'Document Id', 'Document Name', 'Document Type', 'Document Path', 'Document Owner',
            'Created By', 'Created Date', 'Authorization Status', 'Authorization Date', 'Authorizer', 'Action'
        ];

        // Add headers to table
        const headerRow = document.createElement("tr");
        headers.forEach(header => {
            const th = document.createElement("th");
            th.textContent = header;
            headerRow.appendChild(th);
        });
        table.appendChild(headerRow);

        // Check if documents is empty and handle gracefully
        if (documents.length > 0) {
            documents.forEach(doc => {
                const row = document.createElement("tr");
                row.className = "data-row";

                // Create table cells for document data
                const fields = [
                    doc.DocumentId, doc.DocumentName, doc.DocumentType, doc.DocumentPath, doc.DocumentOwner,
                    doc.CreatedBy, new Date(doc.CreatedDate).toLocaleString(), doc.AuthorizationStatus,
                    doc.AuthorizationDate ? new Date(doc.AuthorizationDate).toLocaleString() : "",
                    doc.Authorizer
                ];
                console.log(fields);
                fields.forEach(value => {
                    const td = document.createElement("td");
                    td.textContent = value !== null ? value : ""; // Handle null values
                    row.appendChild(td);
                });

                // Add action buttons
                const actionTd = document.createElement("td");
                const viewButton = document.createElement("button");
                viewButton.textContent = "View";
                viewButton.className = "view-button";
                viewButton.addEventListener("click", function () {
                    alert(`Viewing document: ${doc.DocumentName}`);
                });
                actionTd.appendChild(viewButton);
                row.appendChild(actionTd);

                table.appendChild(row);
            });
        } else {
            // Handle case when no documents are available
            const noDataRow = document.createElement("tr");
            const noDataTd = document.createElement("td");
            noDataTd.colSpan = headers.length;
            noDataTd.textContent = "No documents available.";
            noDataTd.style.textAlign = "center";
            noDataRow.appendChild(noDataTd);
            table.appendChild(noDataRow);
        }

        tableWrapper.appendChild(table);
        tableContainer.appendChild(tableWrapper);
    }

    function filterTable(query) {
        const rows = document.querySelectorAll(".data-row");
        rows.forEach(row => {
            const rowText = row.textContent.toLowerCase();
            row.style.display = rowText.includes(query) ? "" : "none";
        });
    }
</script>








