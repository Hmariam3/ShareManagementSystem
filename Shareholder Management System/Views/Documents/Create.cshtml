<script>
    // Fetch data from the server
    fetch('@Url.Action("GetDocumentCounts", "Documents")')
        .then(response => response.json())
        .then(data => {
            // Process data
            const docTypes = data.map(d => d.DocType);
            const docCounts = data.map(d => d.Count);

            // Set up Chart.js
            var ctx = document.getElementById('docTypePieChart').getContext('2d');
            var chart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: docTypes,
                    datasets: [{
                        label: 'Document Types',
                        data: docCounts,
                        backgroundColor: [
                            '#FF6384', // Color for each slice
                            '#36A2EB',
                            '#FFCE56',
                            '#4BC0C0',
                            '#9966FF',
                            '#9966FF',
                        ]
                    }]
                },
                options: {
                    responsive: false, // Set to false to maintain the fixed dimensions
                    plugins: {
                        legend: {
                            position: 'top'
                        },
                        tooltip: {
                            enabled: true
                        }
                    }
                }
            });
        })
        .catch(error => console.error('Error fetching document data:', error));
</script>
