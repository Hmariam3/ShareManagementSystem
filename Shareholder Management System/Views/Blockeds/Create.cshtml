@model Shareholder_Management_System.Models.Blocked

@{
    ViewBag.Title = "Create";
}

<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
@*<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.min.js"></script>*@
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>

@using (Html.BeginForm("Create", "Blockeds", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="animate__animated p-3" :class="[$store.app.animation]">
        <div x-data="form">

            <div class="flex items-center justify-between"
                 style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                <h5 class="text-lg font-semibold dark:text-white-light" style="padding:7px;">Blocking Payment Form</h5>
            </div>

            <div class="grid grid-cols-1 gap-6 pt-5">
                <div class="panel">

                    <div class="row">
                        <!-- Column 1 -->
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="mb-5">
                                    <label for="ShID" class="block dark:text-white-light text-sm font-semibold mb-2">Share Holder</label>
                                    <select id="ShID" name="ShID" class="form-select block w-full border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" required>
                                        <option value="">Select Shareholder</option>
                                        @if (ViewBag.SelectedShId != null)
                                        {
                                            <option value="@ViewBag.SelectedShId" selected>@ViewBag.SelectedShName</option>
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(model => model.ShID, "", new { @class = "text-red-500 text-xs mt-1" })
                                    <span class="text-danger" id="shareholderError"></span>
                                </div>

                                <!-- Payments Table -->
                                <div class="panel">
                                    <div class="mb-5 flex items-center justify-between">
                                        <h5 class="text-lg font-semibold dark:text-white-light">Available Payments</h5>
                                    </div>
                                    <div class="mb-5">
                                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                            <table id="paymentsTable">
                                                <thead style="position: sticky; top: 0; background-color: #f3f4f6; z-index: 1;">
                                                    <tr>
                                                        <th>Select</th>
                                                        <th>PayID</th>
                                                        <th>Payment Mode</th>
                                                        <th>Paid Amount</th>
                                                        <th>Blocked Amount</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mt-4">
                                    <!-- Blocked Amount -->

                                    <div class="col-md-10">
                                        <label>Blocked Amount</label>
                                        @Html.EditorFor(model => model.BlockedAmount, new { htmlAttributes = new { @class = "form-input", id = "BlockedAmount", required = "reqiured" } })
                                        <span id="blockedAmountError" class="text-danger"></span>
                                        @Html.ValidationMessageFor(model => model.BlockedAmount, "", new { @class = "text-danger" })
                                    </div>

                                    <!-- Blocking Organ -->

                                    <div class="col-md-10">
                                        <label>Blocking Organ</label>
                                        @Html.EditorFor(model => model.BlockingOrgan, new { htmlAttributes = new { @class = "form-input" } })
                                        @Html.ValidationMessageFor(model => model.BlockingOrgan, "", new { @class = "text-danger" })
                                    </div>

                                    <!-- RefNum -->

                                    <div class="col-md-10">
                                        <label>Reference Number</label>
                                        @Html.EditorFor(model => model.RefNum, new { htmlAttributes = new { @class = "form-input" } })
                                        @Html.ValidationMessageFor(model => model.RefNum, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <br />
                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mt-4">
                                    <div class="mb-5">
                                        <label>Upload Document <span style="color:red">*</span></label>
                                        <div class="custom-file-container" data-upload-id="myFirstImage">
                                            <div class="custom-file-container__image-preview">
                                                <input type="file"
                                                       class="form-input file:py-2 file:px-4 file:border-0 file:font-semibold p-0 file:bg-primary/90 ltr:file:mr-5 rtl:file:ml-5 file:text-white file:hover:bg-primary"
                                                       accept="*" name="uploadedFile" required>
                                                <span class="custom-file-container__custom-file__custom-file-control"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <label>Reason</label>
                                        @Html.EditorFor(model => model.Reason, new { htmlAttributes = new { @class = "form-input" } })
                                        @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                                    </div>

                                    <!-- Remark -->
                                    <div class="col-md-10">
                                        <label>Remark</label>
                                        @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @class = "form-input" } })
                                        @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- Submit and Back to List -->
                    <div class="form-group text-center mt-4">
                        <div class="d-flex justify-content-center align-items-center">
                            <div class="me-3">
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>

    <!-- Hidden field to store selected PayID -->
    <input type="hidden" id="SelectedPayID" name="PayID" />
}




<!-- Scripts for handling the payment table and form validation -->
@*<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>*@
<!-- Ensure jQuery is loaded before Select2 -->
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/select2.min.js"></script>

<!-- Initialize Select2 -->
<script type="text/javascript">
    $(document).ready(function () {

      // Initialize Select2 for shareholder dropdown
        $('#ShID').select2({
        placeholder: "Select a Shareholder",
        allowClear: true,
        width: '100%',
        minimumInputLength: 3,
        ajax: {
            url: '@Url.Action("SearchShareholders", "Blockeds")',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    term: params.term || '',
                    page: params.page || 1
                };
            },
            processResults: function (data, params) {
                params.page = params.page || 1;
                return {
                    results: data.items.map(function (item) {
                        return {
                            id: item.id,
                            text: item.text
                        };
                    }),
                    pagination: {
                        more: data.hasMore
                    }
                };
            },
            cache: true
        }
    });
    });
</script>


<script type="text/javascript">
    $(document).ready(function () {
        // Load payments based on selected Shareholder
        $('#ShID').change(function () {
            var shareholderId = $(this).val();

            if (shareholderId) {
                $.ajax({
                    url: '@Url.Action("GetPaymentsByShareholderId", "Blockeds")',
                    type: "GET",
                    data: { shId: shareholderId },
                    success: function (data) {
                        var paymentsTableBody = $('#paymentsTable tbody');
                        paymentsTableBody.empty(); // Clear current table rows

                        $.each(data, function (index, payment) {
                            // Helper function to replace null or undefined with '-'
                            function safe(value) {
                                return value == null ? '-' : value;
                            }

                            var row = '<tr>' +
                                '<td><input class="form-radio text-blue-400" type="radio" name="selectedPayment" value="' + safe(payment.PayID) + '" data-paid-amount="' + safe(payment.PaidAmount) + '" data-blocked-amount="' + safe(payment.BlockedAmount) + '" data-auth-status="' + safe(payment.PaymentAuthorizationStatus) + '"></td>' +
                                '<td>' + safe(payment.PayID) + '</td>' +
                                '<td>' + safe(payment.PaymentMode) + '</td>' +
                                '<td>' + safe(payment.PaidAmount) + '</td>' +
                                '<td>' + safe(payment.BlockedAmount) + '</td>' +
                                '</tr>';

                            paymentsTableBody.append(row);
                        });

                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching payments:", status, error);
                        alert("Error fetching payments.");
                    }
                });
            } else {
                $('#paymentsTable tbody').empty(); // Clear table if no shareholder is selected
            }
        });

        // Validate BlockedAmount and PaymentAuthorizationStatus
        $('#BlockedAmount').on('input', function () {
            var selectedPayment = $('input[name="selectedPayment"]:checked');
            var blockedAmountError = $('#blockedAmountError');
            var submitButton = $('button[type="submit"]');

            if (selectedPayment.length > 0) {
                var paidAmount = selectedPayment.data('paid-amount');
                var blockedAmount = parseFloat($(this).val());
                var authStatus = selectedPayment.data('auth-status');

                //Check if the payment is null


                // Check if payment is pending
                if (authStatus === "Pending") {
                    blockedAmountError.text("The payment is in the pending status.");
                    submitButton.prop('disabled', true); // Disable submit button
                    return;
                }

                // Validate that blocked amount does not exceed paid amount
                if (blockedAmount > paidAmount) {
                    blockedAmountError.text('Blocked amount cannot exceed the paid amount of ' + paidAmount);
                    submitButton.prop('disabled', true); // Disable submit button
                } else {
                    blockedAmountError.text('');
                    submitButton.prop('disabled', false); // Enable submit button if valid
                }
            } else {
                blockedAmountError.text("Please select a payment first.");
                submitButton.prop('disabled', true); // Disable submit button
            }
        });

        // Capture the selected payment on form submit
        $('form').submit(function () {
            var selectedPaymentId = $('input[name="selectedPayment"]:checked').val();
            $('#SelectedPayID').val(selectedPaymentId); // Set the selected PayID in the hidden field
        });
    });
</script>

<!-- script -->
<script>
    var upload = new FileUploadWithPreview('myFirstImage', {
        images: {
            baseImage: '~/assets/images/file-preview.png',
            backgroundImage: '',
        },
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
