@model Shareholder_Management_System.Models.Blocked

@{
    ViewBag.Title = "Details";
}

<div class="container flex justify-center">
    <div class="form-container" style="width: 100%; max-width: 800px; margin-top: 20px;">
        <div class="col-span-2">
            <div class="panel">
                <div class="flex items-center justify-between" style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                    <h5 class="text-lg font-semibold" style="padding:7px;">Releasing Blocked Payment Form</h5>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Left Column -->
                    <div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.BlockedAmount)</dt>
                            <dd>@Html.DisplayFor(model => model.BlockedAmount)</dd>
                        </div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.BlockingOrgan)</dt>
                            <dd>@Html.DisplayFor(model => model.BlockingOrgan)</dd>
                        </div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.DateBlocked)</dt>
                            <dd>@Html.DisplayFor(model => model.DateBlocked)</dd>
                        </div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.RefNum)</dt>
                            <dd>@Html.DisplayFor(model => model.RefNum)</dd>
                        </div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.Reason)</dt>
                            <dd>@Html.DisplayFor(model => model.Reason)</dd>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.BlockedAuthorizationStatus)</dt>
                            <dd>@Html.DisplayFor(model => model.BlockedAuthorizationStatus)</dd>
                        </div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.AuthorizationDate)</dt>
                            <dd>@Html.DisplayFor(model => model.AuthorizationDate)</dd>
                        </div>
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.Remark)</dt>
                            <dd>@Html.DisplayFor(model => model.Remark)</dd>
                        </div>
                        @*<div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.Document.DocName)</dt>
                            <dd>@Html.DisplayFor(model => model.Document.DocName)</dd>
                        </div>*@
                        <div class="form-group">
                            <dt>@Html.DisplayNameFor(model => model.Payment.PaymentMode)</dt>
                            <dd>@Html.DisplayFor(model => model.Payment.PaymentMode)</dd>
                        </div>
                    </div>
                </div>

                <!-- Release Amount Section -->
                <div class="form-group text-center">
                    @using (Html.BeginForm("ReleaseAmount", "Blockeds", FormMethod.Post))
                    {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.BlockID)

                    <div class="release-amount-container">
                        <label for="releaseAmount">Release Amount</label>
                        <input type="text" id="releaseAmount" name="releaseAmount" placeholder="Enter amount to release" class="form-input" />

                        <!-- Span for displaying error message -->
                        <span id="releaseAmountError" class="text-danger" style="display: none;"></span>

                        <!-- Disabled initially -->
                        <input type="submit" value="Release" class="btn btn-primary" id="releaseBtn" disabled />
                    </div>
                    }
                </div>

                <p class="text-center">
                    @Html.ActionLink("Back to List", "Index")
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Custom CSS -->
<style>
    .release-amount-container {
        margin: 20px auto;
        padding: 20px;
        width: 50%;
    }

        .release-amount-container label,
        .release-amount-container input,
        .release-amount-container input[type="submit"] {
            display: block;
            margin: 10px auto;
        }

        .release-amount-container input {
            margin-bottom: 15px;
        }
</style>

<!-- JavaScript for Client-side Validation -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#releaseAmount').on('input', function () {
            var releaseAmount = parseFloat($(this).val());
            var blockedAmount = @Model.BlockedAmount; // Assuming this value is available in the model

            // Check if releaseAmount is less than or equal to zero or greater than blockedAmount
            if (releaseAmount <= 0 || releaseAmount > blockedAmount || isNaN(releaseAmount)) {
                $('#releaseAmountError').text('Invalid release amount.').show();
                $('#releaseBtn').attr('disabled', true); // Disable the button
            } else {
                $('#releaseAmountError').hide(); // Hide the error message if valid
                $('#releaseBtn').attr('disabled', false); // Enable the button if valid
            }
        });
    });
</script>
