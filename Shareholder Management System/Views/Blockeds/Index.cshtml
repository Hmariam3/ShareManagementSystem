<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('multipleTable', () => ({
            datatable1: null,
            init() {
                this.datatable1 = new simpleDatatables.DataTable('#myTable1', {
                    data: {
                        headings: [
                            '',
                            'BlockID',
                            'ShareID',
                            'FullNameEng',
                            'PayID',
                            'BlockedAmount',
                            'BlockingOrgan',
                            'RefNum',
                            'Reason',
                            'BlockedAuthorizationStatus',
                            'Remark',
                      
                            'PaymentMode',
                            'UFullName',
                        
                            ''
                        ],
                       data: [
    @foreach (var item in Model)
    {
        <text>
        [
            `<a href="@Url.Action("Details", new { id = item.BlockID })" 
            style="display: inline-block; padding: 10px 20px; color: black; background-color: #1698de; border: none; border-radius: 5px; text-decoration: none;">
            Release
            </a>`,
            "@item.BlockID", // CertNum
            "@item.Shareholder.ShareID", // Shareholder.ShareID
            "@item.Shareholder.FullNameEng", // Shareholder.ShareID
            "@item.Payment.PayID", // FullNameEng
            "@item.BlockedAmount", // SHCategory
            "@item.BlockingOrgan", // BeginingSerial
            "@item.RefNum", // EndingSerial
            "@item.Reason", // PaymentIDs
            "@item.BlockedAuthorizationStatus", // DeliveryStatus
            "@item.Remark", // DeliveredBy
            @*"@item.Document.DocName", // CertNum*@
            "@item.Payment.PaymentMode", // Shareholder.ShareID
            "@item.User.FullName", // FullNameEng

            `<a href="@Url.Action("Edit", new { id = item.BlockID })">Edit</a> `
        ],
        </text>
    }
]

                    },
                    searchable: true,
                    perPage: 10,
                    columns: [
                        { select: 10, render: (data) => this.formatDate(data) }, // DeliveryDate column
                        { select: 11, render: (data) => this.formatDate(data) }, // CertGenerationDate column
                    ],
                    firstLast: true,
                    labels: {
                        perPage: '{select}',
                    },
                    layout: {
                        top: '{search}',
                        bottom: '{info}{select}{pager}',
                    },
                });
            },
            formatDate(date) {
                if (date) {
                    const dt = new Date(date);
                    const month = dt.getMonth() + 1 < 10 ? '0' + (dt.getMonth() + 1) : dt.getMonth() + 1;
                    const day = dt.getDate() < 10 ? '0' + dt.getDate() : dt.getDate();
                    return day + '/' + month + '/' + dt.getFullYear();
                }
                return '';
            }
        }));
    });
</script>



