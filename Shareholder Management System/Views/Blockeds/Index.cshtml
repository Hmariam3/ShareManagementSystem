@model IEnumerable<Shareholder_Management_System.Models.Blocked>


<script defer="" src="~/Script/JS/sweetalert.min.js"></script>
<script src="~/Scripts/JS/alpine-collaspe.min.js"></script>
<script src="~/Scripts/JS/alpine-persist.min.js"></script>
<script defer="" src="~/Scripts/JS/alpine-ui.min.js"></script>
<script defer="" src="~/Scripts/JS/alpine-focus.min.js"></script>
<script defer="" src="~/Scripts/JS/alpine.min.js"></script>
<script src="~/Scripts/JS/custom.js"></script>
<script src="~/Scripts/JS/simple-datatables.js"></script>
<script src="~/Scripts/JS/perfect-scrollbar.min.js"></script>
<script defer="" src="~/Scripts/JS/popper.min.js"></script>
<script defer="" src="~/Scripts/JS/tippy-bundle.umd.min.js"></script>
<script defer="" src="~/Scripts/JS/sweetalert.min.js"></script>

<div class="animate__animated p-6" :@class="[$store.app.animation]">
    <!-- start main content section -->
    <div x-data="multipleTable">
        <div class="panel mt-6">

            <table id="myTable1" class="table-auto w-full border-collapse border border-gray-300">
                <thead>
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Block Id</th>
                        <th>Shareholder Id</th>
                        <th>Shareholder Name</th>
                        <th>Payment Id</th>
                        <th>Blocked Amount</th>
                        <th>Blocking Organ</th>
                        <th>Reference Number</th>
                        <th>Reason</th>
                        <th>BlockedAuthorizationStatus</th>
                        <th>Remark</th>
                        <th>FullName</th>
                        <th>FullName</th>
                        <th>Date</th>

                    </tr>
                </thead>
            </table>

        </div>

    </div>
</div>


<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('multipleTable', () => ({
            datatable1: null,
            init() {
                this.datatable1 = new simpleDatatables.DataTable('#myTable1', {
                    data: {
                        headings: [
                            '',
                            '',
                            'BlockID',
                            'ShareID',
                            'FullNameEng',
                            'PayID',
                            'BlockedAmount',
                            'BlockingOrgan',
                            'RefNum',
                            'Reason',
                            'BlockedAuthorizationStatus',
                            'Remark',
                            'UFullName',
                            'U1FullName',
                            'Date Blocked'

                        ],
                       data: [
    @foreach (var item in Model)
    {
        <text>
        [
            `@if (item.BlockedAuthorizationStatus == "Pending"|| item.BlockedAuthorizationStatus == "Rejected")
            {
    <span style="display: inline-block; padding: 10px 20px; color: gray; background-color: #d3d3d3; border: none; border-radius: 5px; text-decoration: none; cursor: not-allowed;"
          title="Action not allowed for pending status">
        Release
    </span>
}
else
{
    <a href="@Url.Action("Details", new { id = item.BlockID })"
       style="display: inline-block; padding: 10px 20px; color: black; background-color: #1698de; border: none; border-radius: 5px; text-decoration: none;">
        Release
    </a>
}

`, `@if (item.BlockedAuthorizationStatus == "Approved")
{
    <span style="display: inline-block; padding: 10px 20px; color: gray; background-color: #d3d3d3; border: none; border-radius: 5px; text-decoration: none; cursor: not-allowed;"
          title="Action not allowed for Approved status">
        Edit
    </span>
}
else
{
    <a href="@Url.Action("Edit", new { id = item.BlockID })"
       style="display: inline-block; padding: 10px 20px; color: black; background-color: #1698de; border: none; border-radius: 5px; text-decoration: none;">
        Edit
    </a>
}

`,
            "@item.BlockID",
            "@item.Shareholder.ShareID",
            "@item.Shareholder.FullNameEng",
            "@item.Payment.PayID",
            "@item.BlockedAmount",
            "@item.BlockingOrgan",
            "@item.RefNum",
            "@item.Reason",
            "@item.BlockedAuthorizationStatus",
            "@item.Remark",
            "@item.User.FullName",
            "@item.User1.FullName",
            "@item.DateBlocked"

        ],
        </text>
    }
]

                    },
                    searchable: true,
                    perPage: 10,
                    columns: [
                        { select: 14, render: (data) => this.formatDate(data) }, // CertGenerationDate column
                    ],
                    firstLast: true,
                    labels: {
                        perPage: '{select}',
                    },
                    layout: {
                        top: '{search}',
                        bottom: '{info}{select}{pager}',
                    },
                });
            },
            formatDate(date) {
                if (date) {
                    const dt = new Date(date);
                    const month = dt.getMonth() + 1 < 10 ? '0' + (dt.getMonth() + 1) : dt.getMonth() + 1;
                    const day = dt.getDate() < 10 ? '0' + dt.getDate() : dt.getDate();
                    return day + '/' + month + '/' + dt.getFullYear();
                }
                return '';
            }
        }));
    });
</script>



