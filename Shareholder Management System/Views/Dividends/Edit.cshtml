﻿@model Shareholder_Management_System.Models.Dividend
<link rel="stylesheet" type="text/css" href="~/Content/CSS/select2.min.css">
<script src="~/Scripts/JS/select2.min.js"></script>
<script src="~/Scripts/JS/simple-datatables.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/additional-methods.min.js"></script>

<div class="animate__animated p-6" :class="[$store.app.animation]">
    <div class="flex items-center justify-between" style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
        <h5 class="text-lg font-semibold dark:text-white-light" style="padding:7px;">Edit Profit</h5>
    </div>
    <div class="pt-5">

        <div class="panel lg:col-span-2 pb-0 xl:col-span-1 pb-5">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <!-- Scrollable container with fixed height -->
                <div class="relative overflow-y-auto max-h-[360px] pr-3">
                    <div class="!mt-2">
                        @Html.LabelFor(model => model.Profit, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.Profit, new { htmlAttributes = new { @class = "form-input" } })
                        @Html.ValidationMessageFor(model => model.Profit, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="flex justify-end items-center mt-8">
                    <button type="submit" class="btn btn-primary ltr:ml-4 rtl:mr-4">Update</button>
                </div>

            }
        </div>
    </div>
</div>
