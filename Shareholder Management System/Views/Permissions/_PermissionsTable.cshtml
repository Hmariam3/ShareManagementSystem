@model IEnumerable<Shareholder_Management_System.Models.Permission>
<link rel="stylesheet" type="text/css" media="screen" href="~/css/userRole/css/all.min.css" />
<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
    <thead class="bg-gray-50 dark:bg-gray-800">
        <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                @Html.DisplayNameFor(model => model.role_name)
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                @Html.DisplayNameFor(model => model.perm_family)
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                @Html.DisplayNameFor(model => model.perm_name)
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                @Html.DisplayNameFor(model => model.perm_controller)
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                @Html.DisplayNameFor(model => model.perm_action)
            </th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
        </tr>
    </thead>
    <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-600">
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="px-4 py-4 text-center text-sm text-gray-500 dark:text-gray-200">No permissions found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr class="hover:bg-gray-700 dark:hover:bg-gray-700 transition-colors duration-200">
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@Html.DisplayFor(modelItem => item.role_name)</td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@Html.DisplayFor(modelItem => item.perm_family)</td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@Html.DisplayFor(modelItem => item.perm_name)</td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@Html.DisplayFor(modelItem => item.perm_controller)</td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">@Html.DisplayFor(modelItem => item.perm_action)</td>
                    <td class="px-4 py-4 whitespace-nowrap text-right text-sm">
                        <a href="@Url.Action("Edit", new { id = item.perm_id })" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 mr-3" title="Edit">
                            <i class="fas fa-edit mr-1"></i> Edit
                        </a>
                        <a href="@Url.Action("Details", new { id = item.perm_id })" class="text-green-600 hover:text-green-800 dark:text-green-400 dark:hover:text-green-300 mr-3" title="Details">
                            <i class="fas fa-info-circle mr-1"></i> Details
                        </a>
                        <a href="@Url.Action("Delete", new { id = item.perm_id })" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300" title="Delete">
                            <i class="fas fa-trash mr-1"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>