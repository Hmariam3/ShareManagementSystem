
@model object

@{
    ViewBag.Title = "Upload Permissions";
}

<link rel="stylesheet" type="text/css" media="screen" href="~/css/userRole/css/all.min.css" />
<link href="~/css/tailwind.min.css" rel="stylesheet" type="text/css" media="screen" />
<script src="~/js/jquery-3.6.0.min.js"></script>

<div class="bg-white shadow-md rounded-lg overflow-hidden panel">
    <div class="p-8">
        <h2 class="text-3xl font-bold text-dark dark:text-white-light mb-6">Upload Permissions</h2>

        @if (TempData["Message"] != null)
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
                @TempData["Message"]
            </div>
        }

        @using (Html.BeginForm("Upload", "Permissions", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-red-500 mb-4" })

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="form-group">
                    <label for="role_name" class="block dark:text-white-light text-sm font-semibold mb-2">Role</label>
                    @Html.DropDownList("role_name", (SelectList)ViewBag.RoleName, "Select Role", new { @class = "form-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" })
                    @Html.ValidationMessage("role_name", "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group">
                    <label for="perm_family" class="block dark:text-white-light text-sm font-semibold mb-2">Permission Family</label>
                    @Html.DropDownList("perm_family", (SelectList)ViewBag.PermFamily, "Select Permission Family", new { @class = "form-select mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" })
                    @Html.ValidationMessage("perm_family", "", new { @class = "text-red-500 text-sm" })
                </div>

                <div class="form-group col-span-2">
                    <label for="file" class="block dark:text-white-light text-sm font-semibold mb-2">Excel File</label>
                    <input type="file" name="file" accept=".xlsx" class="form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#00ADEF] focus:ring focus:ring-[#00ADEF] focus:ring-opacity-50" />
                    <p class="text-sm text-gray-500 mt-1">Upload an .xlsx file with columns: Permission Name, Controller, Action</p>
                    <a href="@Url.Action("DownloadTemplate")" class="text-blue-500 hover:text-blue-800 mt-2 inline-block">Download Template</a>
                </div>
            </div>

            <div class="flex justify-center mt-8">
                <button type="submit" class="btn btn-primary text-white hover:bg-blue-800 px-6 py-2 rounded-md">
                    <i class="fas fa-upload mr-2"></i> Upload
                </button>
            </div>
        }

        <div class="flex justify-center mt-4">
            <a href="@Url.Action("Index")" class="flex text-sm text-blue-500 hover:text-blue-800 font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>Back to List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}