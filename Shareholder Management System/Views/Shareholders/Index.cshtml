 ﻿@model Shareholder_Management_System.Models.Shareholder

@{
    ViewBag.Title = "Details";
}

@{
    var userRole = Session["Roles"]?.ToString();
}

<script src="~/Scripts/JS/simple-datatables.js"></script>
<link rel="stylesheet" type="text/css" href="~/Content/CSS/select2.min.css">
<script src="~/Scripts/JS/select2.min.js"></script>

<style>
    /* Horizontal Menu Styles */
    .horizontal-menu {
        display: flex;
        flex-wrap: wrap;
        padding: 1rem;
        border-bottom: 1px solid #e0e6ed;
    }

        .horizontal-menu button {
            display: flex;
            align-items: center;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #506690;
            background: transparent;
            border-radius: 0.375rem;
            transition: all 0.3s ease;
        }

            .horizontal-menu button:hover {
                background: #f1f3f5;
                color: #3b82f6;
            }

            .horizontal-menu button.active {
                background: #f1f3f5;
                color: #fff;
                font-weight: 600;
            }

            .horizontal-menu button svg {
                width: 1.25rem;
                height: 1.25rem;
                margin-right: 0.5rem;
            }

        .horizontal-menu .tag-label {
            color: #6b7280;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.5rem 1rem;
        }
    /* Open Button Styles */
    .open-button {
        background: #3b82f6;
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        text-align: center;
        font-weight: 500;
        transition: background 0.3s ease;
    }

        .open-button:hover {
            background: #2563eb;
        }
    /* Mobile Menu Styles */
    .mobile-menu {
        display: none;
    }

    @@media (max-width: 768px) {
        .horizontal-menu {
            display: none;
        }

            .horizontal-menu.active {
                display: flex;
                flex-direction: column;
                position: absolute;
                top: 60px;
                left: 0;
                right: 0;
                z-index: 50;
                padding: 1rem;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }

        .mobile-menu {
            display: block;
        }
    }
</style>

