        <form method="get" action="@Url.Action("Index", "Shareholders")" class="!mt-6" id="filterForm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 !mt-6">

                <div class="!mt-6">
                    <label for="shid">Via FullName (Eng) OR Shareholder ID </label>

                    <select name="shId" id="searchable-select" class="form-select">
                        <option value="">Select a Shareholder</option>
                        @if (ViewBag.SelectedShId != null)
                        {
                            <option value="@ViewBag.SelectedShId" selected>@ViewBag.SelectedShName</option>
                        }
                    </select>
                </div>

