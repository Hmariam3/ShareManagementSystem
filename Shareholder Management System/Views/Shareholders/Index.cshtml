        type: null,
        editShDocumentModal: false,


        tabChanged(type) {
            this.selectedTab = type;
            this.isShowTaskMenu = false;
        },

        // Handle edit document button click
        editShDocument(ShID, type) {
            this.shID = ShID;
            this.type = type;
            this.editShDocumentModal = true;
        },

        // Handle form submission
       submitShDocument() {
            const form = document.getElementById('shForm');
            const formData = new FormData(form);
            formData.append('type', this.type);
            console.log(this.type);

            fetch('@Url.Action("UpdateShDocument", "Shareholders")', {
                method: 'POST',
                body: formData,
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showMessage(data.message, 'success');

                    this.blockShModal = false;
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                } else {
                    showMessage(data.message, 'error');

                }
            })
                .catch(error => {
                    showMessage(data.message, 'error');

            });
        },

        // Show toast message (updated for SweetAlert2 v10)
        showMessage(msg = '', type = 'success') {
            Swal.fire({
                toast: true,
                position: 'top',
                icon: type,
                title: msg,
                showConfirmButton: false,
                timer: 3000,
                padding: '10px 20px',
            });
        },
