                                                var data = Model.Status;

                                                if (data == "Active")
                                                {
                                                    styleClass = "bg-success";
                                                    statusText = "Active";
                                                }
                                                else if (data == "New")
                                                {
                                                    styleClass = "bg-primary";
                                                    statusText = "New Shareholder";
                                                }
                                                else if (data == "Updated")
                                                {
                                                    styleClass = "bg-secondary";
                                                    statusText = "Updated shareholder";
                                                }
                                                else if (data == "Document-Updated")
                                                {
                                                    styleClass = "bg-secondary";
                                                    statusText = "Shareholder Document-Updated";
                                                }
                                                else if (data == "Blocked")
                                                {
                                                    styleClass = "bg-danger";
                                                    statusText = "Shareholder Blocked";
                                                }
                                                else if (data == "UnBlocked")
                                                {
                                                    styleClass = "bg-danger";
