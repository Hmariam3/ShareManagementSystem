                    },
                });
                let cols = this.datatable1.columns();
                cols.hide(this.hideCols);
                cols.show(this.showCols);
            },

            blockSh(ShID) {
                this.shID = ShID;
                this.blockShModal = true;
            },
            unBlockSh(ShID) {
                this.shID = ShID;
                this.unBlockShModal = true;
            },
            editShDocument(ShID, type) {
                this.shID = ShID;
                this.type = type;
                this.editShDocumentModal = true;
            },
            formatStatus(data) {
                let styleClass = '';
                let statusText = '';

                if (data == 'Active') {
                    styleClass = 'badge-outline-success';
                    statusText = 'Active'; // Display 'Active' if true
                } else if (data == 'New') {
                    styleClass = 'badge-outline-primary';
                    statusText = 'New'; // Display 'Active' if true
                } else if (data == 'Updated') {
                    styleClass = 'badge-outline-secondary';
                    statusText = 'Updated'; // Display 'Active' if true
                } else if (data == 'Document-Updated') {
                    styleClass = 'badge-outline-secondary';
                    statusText = 'Document-Updated'; // Display 'Active' if true
                } else if (data == 'Blocked') {
                    styleClass = 'badge-outline-danger';
                    statusText = 'Blocked'; // Display 'Inactive' if false
                } else if (data == 'Rejected') {
                    styleClass = 'badge-outline-danger';
                    statusText = 'Rejected'; // Display 'Inactive' if false
                }else if (data == 'UnBlocked') {
                    styleClass = 'badge-outline-warning';
                    statusText = 'UnBlocked'; // Display 'Inactive' if false
                }

                return '<span class="badge ' + styleClass + '">' + statusText + '</span>';
            },

            formatAuthorizationStatus(data) {
                let styleClass = '';
                if (data == 'Approved') {
                    styleClass = 'bg-success ';
                } else if (data == 'Pending') {
                    styleClass = 'bg-warning';
                    data = 'Waiting-Approval';
                } else if (data == 'Rejected') { // This should be else if instead of else
                    styleClass = 'bg-danger';
                } else {
                    styleClass = ''; // Default class if none of the conditions are met
                }
                return '<span class="badge ' + styleClass + '">' + data + '</span>';

            },

            submitShDocument() {
                const form = document.getElementById('shForm');
                const formData = new FormData(form);
                formData.append('type', this.type);
                console.log(this.type);

                fetch('@Url.Action("UpdateShDocument", "Shareholders")', {
                    method: 'POST',
                    body: formData,
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showMessage(data.message, 'success');
                        
                        this.blockShModal = false;
                        setTimeout(() => {
                            location.reload();
                        }, 2000);
                    } else {
                        showMessage(data.message, 'error');
                        
                    }
                })
                    .catch(error => {
                        showMessage(data.message, 'error');
                        
                });
            },
            submitShBlock() {
                const form = document.getElementById('shForm1');
                const formData = new FormData(form);
                console.log(formData);
                fetch('@Url.Action("BlockSh", "Shareholders")', {
                    method: 'POST',
                    body: formData,
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showMessage(data.message, 'success');

                        this.blockShModal = false;
                        setTimeout(() => {
                            location.reload();
                        }, 2000);
                    } else {
                        showMessage(data.message, 'error');

                    }
                })
                    .catch(error => {
                        showMessage(data.message, 'error');

                });
            },
            submitShUnBlock() {
                const form = document.getElementById('shForm2');
                const formData = new FormData(form);
                fetch('@Url.Action("UnBlockSh", "Shareholders")', {
                    method: 'POST',
                    body: formData,
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showMessage(data.message, 'success');

                        this.blockShModal = false;
                        setTimeout(() => {
                            location.reload();
                        }, 2000);
                    } else {
                        showMessage(data.message, 'error');

                    }
                })
                    .catch(error => {
                        showMessage(data.message, 'error');

                });
            },

            createDownloadButton(documentId) {
               // Generate the download URL using Razor's Url.Action
               console.log(documentId);
                if (documentId) {
                    let downloadUrl = '@Url.Action("DownloadDocument", "Documents", new { id = "__documentId__" })';
                    downloadUrl = downloadUrl.replace("__documentId__", documentId);
                    // Trigger the file download by navigating to the generated URL
                    window.location.href = downloadUrl;
                } else {
                    alert("Document ID is missing!");
                }
            },
            openDocumentInNewTab(documentId) {
                console.log(documentId);
                if (documentId) {
                    // Make an AJAX request to fetch the document path
                        fetch('@Url.Action("GetDocumentPath", "Documents", new { id = "__id__" })'.replace('__id__', documentId))
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Open the document in a new tab using the retrieved file path
                                const documentUrl = window.location.origin + data.filePath; // Make sure it's a full URL
                                console.log(documentUrl);
                                console.log("abel");
                                window.open(documentUrl, '_blank', 'width=800,height=600');
                            } else {
                                alert(data.message || "Failed to retrieve document path.");
                            }
                        })
                        .catch(error => {
                            console.log("Error fetching document path:", error);
                            alert("An error occurred while trying to fetch the document.");
                        });
                } else {
                    alert("Document ID is missing!");
                }
            },
            formatDate(date) {
                if (date) {
                    const dt = new Date(date);
                    const month = dt.getMonth() + 1 < 10 ? '0' + (dt.getMonth() + 1) : dt.getMonth() + 1;
                    const day = dt.getDate() < 10 ? '0' + dt.getDate() : dt.getDate();
                    return day + '/' + month + '/' + dt.getFullYear();
                }
                return '';
            },
        }));
    });

    // Success message function (Toast)
    async function showMessage(msg = '', type = 'success') {
        const toast = window.Swal.mixin({
            toast: true,
            position: 'top',
            showConfirmButton: false,
            timer: 3000,
        });
        toast.fire({
            icon: type,
            title: msg,
            padding: '10px 20px',
        });
    }

</script>


