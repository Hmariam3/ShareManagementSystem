    Alpine.data('document', () => ({
            isShowMenu: false,
            documents: [
                @foreach (var item in Model.Documents)
                {
                    <text>
                        {
                            id: "@item.DocID",
                            title: "@item.DocName",
                            description: "@(item.DocType ?? "No description available")",
                            category:
                                      "@item.DocType" === "ShareholderID" ? "shareholder" :
                                      "@item.DocType" === "ShareholderAgreement" ? "shareholder" :
                                      "@item.DocType" === "Proxy Document" ? "ProxyID" :
                                      "@item.DocType" === "Proxy Document" ? "DeligationLetter" :
                                      "@item.DocType" === "Payment Slip" ? "payment" :
                                      "@item.DocType" === "Blocking Document" ? "blocking" :
                                      "@item.DocType" === "Transfer Document" ? "transfer" :
                                      "@item.DocType".toLowerCase(),
                            docType: "@item.DocType",
                            shareid: "@(item.Shareholder != null ? item.Shareholder.ShareID : Model.ShareID)",
                            authorizationStatus: "@(item.DocAuthorizationStatus ?? "N/A")",
                            createdBy: "@(item.User != null ? item.User.FullName : "N/A")",
                            createdDate: "@(item.CreatedDate.HasValue ? item.CreatedDate.Value.ToString("yyyy-MM-dd") : "")",
                            filePath: null,
                            fileType: null,
                            previewError: null
                        },
                    </text>
                }
            ],
            filteredDocuments: [],
            selectedDocTab: 'all',
            init() {
                this.searchDocuments();
                this.fetchDocumentPreviews();
            },
            fetchDocumentPreviews() {
                console.log(`Fetching previews for ${this.documents.length} documents`);
                this.documents.forEach((doc, index) => {
                    if (doc.id) {
                        console.log(`Fetching path for docId: ${doc.id}`);
                        fetch('@Url.Action("GetDocumentPath", "Documents")' + '?id=' + encodeURIComponent(doc.id), {
                            method: 'GET',
                            headers: {
                                'Accept': 'application/json'
                            }
                        })
                            .then(response => {
                                console.log(`Response status for docId ${doc.id}: ${response.status}`);
                                if (!response.ok) {
                                    throw new Error(`Network response was not ok: ${response.statusText}`);
                                }
                                return response.json();
                            })
                            .then(data => {
                                console.log(`Response data for docId ${doc.id}:`, data);
                                const updatedDocuments = [...this.documents];
                                if (data.success && data.filePath) {
                                    const filePath = window.location.origin + data.filePath;
                                    const fileType = data.filePath.match(/\.(pdf|png|jpeg|jpg|gif|bmp)$/i) ?
                                        data.filePath.match(/\.pdf$/i) ? 'pdf' : 'image' : null;
                                    console.log(`File path: ${filePath}, File type: ${fileType}`);
                                    updatedDocuments[index] = {
                                        ...doc,
                                        filePath,
                                        fileType,
                                        previewError: fileType ? null : 'Unsupported file type'
                                    };
                                } else {
                                    const errorMsg = data.message || 'Failed to retrieve document path.';
                                    console.warn(`Error for docId ${doc.id}: ${errorMsg}`);
                                    updatedDocuments[index] = {
                                        ...doc,
                                        filePath: null,
                                        fileType: null,
                                        previewError: errorMsg
                                    };
                                    this.showMessage(errorMsg, 'error');
                                }
                                console.log(`Updated document at index ${index}:`, updatedDocuments[index]);
                                this.documents = updatedDocuments;
                                console.log(`Documents array after update:`, this.documents);
                            })
                            .catch(error => {
                                console.error(`Fetch error for docId ${doc.id}:`, error);
                                const updatedDocuments = [...this.documents];
                                updatedDocuments[index] = {
                                    ...doc,
                                    filePath: null,
                                    fileType: null,
                                    previewError: `Error fetching document: ${error.message}`
                                };
                                this.documents = updatedDocuments;
                                console.log(`Documents array after error:`, this.documents);
                                this.showMessage(`Error fetching document: ${error.message}`, 'error');
                            });
                    } else {
                        console.warn(`No docId for document at index ${index}`);
                        const updatedDocuments = [...this.documents];
                        updatedDocuments[index] = {
                            ...doc,
                            previewError: 'Document ID missing'
                        };
                        this.documents = updatedDocuments;
                        console.log(`Documents array after missing ID:`, this.documents);
                    }
                });
            },
            showMessage(msg = '', type = 'success') {
                const toast = Swal.mixin({
                    toast: true,
                    position: 'top',
                    showConfirmButton: false,
                    timer: 3000,
                });
                toast.fire({
                    icon: type,
                    title: msg,
                    padding: '10px 20px',
                });
            },
            searchDocuments() {
                if (this.selectedDocTab === 'all') {
                    this.filteredDocuments = this.documents;
                } else {
                    this.filteredDocuments = this.documents.filter((d) => d.category === this.selectedDocTab);
                }
            },
            tabChangedDoc(category) {
                this.selectedDocTab = category;
                this.searchDocuments();
                this.isShowMenu = false;
            },
            createDownloadButton(documentId) {
                console.log(`Creating download for docId: ${documentId}`);
                if (documentId) {
                    let downloadUrl = '@Url.Action("DownloadDocument", "Documents", new { id = "__documentId__" })';
                    downloadUrl = downloadUrl.replace("__documentId__", documentId);
                    window.location.href = downloadUrl;
                } else {
                    this.showMessage('Document ID is missing!', 'error');
                }
            },
            openDocumentInNewTab(documentId) {
                console.log(`Opening document for docId: ${documentId}`);
                if (documentId) {
                    fetch('@Url.Action("GetDocumentPath", "Documents", new { id = "__id__" })'.replace('__id__', documentId))
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                const documentUrl = window.location.origin + data.filePath;
                                console.log(`Opening URL: ${documentUrl}`);
                                const newWindow = window.open(documentUrl, '_blank', 'width=800,height=600');
                                if (!newWindow) {
                                    this.showMessage('Pop-up blocked. Please allow pop-ups to view the document.', 'error');
                                }
                            } else {
                                this.showMessage(data.message || 'Failed to retrieve document path.', 'error');
                            }
                        })
                        .catch(error => {
                            console.error('Error fetching document path:', error);
                            this.showMessage('An error occurred while trying to fetch the document.', 'error');
                        });
                } else {
                    this.showMessage('Document ID is missing!', 'error');
                }
            }
        }));
    });

    // Success message function (Toast)
    async function showMessage(msg = '', type = 'success') {
        const toast = window.Swal.mixin({
            toast: true,
            position: 'top',
            showConfirmButton: false,
            timer: 3000,
        });
        toast.fire({
            icon: type,
            title: msg,
            padding: '10px 20px',
        });
    }
</script>