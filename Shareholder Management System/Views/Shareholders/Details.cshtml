                                                    styleClass = "badge-outline-primary";
                                                    statusText = "New";
                                                }
                                                else if (data == "Updated")
                                                {
                                                    styleClass = "badge-outline-secondary";
                                                    statusText = "Updated";
                                                }
                                                else if (data == "Document-Updated")
                                                {
                                                    styleClass = "badge-outline-secondary";
