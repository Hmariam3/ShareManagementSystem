                        </a>
                    </li>
                    <li>
                        <a href="javascript:;"
                           class="-mb-[1px] flex items-center border border-transparent p-3.5 py-2 hover:text-danger"
                           :class=" {'!border-white-light !border-b-white text-danger dark:!border-[#191e3a] dark:!border-b-black' : tab==='transfer' }"
                           @@click="tab = 'transfer'">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                                <path d="M16.1007 13.359L16.5562 12.9062C17.1858 12.2801 18.1672 12.1515 18.9728 12.5894L20.8833 13.628C22.1102 14.2949 22.3806 15.9295 21.4217 16.883L20.0011 18.2954C19.6399 18.6546 19.1917 18.9171 18.6763 18.9651M4.00289 5.74561C3.96765 5.12559 4.25823 4.56668 4.69185 4.13552L6.26145 2.57483C7.13596 1.70529 8.61028 1.83992 9.37326 2.85908L10.6342 4.54348C11.2507 5.36691 11.1841 6.49484 10.4775 7.19738L10.1907 7.48257"
                                      stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5"
                                      d="M18.6763 18.9651C17.0469 19.117 13.0622 18.9492 8.8154 14.7266C4.81076 10.7447 4.09308 7.33182 4.00293 5.74561"
                                      stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5"
                                      d="M16.1007 13.3589C16.1007 13.3589 15.0181 14.4353 12.0631 11.4971C9.10807 8.55886 10.1907 7.48242 10.1907 7.48242"
                                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                            </svg>
                            Transfers <span class="badge my-0 bg-danger text-white ltr:ml-4 rtl:mr-4">@Model.ShareTransfers.Count()</span>
                        </a>
                    </li>
                    <li>
                        <a href="javascript:;"
                           class="-mb-[1px] flex items-center border border-transparent p-3.5 py-2 hover:text-danger"
                           :class=" {'!border-white-light !border-b-white text-danger dark:!border-[#191e3a] dark:!border-b-black' : tab==='block' }"
                           @@click="tab = 'block'">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                                <path d="M16.1007 13.359L16.5562 12.9062C17.1858 12.2801 18.1672 12.1515 18.9728 12.5894L20.8833 13.628C22.1102 14.2949 22.3806 15.9295 21.4217 16.883L20.0011 18.2954C19.6399 18.6546 19.1917 18.9171 18.6763 18.9651M4.00289 5.74561C3.96765 5.12559 4.25823 4.56668 4.69185 4.13552L6.26145 2.57483C7.13596 1.70529 8.61028 1.83992 9.37326 2.85908L10.6342 4.54348C11.2507 5.36691 11.1841 6.49484 10.4775 7.19738L10.1907 7.48257"
                                      stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5"
                                      d="M18.6763 18.9651C17.0469 19.117 13.0622 18.9492 8.8154 14.7266C4.81076 10.7447 4.09308 7.33182 4.00293 5.74561"
                                      stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5"
                                      d="M16.1007 13.3589C16.1007 13.3589 15.0181 14.4353 12.0631 11.4971C9.10807 8.55886 10.1907 7.48242 10.1907 7.48242"
                                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                            </svg>
                            Blocks <span class="badge my-0 bg-danger text-white ltr:ml-4 rtl:mr-4">@Model.Blockeds.Count()</span>
                        </a>
                    </li>

                    <li>
                        <a href="javascript:;"
                           class="-mb-[1px] flex items-center border border-transparent p-3.5 py-2 hover:text-danger"
                           :class=" {'!border-white-light !border-b-white text-danger dark:!border-[#191e3a] dark:!border-b-black' : tab==='certificate' }"
                           @@click="tab = 'certificate'">
                            <svg width="24" height="24" viewbox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                                <path d="M16.1007 13.359L16.5562 12.9062C17.1858 12.2801 18.1672 12.1515 18.9728 12.5894L20.8833 13.628C22.1102 14.2949 22.3806 15.9295 21.4217 16.883L20.0011 18.2954C19.6399 18.6546 19.1917 18.9171 18.6763 18.9651M4.00289 5.74561C3.96765 5.12559 4.25823 4.56668 4.69185 4.13552L6.26145 2.57483C7.13596 1.70529 8.61028 1.83992 9.37326 2.85908L10.6342 4.54348C11.2507 5.36691 11.1841 6.49484 10.4775 7.19738L10.1907 7.48257"
                                      stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5"
                                      d="M18.6763 18.9651C17.0469 19.117 13.0622 18.9492 8.8154 14.7266C4.81076 10.7447 4.09308 7.33182 4.00293 5.74561"
                                      stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5"
                                      d="M16.1007 13.3589C16.1007 13.3589 15.0181 14.4353 12.0631 11.4971C9.10807 8.55886 10.1907 7.48242 10.1907 7.48242"
                                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                            </svg>
                            Certificates <span class="badge my-0 bg-danger text-white ltr:ml-4 rtl:mr-4">@Model.Certificates.Count()</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="flex-1 border border-t-0 border-white-light p-4 text-sm dark:border-[#191e3a]">
                <template x-if="tab === 'shareholder'">
                    <div class="active">
                        <div x-data="shareholder">
                            <div class="flex flex-wrap items-center justify-between gap-4">
                                <h2 class="text-xl"></h2>
                                <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:items-center sm:gap-3">
                                    <div class="flex gap-3">
                                        <div>
                                            <button type="button" class="btn btn-outline-primary p-2"
                                                    :class="{ 'bg-primary text-white': displayType === 'list' }"
                                                    @@click="setDisplayType('list')">
                                                <svg width="24" height="24" viewbox="0 0 24 24" fill="none"
                                                     xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                                    <path d="M2 5.5L3.21429 7L7.5 3" stroke="currentColor"
                                                          stroke-width="1.5" stroke-linecap="round"
                                                          stroke-linejoin="round"></path>
                                                    <path opacity="0.5" d="M2 12.5L3.21429 14L7.5 10"
                                                          stroke="currentColor" stroke-width="1.5"
                                                          stroke-linecap="round" stroke-linejoin="round">
                                                    </path>
                                                    <path d="M2 19.5L3.21429 21L7.5 17"
                                                          stroke="currentColor" stroke-width="1.5"
                                                          stroke-linecap="round" stroke-linejoin="round">
                                                    </path>
                                                    <path d="M22 19L12 19" stroke="currentColor"
                                                          stroke-width="1.5" stroke-linecap="round">
                                                    </path>
                                                    <path opacity="0.5" d="M22 12L12 12"
                                                          stroke="currentColor" stroke-width="1.5"
                                                          stroke-linecap="round"></path>
                                                    <path d="M22 5L12 5" stroke="currentColor"
                                                          stroke-width="1.5" stroke-linecap="round"></path>
                                                </svg>
                                            </button>
                                        </div>

                                        <div>
                                            <button type="button" class="btn btn-outline-primary p-2"
                                                    :class="{ 'bg-primary text-white': displayType === 'grid' }"
                                                    @@click="setDisplayType('grid')">
                                                <svg width="24" height="24" viewbox="0 0 24 24" fill="none"
                                                     xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                                    <path opacity="0.5"
                                                          d="M2.5 6.5C2.5 4.61438 2.5 3.67157 3.08579 3.08579C3.67157 2.5 4.61438 2.5 6.5 2.5C8.38562 2.5 9.32843 2.5 9.91421 3.08579C10.5 3.67157 10.5 4.61438 10.5 6.5C10.5 8.38562 10.5 9.32843 9.91421 9.91421C9.32843 10.5 8.38562 10.5 6.5 10.5C4.61438 10.5 3.67157 10.5 3.08579 9.91421C2.5 9.32843 2.5 8.38562 2.5 6.5Z"
                                                          stroke="currentColor" stroke-width="1.5"></path>
                                                    <path opacity="0.5"
                                                          d="M13.5 17.5C13.5 15.6144 13.5 14.6716 14.0858 14.0858C14.6716 13.5 15.6144 13.5 17.5 13.5C19.3856 13.5 20.3284 13.5 20.9142 14.0858C21.5 14.6716 21.5 15.6144 21.5 17.5C21.5 19.3856 21.5 20.3284 20.9142 20.9142C20.3284 21.5 19.3856 21.5 17.5 21.5C15.6144 21.5 14.6716 21.5 14.0858 20.9142C13.5 20.3284 13.5 19.3856 13.5 17.5Z"
                                                          stroke="currentColor" stroke-width="1.5"></path>
                                                    <path d="M2.5 17.5C2.5 15.6144 2.5 14.6716 3.08579 14.0858C3.67157 13.5 4.61438 13.5 6.5 13.5C8.38562 13.5 9.32843 13.5 9.91421 14.0858C10.5 14.6716 10.5 15.6144 10.5 17.5C10.5 19.3856 10.5 20.3284 9.91421 20.9142C9.32843 21.5 8.38562 21.5 6.5 21.5C4.61438 21.5 3.67157 21.5 3.08579 20.9142C2.5 20.3284 2.5 19.3856 2.5 17.5Z"
                                                          stroke="currentColor" stroke-width="1.5"></path>
                                                    <path d="M13.5 6.5C13.5 4.61438 13.5 3.67157 14.0858 3.08579C14.6716 2.5 15.6144 2.5 17.5 2.5C19.3856 2.5 20.3284 2.5 20.9142 3.08579C21.5 3.67157 21.5 4.61438 21.5 6.5C21.5 8.38562 21.5 9.32843 20.9142 9.91421C20.3284 10.5 19.3856 10.5 17.5 10.5C15.6144 10.5 14.6716 10.5 14.0858 9.91421C13.5 9.32843 13.5 8.38562 13.5 6.5Z"
                                                          stroke="currentColor" stroke-width="1.5"></path>
                                                </svg>
                                            </button>
                                        </div>

                                    </div>

                                    <div class="relative">
                                        <input type="text" placeholder="Search Shareholders"
                                               class="peer form-input py-2 ltr:pr-11 rtl:pl-11"
                                               x-model="searchUser" @@keyup="searchShareholders">
                                        <div class="absolute top-1/2 -translate-y-1/2 peer-focus:text-primary ltr:right-[11px] rtl:left-[11px]">
                                            <svg class="mx-auto" width="16" height="16" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <circle cx="11.5" cy="11.5" r="9.5" stroke="currentColor" stroke-width="1.5" opacity="0.5"></circle>
                                                <path d="M18.5 18.5L22 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="panel mt-5 overflow-hidden border-0 p-0">
                                <template x-if="displayType === 'list'">
                                    <div class="p-6 overflow-x-auto" style="max-height: 600px; overflow-y: auto;">
                                        <div class="table-responsive sticky-column sticky-header">

                                            <table id="shareholderTable" class="whitespace-nowrap table-striped table-hover table-bordered table-compact">
                                                <thead>
                                                    <tr>

                                                        <th>Share ID</th>
                                                        <th>Full Name (Eng)</th>
                                                        <th>Full Name (Afan Oromo)</th>
                                                        <th>Full Name (Amharic)</th>
                                                        <th>Status</th>
                                                        <th>Nationality</th>
                                                        <th>SH Category</th>
                                                        <th>TIN Number</th>
                                                        <th>Account Number</th>
                                                        <th>Region</th>
                                                        <th>Zone</th>
                                                        <th>City</th>
                                                        <th>Subcity</th>
                                                        <th>Woreda</th>
                                                        <th>Kebele</th>
                                                        <th>House No</th>
                                                        <th>PoBox</th>
                                                        <th>Phone No</th>
                                                        <th>Phone No2</th>
                                                        <th>Phone No3</th>
                                                        <th>TeleHome</th>
                                                        <th>TeleWork</th>
                                                        <th>Email</th>
                                                        <th>Email2</th>
                                                        <th>Email3</th>
                                                        <th>Created Date</th>
                                                        <th>Remark</th>
                                                        <th>Branch Name</th>
                                                        <th>Created By</th>
                                                        <th class="!text-center">Action</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <!-- Loop through filteredShareholders -->
                                                    <template x-for="shareholder in filteredShareholders" :key="shareholder.id">
                                                        <tr>

                                                            <td x-text="shareholder.shareid"></td>
                                                            <td x-text="shareholder.fullNameEng"></td>
                                                            <td x-text="shareholder.fullNameAfanOromo"></td>
                                                            <td x-text="shareholder.fullNameAmharic"></td>
                                                            <td>
                                                                <span x-text="shareholder.status === 'Active' ? 'Active' :
                                                                        shareholder.status === 'New' ? 'New' :
                                                                        shareholder.status === 'Updated' ? 'Updated' :
                                                                        shareholder.status === 'Document-Updated' ? 'Document Updated' :
                                                                        shareholder.status === 'Blocked' ? 'Blocked' :
                                                                        shareholder.status === 'Rejected' ? 'Rejected' :
                                                                        shareholder.status === 'UnBlocked' ? 'Unblocked' : 'Unknown Status'"
                                                                      :class="
                                                                        shareholder.status === 'Active' ? 'badge badge-outline-success' :
                                                                        shareholder.status === 'New' ? 'badge badge-outline-primary' :
                                                                        shareholder.status === 'Updated' || shareholder.status === 'Document-Updated' ? 'badge badge-outline-secondary' :
                                                                        shareholder.status === 'Blocked' || shareholder.status === 'Rejected' ? 'badge badge-outline-danger' :
                                                                        shareholder.status === 'UnBlocked' ? 'badge badge-outline-warning' : 'badge badge-outline-default'">

                                                                </span>
                                                            </td>
                                                            <td x-text="shareholder.nationality"></td>
                                                            <td x-text="shareholder.shCategory"></td>
                                                            <td x-text="shareholder.tinNum"></td>
                                                            <td x-text="shareholder.accountNumber"></td>
                                                            <td x-text="shareholder.region"></td>
                                                            <td x-text="shareholder.zone"></td>
                                                            <td x-text="shareholder.city"></td>
                                                            <td x-text="shareholder.subcity"></td>
                                                            <td x-text="shareholder.woreda"></td>
                                                            <td x-text="shareholder.kebele"></td>
                                                            <td x-text="shareholder.houseNo"></td>
                                                            <td x-text="shareholder.poBox"></td>
                                                            <td x-text="shareholder.phoneNo"></td>
                                                            <td x-text="shareholder.phoneNo2"></td>
