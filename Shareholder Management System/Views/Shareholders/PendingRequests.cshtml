<script>
    async function showAlert(action, event) {
        // Prevent the default link navigation if action is delete
        if (action === 'delete') {
            event.preventDefault();
        }

        // Set alert text based on action type
        let actionText = action === 'delete' ? 'delete this transfer' : '';
        let confirmText = action === 'delete' ? 'Delete' : '';

        // Display confirmation dialog
        new window.Swal({
            icon: 'warning',
            title: 'Are you sure?',
            text: `You are about to ${actionText}. This action cannot be undone!`,
            showCancelButton: true,
            confirmButtonText: confirmText,
            cancelButtonText: 'Cancel',
            padding: '2em',
        }).then((result) => {
            if (result.isConfirmed) {
                // Navigate to the delete link if confirmed
                if (action === 'delete') {
                    window.location.href = document.getElementById('deleteTransfer').href;
                }
            }
        });
    }
</script>

