<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('shareholder', () => ({
            displayType: 'list',
            searchUser: '',
            filteredShareholders: [], // Holds the filtered data for display
            selectAll: false, // Keeps track of the "Select All" checkbox
            selectedShareholders: [], // Array to hold the IDs of selected shareholders
            rejectModalOpen: false, // Controls the rejection modal visibility
            rejectionReason: '',
            selectedShareholderId: null, // Stores the selected shareholder ID

            shareholderList: [
                @foreach (var item in Model.Shareholders)
                {
                    <text>
                    {
                        id: @item.ShID,
                        shareid: "@item.ShareID",
                        shDocument: @item.ShDocument,
                        fullNameEng: "@item.FullNameEng",
                        fullNameAfanOromo: "@item.FullNameAfanOromo",
                        fullNameAmharic: "@item.FullNameAmharic",
                        status: "@item.Status",
                        nationality: "@item.Nationality",
                        shCategory: "@item.SHCategory",
                        tinNum: "@item.TINNum",
                        accountNumber: "@item.AccountNumber",
                        region: "@item.Region",
                        zone: "@item.Zone",
                        city: "@item.City",
                        subcity: "@item.Subcity",
                        woreda: "@item.Woreda",
                        kebele: "@item.Kebele",
                        houseNo: "@item.HouseNo",
                        poBox: "@item.PoBox",
                        phoneNo: "@item.PhoneNo",
                        phoneNo2: "@item.PhoneNo2",
                        phoneNo3: "@item.PhoneNo3",
                        teleHome: "@item.TeleHome",
                        teleWork: "@item.TeleWork",
                        email: "@item.Email",
                        email2: "@item.Email2",
                        email3: "@item.Email3",
                        createdDate: "@(item.CreatedDate.HasValue ? item.CreatedDate.Value.ToString("yyyy-MM-dd") : "")",
                        remark: "@item.Remark",
                        branchName: "@(item.Branch1 != null ? item.Branch1.BranchName : "N/A")", // Handle null for Branch1
                        createdBy: "@(item.User != null ? item.User.FullName : "N/A")", // Handle null for User
                    },
                    </text>
                }
            ],

            init() {
                this.filteredShareholders = this.shareholderList;

                this.$watch('selectedShareholders', (newVal) => {
                    this.selectAll = newVal.length === this.filteredShareholders.length;
                });

            },
            toggleAll() {
                this.selectAll = !this.selectAll; // Correct inversion of the selectAll state
                if (this.selectAll) {
                    // Check all checkboxes
                    this.selectedShareholders = this.filteredShareholders.map((shareholder) => shareholder.id);
                } else {
                    // Uncheck all checkboxes
                    this.selectedShareholders = [];
                }
            },
            searchShareholders() {
                // Perform case-insensitive filtering based on FullNameEng, Status, or PhoneNo
                this.filteredShareholders = this.shareholderList.filter(shareholder =>
                    shareholder.shareid.toLowerCase().includes(this.searchUser.toLowerCase()) ||
                    shareholder.fullNameEng.toLowerCase().includes(this.searchUser.toLowerCase()) ||
                    shareholder.phoneNo.toLowerCase().includes(this.searchUser.toLowerCase()) ||
                    shareholder.status.toLowerCase().includes(this.searchUser.toLowerCase()) ||
                    shareholder.email.toLowerCase().includes(this.searchUser.toLowerCase())
                );
            },
            setDisplayType(type) {
                this.displayType = type;
            },

            createDownloadButton(documentId) {
               // Generate the download URL using Razor's Url.Action
               console.log(documentId);
                if (documentId) {
                    let downloadUrl = '@Url.Action("DownloadDocument", "Documents", new { id = "__documentId__" })';
                    downloadUrl = downloadUrl.replace("__documentId__", documentId);
                    // Trigger the file download by navigating to the generated URL
                    window.location.href = downloadUrl;
                } else {
                    alert("Document ID is missing!");
                }
            },
            openDocumentInNewTab(documentId) {
                console.log(documentId);
                if (documentId) {
                    // Make an AJAX request to fetch the document path
                        fetch('@Url.Action("GetDocumentPath", "Documents", new { id = "__id__" })'.replace('__id__', documentId))
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Open the document in a new tab using the retrieved file path
                                const documentUrl = window.location.origin + data.filePath; // Make sure it's a full URL
                                console.log(documentUrl);
                                console.log("abel");
                                window.open(documentUrl, '_blank', 'width=800,height=600');
                            } else {
                                alert(data.message || "Failed to retrieve document path.");
                            }
                        })
                        .catch(error => {
                            console.log("Error fetching document path:", error);
                            alert("An error occurred while trying to fetch the document.");
                        });
                } else {
                    alert("Document ID is missing!");
                }
            },

            approveRequest(id) {
                fetch('@Url.Action("Approve", "Shareholders")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showMessage('Shareholder document successfully unblocked.', 'success');
                        setTimeout(() => {
                            location.reload();
                        }, 2000);
                    } else {
                        showMessage('Failed to unblock shareholder.');
                    }
                })
                .catch(error => {
                    showMessage(data.message || 'An error occurred while unblocking the shareholder document.', 'error');
                });

            },

            openRejectModal(shareholderId) {
                this.selectedShareholderId = shareholderId;
                this.rejectionReason = ''; // Clear any previous reason
                this.rejectModalOpen = true;
             },

            // Close Rejection Modal
            closeRejectModal() {
                this.rejectionReason = '';
                this.rejectModalOpen = false;
            },

            // Submit Rejection with Reason
            submitRejection(id) {
                console.log(this.rejectionReason);
                fetch('@Url.Action("Reject", "Shareholders")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        id,
                        remark: this.rejectionReason
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showMessage('Shareholder rejected successfully.', 'success');

                        this.closeRejectModal();
                        setTimeout(() => {
                            location.reload();
                        }, 2000);
                    } else {
                        showMessage('Failed to reject shareholder.', 'error');
                    }
                })
                .catch(error => {
                    showMessage('An unexpected error occurred.', 'error');
                });
            },

        }));

    });

    // Success message function (Toast)
    async function showMessage(msg = '', type = 'success') {
        const toast = window.Swal.mixin({
            toast: true,
            position: 'top',
            showConfirmButton: false,
            timer: 3000,
        });
        toast.fire({
            icon: type,
            title: msg,
            padding: '10px 20px',
        });
    }
</script>

