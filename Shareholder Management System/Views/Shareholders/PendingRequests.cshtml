                            </svg>
                            Subscription <span class="badge my-0 bg-danger text-white ltr:ml-4 rtl:mr-4">@Model.Subscribtions.Count()</span>
                        </a>
                    </li>
                    <li>
                        <a href="javascript:;"
                           class="-mb-[1px] flex items-center border border-transparent p-3.5 py-2 hover:text-danger"
                           :class=" {'!border-white-light !border-b-white text-danger dark:!border-[#191e3a] dark:!border-b-black' : tab==='payment' }"
