<script>
    $(document).ready(function () {
        // Initialize Select2 with custom search handling
        $('#searchable-select').select2({
            placeholder: "Select a Shareholder",
            allowClear: true,
            width: 'resolve', // Ensures the dropdown inherits the container's width
            matcher: function (params, data) {
                if ($.trim(params.term) === '') {
                    return data;
                }

                // Match against each part of the search term
                const terms = params.term.toLowerCase().split(' ');
                const text = data.text.toLowerCase();

                return terms.every(term => text.includes(term)) ? data : null;
            }
        });

    });
     document.addEventListener('DOMContentLoaded', () => {
        // Check if an error message exists
        const errorMessage = `@Html.Raw(TempData["ErrorMessage"])`.trim();
        if (errorMessage) {
            showMessage(errorMessage, 'error'); // Pass the error message to SweetAlert2 toast
        }
    });

     async function showMessage(msg = '', type = 'success') {
        const toast = window.Swal.mixin({
            toast: true,
            position: 'top',
            showConfirmButton: false,
            timer: 10000,
        });
        toast.fire({
            icon: type,
            title: msg,
            padding: '10px 20px',
        });
    }

    function formWizard() {
        return {
            step: 1,
            nextStep() {
                if (this.step < 4) {
                    this.step++;
                }
            },
            prevStep() {
                if (this.step > 1) {
                    this.step--;
                }
            }
        }
    }
</script>

