@model Shareholder_Management_System.Models.Shareholder

@{
    ViewBag.Title = "Create";
}
<link rel="stylesheet" type="text/css" href="~/Content/CSS/select2.min.css">
<script src="~/Scripts/JS/select2.min.js"></script>

<style>
    .progress-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .progress-bar {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        justify-content: center;
        align-items: center;
    }

    .progress-step {
        display: flex;
        align-items: center;
        flex-direction: column;
        position: relative;
    }

        .progress-step .hexagon {
            width: 40px;
            height: 40px;
            background-color: #e0e6ed;
            clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #6c757d;
            font-size: 0.9rem;
        }

        .progress-step.active .hexagon {
            background-color: #4361ee;
            color: #fff;
        }

        .progress-step .label {
            margin-top: 0.5rem;
            font-size: 0.8rem;
            font-weight: bold;
            color: #6c757d;
        }

        .progress-step.active .label {
            color: #4361ee;
        }

    .progress-line {
        width: 4px;
        height: 30px;
        background-color: #e0e6ed;
    }

    .progress-step:last-child .progress-line {
        display: none;
    }

    /* Responsive Design */
    @@media (min-width: 768px) {
        /* Vertical for medium and larger screens */
        .progress-container {
            display: grid;
            grid-template-columns: 3fr auto;
            align-items: start;
        }

        .progress-bar {
            flex-direction: column;
            justify-content: flex-start;
        }

        .progress-line {
            height: 20px;
        }
    }

    @@media (max-width: 767px) {
        /* Horizontal for small screens */
        .progress-bar {
            flex-direction: row;
            justify-content: space-around;
        }

        .progress-line {
            width: 20px;
            height: 4px;
        }

        .progress-step {
            flex-direction: row;
            gap: 0.5rem;
        }

            .progress-step .hexagon {
                width: 40px;
                height: 40px;
                font-size: 0.8rem;
            }

            .progress-step .label {
                margin-top: 0;
            }
    }
</style>




<div class="progress-container m-auto" x-data="formWizard()">
    <!-- Progress Bar -->
    <div class="progress-bar m-auto">
        <!-- Step 1 -->
        <div class="progress-step" :class="{ 'active': step === 1 }">
            <div class="hexagon">1</div>
            <div class="label">General</div>
            <div class="progress-line"></div>
        </div>

        <!-- Step 2 -->
        <div class="progress-step" :class="{ 'active': step === 2 }">
            <div class="hexagon">2</div>
            <div class="label">Description</div>
            <div class="progress-line"></div>
        </div>

        <!-- Step 3 -->
        <div class="progress-step" :class="{ 'active': step === 3 }">
            <div class="hexagon">3</div>
            <div class="label">Shipping</div>
            <div class="progress-line"></div>
        </div>

        <!-- Step 4 -->
        <div class="progress-step" :class="{ 'active': step === 4 }">
            <div class="hexagon">4</div>
            <div class="label">Confirm</div>
        </div>
    </div>
