<script>
    $(document).ready(function () {
        // Initialize Select2 with custom search handling
        $('#searchable-select').select2({
            placeholder: "Select a Shareholder",
            allowClear: true,
            width: 'resolve', // Ensures the dropdown inherits the container's width
            matcher: function (params, data) {
                if ($.trim(params.term) === '') {
                    return data;
                }

                // Match against each part of the search term
                const terms = params.term.toLowerCase().split(' ');
                const text = data.text.toLowerCase();

                return terms.every(term => text.includes(term)) ? data : null;
            }
        });

    });
    document.addEventListener('DOMContentLoaded', () => {
        // Check if an error message exists in TempData
        const errorMessage = `@TempData["ErrorMessage"]`.trim();
        if (errorMessage) {
            showMessage(errorMessage, 'error'); // Display error as a toast
        }
    });

    // SweetAlert2 Toast Function
    async function showMessage(msg = '', type = 'success') {
        const toast = window.Swal.mixin({
            toast: true,
            position: 'top',
            showConfirmButton: false,
            timer: 5000, // Increased timer for better visibility
        });
        toast.fire({
            icon: type,
            html: msg, // Use 'html' to support line breaks
            padding: '10px 20px',
        });
    }
</script>



