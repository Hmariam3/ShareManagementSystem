@model IEnumerable<Shareholder_Management_System.Models.Proxy>
@using Newtonsoft.Json

@{
    ViewBag.Title = "Index";

    var proxy = ViewBag.NewProxy as Shareholder_Management_System.Models.Proxy;
    var shareholder = ViewBag.Shareholder as Shareholder_Management_System.Models.Shareholder;

}

<link rel="stylesheet" type="text/css" href="~/Content/CSS/select2.min.css">
<script src="~/Scripts/JS/select2.min.js"></script>
<script src="~/Scripts/JS/simple-datatables.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/additional-methods.min.js"></script>


<div class="animate__animated p-6" :class="[$store.app.animation]">
    <!-- start main content section -->
    <div>
        <div class="panel">
            @using (Html.BeginForm("Index", "Proxies", FormMethod.Get))
            {
                @Html.AntiForgeryToken()
                <div class="flex sm:flex-row flex-col text-center">
                    <label for="horizontalEmail" class="mb-0 sm:w-1/4 sm:ltr:mr-2 rtl:ml-2">
                        Search For Shareholder using one option
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="col-span-1">
                            <label for="shid">Via FullName (Eng) OR</label>
                            @Html.DropDownList("ShID",
                                new SelectList((IEnumerable<SelectListItem>)ViewBag.Shareholders, "Value", "Text"),
                                htmlAttributes: new { id = "searchable-select", @class = "form-select w-full" }
                            )
                        </div>
                        <div class="col-span-1">
                            <label for="shareID">Via Shareholder ID</label>
                            <input id="shareID" name="shareID" type="text" placeholder="Enter shareID and hit enter"
                                   class="form-input w-full" value="@ViewBag.ShareID" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mx-3">Search</button>
                </div>

            }
        </div>

        <div class="pt-5" style="@(ViewBag.Shareholder == null ? "display:none;" : "")">
            <div class="mb-5 grid grid-cols-1 gap-5 lg:grid-cols-4 xl:grid-cols-4">
                <div class="panel lg:col-span-2 pb-0 xl:col-span-1">
                    <h5 class="mb-5 text-lg font-semibold dark:text-white-light">Shareholder Details</h5>

                    <!-- Scrollable container with fixed height -->
                    <div class="relative overflow-y-auto max-h-[360px] pr-3">
                        @if (ViewBag.Shareholder != null)
                        {
                            <h6 class="border-b border-t border-[#ebedf2] dark:border-[#1b2e4b] font-semibold text-[#515365] dark:text-white-dark py-3">--- Basic Information ---</h6>

                            <!-- Basic Information -->
                            <div class="group relative flex items-center py-1 border-t border-[#ebedf2] dark:border-[#1b2e4b] ">
                                <div class="flex-1">Share ID:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.ShareID ?? "N/A")</div>
                            </div>

                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Full Name Afan Oromo:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.FullNameAfanOromo ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Shareholder Category:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.SHCategory ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">TIN Number:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.TINNum ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1 border-b border-[#ebedf2] dark:border-[#1b2e4b]">
                                <div class="flex-1">Account Number:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.AccountNumber ?? "N/A")</div>
                            </div>

                            <!-- Address Information -->
                            <h6 class="border-b border-t border-[#ebedf2] dark:border-[#1b2e4b] font-semibold text-[#515365] dark:text-white-dark py-3">--- Address Information ---</h6>

                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Region:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Region ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Zone:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Zone ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">City:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.City ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Subcity:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Subcity ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Woreda:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Woreda ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Kebele:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Kebele ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Phone Number:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.PhoneNo ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Home Telephone:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.TeleHome ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Work Telephone:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.TeleWork ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1 border-b border-[#ebedf2] dark:border-[#1b2e4b]">
                                <div class="flex-1">Email:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Email ?? "N/A")</div>
                            </div>

                            <!-- Status Information -->
                            <h6 class="border-b border-t border-[#ebedf2] dark:border-[#1b2e4b] font-semibold text-[#515365] dark:text-white-dark py-3">--- Status Information ---</h6>

                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Created Branch:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Branch ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Created By:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.CreatedBy ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Created Date:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Authorization Status:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.AuthorizationStatus ?? "N/A")</div>
                            </div>
                            <div class="group relative flex items-center py-1">
                                <div class="flex-1">Authorizer:</div>
                                <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">@(ViewBag.Shareholder?.Authorizer ?? "N/A")</div>
                            </div>
                            @*<div class="group relative flex items-center py-1 border-b border-[#ebedf2] dark:border-[#1b2e4b]">
                                    <div class="flex-1">Authorized Date:</div>
                                    <div class="text-md font-semibold dark:text-white-light ltr:ml-auto rtl:mr-auto">
                                        @(ViewBag.Shareholder?.AuthorizedDate != null ? ViewBag.Shareholder.AuthorizedDate.Value.ToString("yyyy-MM-dd") : "N/A")
                                    </div>
                                </div>*@
                        }
                        else
                        {
                            <p class="text-danger">No shareholder data available.</p>
                        }
                    </div>
                </div>

                <!-- Main Part -->
                <div class="panel lg:col-span-2 xl:col-span-3">
                    <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
                        <h5 class="text-lg font-semibold dark:text-white-light">Proxy Lists</h5>
                        <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:items-center sm:gap-3">
                            <div class="flex gap-3">
                                <div x-data="modal">
                                    <button type="button" class="btn btn-primary" @@click="toggle" style="@(ViewBag.Shareholder == null ? "display:none;" : "")">
                                        <svg width="24" height="24" viewbox="0 0 24 24" fill="none"
                                             xmlns="http://www.w3.org/2000/svg"
                                             class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                                            <circle cx="10" cy="6" r="4" stroke="currentColor"
                                                    stroke-width="1.5"></circle>
                                            <path opacity="0.5"
                                                  d="M18 17.5C18 19.9853 18 22 10 22C2 22 2 19.9853 2 17.5C2 15.0147 5.58172 13 10 13C14.4183 13 18 15.0147 18 17.5Z"
                                                  stroke="currentColor" stroke-width="1.5"></path>
                                            <path d="M21 10H19M19 10H17M19 10L19 8M19 10L19 12"
                                                  stroke="currentColor" stroke-width="1.5"
                                                  stroke-linecap="round">
                                            </path>
                                        </svg>
                                        Add Proxy
                                    </button>

                                    <div class="fixed inset-0 z-[999] hidden overflow-y-auto bg-[black]/60"
                                         :class="open && '!block'">
                                        <div class="flex min-h-screen items-start justify-center px-4"
                                             @@click.self="open = false">
                                            <div x-show="open" x-transition="" x-transition.duration.300=""
                                                 class="panel w-full max-w-5xl my-8 overflow-hidden rounded-lg border-0 py-1 px-4">
                                                <div class="flex items-center justify-between p-5 text-lg font-semibold dark:text-white">
                                                    <div>
                                                        Add Proxy For
                                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="inline h-4 w-4 text-primary ltr:mr-2 rtl:ml-2 rtl:rotate-180">
                                                            <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                                        </svg>
                                                        @if (shareholder != null)
                                                        {
                                                            @shareholder.FullNameEng
                                                        }
                                                    </div>
                                                    <button type="button" @@click="toggle"
                                                            class="text-white-dark hover:text-dark">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px"
                                                             height="24px" viewbox="0 0 24 24" fill="none"
                                                             stroke="currentColor" stroke-width="1.5"
                                                             stroke-linecap="round" stroke-linejoin="round"
                                                             class="h-6 w-6">
                                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                                        </svg>
                                                    </button>
                                                </div>

                                                <div>
                                                    @using (Html.BeginForm("Create", "Proxies", FormMethod.Post, new { id = "createProxyForm", enctype = "multipart/form-data" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <div class="form-section">
                                                            <h2>
                                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="inline h-4 w-4 text-primary ltr:mr-2 rtl:ml-2 rtl:rotate-180">
                                                                    <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                                                </svg>
                                                                <span class="list-text">Basic Information</span>
                                                            </h2>

                                                            @if (shareholder != null)
                                                            {
                                                                @*@Html.Hidden("ShID", new { Name = "proxy.ShID" })*@
                                                                @Html.HiddenFor(model => proxy.ShID, new { Value = proxy.ShID ?? shareholder.ShID })
                                                            }
                                                            <div class="!mt-2">
                                                                @Html.LabelFor(model => proxy.FullName, htmlAttributes: new { @class = "control-label" })
                                                                @Html.EditorFor(model => proxy.FullName, new { htmlAttributes = new { @class = "form-input", @placeholder = "Full Name In English *" } })
                                                                @Html.ValidationMessageFor(model => proxy.FullName, "", new { @class = "text-danger" })
                                                            </div>

                                                            <div class="!mt-2">
                                                                @Html.LabelFor(model => proxy.Nationality, htmlAttributes: new { @class = "control-label" })
                                                                @Html.EditorFor(model => proxy.Nationality, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Nationality *" } })
                                                                @Html.ValidationMessageFor(model => proxy.Nationality, "", new { @class = "text-danger" })
                                                            </div>

                                                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4 !mt-2">
                                                                <div>
                                                                    @Html.LabelFor(model => proxy.PhoneNo, htmlAttributes: new { @class = "control-label" })
                                                                    @Html.EditorFor(model => proxy.PhoneNo, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Primary Mobile Number *" } })
                                                                    @Html.ValidationMessageFor(model => proxy.PhoneNo, "", new { @class = "text-danger" })
                                                                </div>
                                                                <div>
                                                                    @Html.LabelFor(model => proxy.PhoneNo2, htmlAttributes: new { @class = "control-label" })
                                                                    @Html.EditorFor(model => proxy.PhoneNo2, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Additional Mobile Number" } })
                                                                    @Html.ValidationMessageFor(model => proxy.PhoneNo2, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                            <fieldset class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                                <div>
                                                                    <label for="startDate" class="text-white-dark">Start Date * </label>
                                                                    @Html.EditorFor(model => proxy.StartDate, new
                                                                    {
                                                                        htmlAttributes = new
                                                                        {
                                                                            id = "startDate",
                                                                            @class = "form-input",
                                                                            @type = "date", // Ensure the input is of type "date"
                                                                            @min = DateTime.Now.ToString("yyyy-MM-dd") // Set the minimum date to today
                                                                        }
                                                                    })
                                                                    @Html.ValidationMessageFor(model => proxy.StartDate, "", new { @class = "text-danger" })
                                                                </div>

                                                                <div>
                                                                    <label for="endDate" class="text-white-dark">End Date </label>
                                                                    @Html.EditorFor(model => proxy.EndDate, new
                                                               {
                                                                   htmlAttributes = new
                                                                   {
                                                                       id = "endDate",
                                                                       @class = "form-input",
                                                                       @type = "date", // Ensuring the input is of type "date"
                                                                       @min = DateTime.Now.ToString("yyyy-MM-dd") // Set the minimum date to today
                                                                   }
                                                               })
                                                                </div>
                                                            </fieldset>
                                                        </div>

                                                        <div class="!mt-2">
                                                            <div class="form-section">
                                                                <h2>
                                                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="inline h-4 w-4 text-primary ltr:mr-2 rtl:ml-2 rtl:rotate-180">
                                                                        <path d="M4 12H20M20 12L14 2M20 12L14 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                                                    </svg>
                                                                    <span class="list-text">Address Information</span>
                                                                </h2>
                                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 !mt-2">
                                                                    <div>
                                                                        @Html.LabelFor(model => proxy.Region, htmlAttributes: new { @class = "control-label" })
                                                                        @Html.EditorFor(model => proxy.Region, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Region" } })
                                                                        @Html.ValidationMessageFor(model => proxy.Region, "", new { @class = "text-danger" })
                                                                    </div>
                                                                    <div>
                                                                        @Html.LabelFor(model => proxy.Zone, htmlAttributes: new { @class = "control-label" })
                                                                        @Html.EditorFor(model => proxy.Zone, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter zone" } })
                                                                        @Html.ValidationMessageFor(model => proxy.Zone, "", new { @class = "text-danger" })
                                                                    </div>
                                                                </div>

                                                                <div class="!mt-2">
                                                                    @Html.LabelFor(model => proxy.City, htmlAttributes: new { @class = "control-label" })
                                                                    @Html.EditorFor(model => proxy.City, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter City" } })
                                                                    @Html.ValidationMessageFor(model => proxy.City, "", new { @class = "text-danger" })
                                                                </div>

                                                                <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 !mt-2">
                                                                    <div class="md:col-span-2">
                                                                        @Html.LabelFor(model => proxy.Subcity, htmlAttributes: new { @class = "control-label" })
                                                                        @Html.EditorFor(model => proxy.Subcity, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Sub-City" } })
                                                                        @Html.ValidationMessageFor(model => proxy.Subcity, "", new { @class = "text-danger" })
                                                                    </div>
                                                                    <div>
                                                                        @Html.LabelFor(model => proxy.Woreda, htmlAttributes: new { @class = "control-label" })
                                                                        @Html.EditorFor(model => proxy.Woreda, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Woreda" } })
                                                                        @Html.ValidationMessageFor(model => proxy.Woreda, "", new { @class = "text-danger" })
                                                                    </div>
                                                                    <div>
                                                                        @Html.LabelFor(model => proxy.Kebele, htmlAttributes: new { @class = "control-label" })
                                                                        @Html.EditorFor(model => proxy.Kebele, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Kebele" } })
                                                                        @Html.ValidationMessageFor(model => proxy.Kebele, "", new { @class = "text-danger" })
                                                                    </div>
                                                                </div>

                                                            </div>

                                                        </div>

                                                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 sm:grid-cols-2  gap-4 !mt-2 ">
                                                            <div>
                                                                <label for="shFile">Attach Delegation Letter *</label>
                                                                <input id="shFile" type="file" name="proxyFile" accept="application/pdf"
                                                                       class="form-input file:py-2 file:px-4 file:border-0 file:font-semibold p-0 file:bg-primary/90 ltr:file:mr-5 rtl:file:ml-5 file:text-white file:hover:bg-primary"
                                                                       required />
                                                                <span class="text-danger" id="fileError"></span>
                                                            </div>
                                                            <div>
                                                                <label for="kebele">Identification Document</label>
                                                                <input id="kebele" type="file" name="kebeleID" accept="application/pdf"
                                                                       class="form-input file:py-2 file:px-4 file:border-0 file:font-semibold p-0 file:bg-primary/90 ltr:file:mr-5 rtl:file:ml-5 file:text-white file:hover:bg-primary"
                                                                       required />
                                                                <span class="text-danger" id="fileError"></span>
                                                            </div>
                                                        </div>

                                                        <div class="!mt-2">
                                                            <span class="text-danger text-[11px] inline-block">* Required Fields so please fill all required fields</span>
                                                        </div>
                                                        <div class="flex justify-end items-center mt-8">
                                                            <button type="button" class="btn btn-outline-danger" @@click="toggle">Discard</button>
                                                            <button type="submit" id="submitProxyForm" class="btn btn-primary ltr:ml-4 rtl:mr-4">Save</button>
                                                        </div>
                                                    }
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <div x-data="miscellaneous">
                            <div class="space-y-6">
                                <div class="panel sticky-column">
                                    <h5 class="mb-5 text-lg font-semibold dark:text-white-light md:absolute md:top-[25px] md:mb-0">
                                        Shareholders List
                                    </h5>
                                    <div class="relative">
                                        <div class="mb-5 sm:absolute sm:top-0 sm:mb-0 sm:ltr:right-56 sm:rtl:left-56">
                                            <div class="flex items-center">
                                                <div class="theme-dropdown relative" x-data="{ columnDropdown: false }"
                                                     @@click.outside="columnDropdown = false">
                                                    <a href="javascript:;"
                                                       class="flex items-center rounded-md border border-[#e0e6ed] px-4 py-2 text-sm font-semibold dark:border-[#253b5c] dark:bg-[#1b2e4b] dark:text-white-dark"
                                                       @@click="columnDropdown = ! columnDropdown">
                                                        <span class="ltr:mr-1 rtl:ml-1">Columns Visibility</span>
                                                        <svg class="h-5 w-5" viewbox="0 0 24 24" fill="none"
                                                             xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M19 9L12 15L5 9" stroke="currentColor" stroke-width="1.5"
                                                                  stroke-linecap="round" stroke-linejoin="round"></path>
                                                        </svg>
                                                    </a>
                                                    <div class="absolute top-11 z-[10] hidden w-[100px] min-w-[150px] rounded bg-white py-2 text-dark shadow ltr:left-0 rtl:right-0 dark:bg-[#1b2e4b] dark:text-white-light"
                                                         :class="columnDropdown && '!block'">
                                                        <ul class="space-y-2 px-4 font-semibold">
                                                            <template x-for="(col,i) in columns" :key="i">
                                                                <li>
                                                                    <div>
                                                                        <label class="cursor-pointer">
                                                                            <input type="checkbox" class="form-checkbox"
                                                                                   :id="`chk-${i}`" :value="(i)"
                                                                                   @@change="col.hidden=  $event.target.checked,showHideColumns(i,$event.target.checked)"
                                                                                   :checked="col.hidden">
                                                                            <span :for="`chk-${i}`" class="ltr:ml-2 rtl:mr-2"
                                                                                  x-text="col.name"></span>
                                                                        </label>
                                                                    </div>
                                                                </li>
                                                            </template>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @*<table id="myTable1" class="whitespace-nowrap"></table>*@
                                        <table id="myTable1" class="whitespace-nowrap">
