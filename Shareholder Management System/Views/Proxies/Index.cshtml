async function deActivateProxy(proxyID) {
    new window.Swal({
        icon: 'warning',
        title: `Are you sure you want to deactivate proxy ${proxyID}?`,
        showCancelButton: true,
        confirmButtonText: 'Deactivate',
        cancelButtonText: 'Cancel',
        padding: '2em',
    }).then((result) => {
        if (result.isConfirmed) {
            // Use Fetch API instead of jQuery for AJAX call
            fetch('@Url.Action("DeactivateProxy", "Proxies")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ proxyID: proxyID }),
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    showMessage(data.message, 'success');
                    // Optionally reload the page after the message
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    // Show error message
                    showMessage(data.message, 'error');
                    
                }
            })
                .catch(error => {
                    showMessage(data.message, 'error');

            });
        }
    });
}

