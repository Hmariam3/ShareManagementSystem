@model Shareholder_Management_System.Models.User

@{
                /**/

                ViewBag.Title = "Login";
                Layout = null;
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Share Management System - Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>

        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #00ADEF 0%, #0056b3 100%);
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 20px;
            display: flex;
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        .image-section {
            flex: 1.2;
            background: #f8f9fa;
            padding: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            .image-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(135deg, rgba(0, 173, 239, 0.1) 0%, rgba(0, 86, 179, 0.1) 100%);
            }

            .image-section img {
                max-width: 90%;
                height: auto;
                border-radius: 15px;
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
                position: relative;
                z-index: 1;
            }

        .form-section {
            flex: 0.8;
            padding: 60px 40px;
            background: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-header {
            text-align: center;
            margin-bottom: 40px;
        }

            .form-header h1 {
                color: #00ADEF;
                font-size: 36px;
                font-weight: 600;
                margin-bottom: 15px;
                letter-spacing: -0.5px;
            }

            .form-header p {
                color: #666;
                font-size: 16px;
                line-height: 1.6;
            }

        .form-group {
            margin-bottom: 25px;
            position: relative;
        }

            .form-group label {
                display: block;
                margin-bottom: 10px;
                color: #333;
                font-weight: 500;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .form-group input {
                width: 100%;
                padding: 15px 15px 15px 45px;
                border: 2px solid #e1e1e1;
                border-radius: 12px;
                font-size: 15px;
                transition: all 0.3s;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
                background-color: #f8f9fa;
            }

                .form-group input:focus {
                    border-color: #00ADEF;
                    outline: none;
                    box-shadow: 0 0 0 4px rgba(0, 173, 239, 0.1);
                    background-color: white;
                }

            .form-group i {
                position: absolute;
                left: 15px;
                top: 42px;
                color: #00ADEF;
                font-size: 18px;
            }

        .submit-btn {
            width: 100%;
            padding: 16px;
            background: #00ADEF;
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
            font-family: 'Poppins', sans-serif;
        }

            .submit-btn:hover {
                background: #0095d1;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 173, 239, 0.3);
            }

            .submit-btn:active {
                transform: translateY(0);
            }

        .error-message {
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
            text-align: center;
            padding: 10px;
            background-color: rgba(220, 53, 69, 0.1);
            border-radius: 8px;
            margin-top: 15px;
        }

        .form-footer {
            text-align: center;
            margin-top: 30px;
            color: #666;
            font-size: 14px;
        }

        @@media (max-width: 768px) {
            .container {
                flex-direction: column;
                margin: 15px;
            }

            .image-section {
                padding: 30px;
            }

            .form-section {
                padding: 30px;
            }

            .form-header h1 {
                font-size: 28px;
            }
        }

        .loading {
            position: relative;
            pointer-events: none;
        }

            .loading::after {
                content: '';
                position: absolute;
                width: 20px;
                height: 20px;
                top: 50%;
                left: 50%;
                margin-left: -10px;
                margin-top: -10px;
                border: 3px solid rgba(255,255,255,0.3);
                border-radius: 50%;
                border-top-color: #fff;
                animation: spin 1s ease-in-out infinite;
            }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="image-section">
            <img src="~/assets/images/coop.jpeg" alt="Cooperative Logo" />
        </div>
        <div class="form-section">
            <div class="form-header">
                <h1>Welcome Back</h1>
                <p>Sign in to manage your cooperative shares</p>
            </div>

            @using (Html.BeginForm("Login", "UsersAuthorization", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="UserName">Username</label>
                    <i class="fas fa-user"></i>
                    @Html.TextBoxFor(m => m.UserName, new { placeholder = "Enter your username", required = "required", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    <label for="Password">Password</label>
                    <i class="fas fa-lock"></i>
                    @Html.PasswordFor(m => m.Password, new { placeholder = "Enter your password", required = "required", autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "error-message" })
                </div>

                <button type="submit" class="submit-btn">
                    Sign In
                </button>

                if (TempData["errormessage"] != null)
                {
                    <div class="error-message">
                        <i class="fas fa-exclamation-circle"></i> @TempData["errormessage"]
                    </div>
                }

                <div class="form-footer">
                    Shareholder Management System
                </div>
            }
        </div>
    </div>

    <script src="~/Scripts/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('form').on('submit', function () {
                const button = $(this).find('button[type="submit"]');
                button.addClass('loading');
                button.html('Signing In...');
                button.prop('disabled', true);
            });
        });
    </script>
</body>
</html>