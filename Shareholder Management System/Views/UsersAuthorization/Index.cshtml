@model IEnumerable<Shareholder_Management_System.Models.User>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>


<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FullName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UserName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Password)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Role)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsFirstLogin)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Locked)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.activeStatus)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Branch1.BranchCode)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Password)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Role)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsFirstLogin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Locked)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.activeStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Branch1.BranchCode)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.UID }) |
                @Html.ActionLink("Details", "Details", new { id = item.UID }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.UID })
            </td>
        </tr>
    }

</table>
