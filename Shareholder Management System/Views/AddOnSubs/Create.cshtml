@model Shareholder_Management_System.Models.AddOnSub
@{
    ViewBag.Title = "Add On Subscription";
}
<link href="~/Scripts/select2/css/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.6.0.min.js"></script>
<script src="~/Scripts/select2/js/select2.min.js"></script>
<style>
    .input-group .form-control {
        border: 1px solid #d2d6de !important;
    }
</style>
<div class="container">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="panel">
            <div class="mb-5 flex items-center justify-between"
                 style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                <h5 class="text-lg font-semibold uppercase" style="padding:7px;">
                    Addon Subscription
                </h5>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="grid">
                <!-- Shareholder -->
                <div class="mb-5">
                    <label>Shareholder Name</label>
                    <select id="shareid"
                            name="shareid"
                            class="form-control"
                            required></select>
                    @Html.ValidationMessageFor(m => m.shareid)
                </div>

                <!-- Subscription -->
                <div class="mb-5">
                    <label>Subscription ID</label>
                    <select id="subid"
                            name="subid"
                            class="form-control"
                            required></select>
                    @Html.ValidationMessageFor(m => m.subid)
                </div>

                <!-- Number of Shares - Improved Style -->
                <!-- Number of Shares - Normal Field (Matching other fields) -->
                <div class="mb-5">
                    <label>Number of Shares</label>
                    @Html.EditorFor(m => m.No_of_share, new
                       {
                           htmlAttributes = new
                           {
                               @class = "form-input",
                               type = "number",
                               required = "required"
                           }
                       })
                    @Html.ValidationMessageFor(m => m.No_of_share, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fa fa-check"></i> Submit
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#shareid').select2({
                placeholder: "Search for a shareholder",
                allowClear: true,
                width: '100%',
                minimumInputLength: 3,
                ajax: {
                    url: '@Url.Action("SearchShareholders", "Subscribtions")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data.items,
                            pagination: { more: data.hasMore }
                        };
                    },
                    cache: true
                }
            });

            $('#subid').select2({
                placeholder: "Select Subscription ID",
                allowClear: true,
                width: '100%'
            });

            $('#shareid').change(function () {
                var shareholderId = $(this).val();
                $('#subid').empty().append('<option></option>');

                if (shareholderId) {
                    $.ajax({
                        url: '@Url.Action("GetSubIDs", "Subscribtions")',
                        type: 'GET',
                        data: { shareholderId: shareholderId },
                        success: function (data) {
                            $.each(data, function (i, item) {
                                $('#subid').append(
                                    $('<option>')
                                        .val(item.SubID)
                                        .text(item.SubID + ' (' + item.SubNumShares + ' shares)')
                                );
                            });
                            $('#subid').trigger('change');
                        }
                    });
                }
            });
        });
    </script>
}