@model Shareholder_Management_System.Models.AddOnSub
@{
    ViewBag.Title = "Authorize_Details";
}
<script src="~/Scripts/JS/sweetalert.min.js"></script>

<div class="main-container min-h-screen text-black dark:text-white-dark" :class="[$store.app.navbar]">
    <div class="animate__animated p-6" :class="[$store.app.animation]">
        <div class="text-2xl font-extrabold uppercase mb-4">AddOnSub Authorization Details</div>

        @if (Model.status == "Pending")
        {
            <div class="mb-6 flex flex-wrap items-center justify-center gap-4 lg:justify-end">
                <!-- Approve Form -->
                <form id="approveForm" action="@Url.Action("Approve", "AddOnSubs")" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.add_id" />
                    <button type="button" class="btn btn-success gap-2" onclick="showAlert('approve')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="h-6 w-6">
                            <path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.5" fill="none" />
                        </svg>
                        Approve
                    </button>
                </form>

                <!-- Reject Form -->
                <form id="rejectForm" action="@Url.Action("Reject", "AddOnSubs")" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.add_id" />
                    <button type="button" class="btn btn-danger gap-2" onclick="showAlert('reject')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="h-6 w-6">
                            <path d="M15 9L9 15M9 9l6 6" stroke="white" stroke-width="1.5" stroke-linecap="round" />
                            <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.5" fill="none" />
                        </svg>
                        Reject
                    </button>
                </form>
            </div>
        }

        <div class="panel">
            <div class="section mb-6">
                <h2 class="text-lg font-semibold">AddOnSub Information</h2>
                <hr class="my-4 border-[#e0e6ed] dark:border-[#1b2e4b]">
                <div class="flex flex-wrap justify-between gap-4 px-4">
                    <div class="w-full lg:w-1/2 xl:w-1/3">
                        <div class="mb-2 flex justify-between"><span>AddOnSub ID:</span> <span>@Model.add_id</span></div>
                        <div class="mb-2 flex justify-between"><span>No. of Shares:</span> <span>@Model.No_of_share</span></div>
                        <div class="mb-2 flex justify-between"><span>Amount:</span> <span>@(Model.amount.HasValue ? Model.amount.Value.ToString("N2") : "0.00")</span></div>
                    </div>
                    <div class="w-full lg:w-1/2 xl:w-1/3">
                        <div class="mb-2 flex justify-between"><span>Status:</span> <span>@Model.status</span></div>
                        <div class="mb-2 flex justify-between"><span>Created Date:</span> <span>@(Model.createddate.HasValue ? Model.createddate.Value.ToString("yyyy-MM-dd HH:mm") : "")</span></div>
                        <div class="mb-2 flex justify-between"><span>Authorization Date:</span> <span>@(Model.authorizationdate.HasValue ? Model.authorizationdate.Value.ToString("yyyy-MM-dd") : "")</span></div>
                    </div>
                </div>
            </div>

            <div class="section mb-6">
                <h2 class="text-lg font-semibold">Related Information</h2>
                <hr class="my-4 border-[#e0e6ed] dark:border-[#1b2e4b]">
                <div class="flex flex-wrap justify-between gap-4 px-4">
                    <div class="w-full lg:w-1/2 xl:w-1/3">
                        <div class="mb-2 flex justify-between">
                            <span>Shareholder:</span>
                            <span>@(Model.Shareholder != null ? Model.Shareholder.FullNameEng + " (" + Model.Shareholder.ShareID + ")" : "N/A")</span>
                        </div>
                        <div class="mb-2 flex justify-between">
                            <span>Subscription Status:</span>
                            <span>@(Model.Subscribtion != null ? Model.Subscribtion.SubStatus : "N/A")</span>
                        </div>
                    </div>
                    <div class="w-full lg:w-1/2 xl:w-1/3">
                        <div class="mb-2 flex justify-between">
                            <span>Created By:</span>
                            <span>@(Model.User != null ? Model.User.FullName : "N/A")</span>
                        </div>
                        <div class="mb-2 flex justify-between">
                            <span>Authorized By:</span>
                            <span>@(Model.User1 != null ? Model.User1.FullName : "N/A")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function showAlert(action) {
        let actionText = action === 'approve' ? 'Approve this AddOnSub' : 'Reject this AddOnSub';
        let confirmText = action === 'approve' ? 'Approve' : 'Reject';
        let confirmButtonColor = action === 'approve' ? '#28a745' : '#dc3545';
        let iconType = action === 'approve' ? 'success' : 'error';

        new window.Swal({
            icon: iconType,
            text: `This action will ${actionText} permanently. Proceed?`,
            showCancelButton: true,
            confirmButtonText: confirmText,
            cancelButtonText: 'Cancel',
            confirmButtonColor: confirmButtonColor,
            padding: '2em',
        }).then((result) => {
            if (result.isConfirmed) {
                if (action === 'approve') {
                    document.getElementById('approveForm').submit();
                } else if (action === 'reject') {
                    document.getElementById('rejectForm').submit();
                }
            }
        });
    }
</script>