@model Shareholder_Management_System.Models.Certificate

@{
    ViewBag.Title = "Details";
}

<div x-data="form">
    <div style=" margin-left: 12px;">
        <button onclick="printDiv()" class="btn btn-primary">Print Certificate</button>
    </div>

    <div x-data="crypto">
        <div class="relative mt-5 flex flex-col gap-5 xl:flex-row">
            <!-- Certificate Details Panel -->
            <div class="panel perfect-scrollbar absolute z-10 hidden w-80 flex-none divide-y divide-[#ebedf2] overflow-visible
                 border-0 p-0 dark:divide-[#191e3a] lg:overflow-y-auto xl:relative xl:block"
                 :class="{'!block h-full' : isShowCryptoMenu}" style="border: 4px solid #007bff; border-radius: 4px; margin-left: 12px;">
                <div class="flex items-center gap-2 px-4">
                    <!-- Logo Image -->
                    <div class="shrink-0 mt-4">
                        <img src="~/assets/images/coop_logo.png" alt="Coop Logo" class="w-14">
                    </div>
                    <!-- Bank Name (appears next to image) -->
                    <div class="text-2xl font-semibold mt-4" style="font-size: 12px;">
                        Cooperative Bank of Oromia
                    </div>
                </div>

                <!-- Shareholder Details -->
                <div class="flex-1 lg:pr-4" style="padding: 5px; margin: 10px; border-radius: 8px;">
                    <div class="text-white-dark font-semibold">Lakk Abbaa Qoodaa</div>

                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            Shareholder No.:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">@Html.DisplayFor(model => model.Shareholder.ShareID)</span>
                        </div>
                    </div>

                    <div class="text-white-dark font-semibold mb-2 flex w-full items-center">
                        <div class="text-white-dark">Lakk Ragaa</div>
                    </div>
                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">Certificate No: </div>
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">@Html.DisplayFor(model => model.CertNum)</span>
                    </div>

                    <div class="text-white-dark font-semibold">Baay'ina Aksiyoonaa</div>
                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            Number of shares:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @((Model.TotalPaidupAmount.HasValue ? Model.TotalPaidupAmount.Value / 100 : 0).ToString("N0")) <!-- No decimals -->
                            </span>
                        </div>
                    </div>

                    <div class="text-white-dark font-semibold">Guyya Kenname</div>
                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            Issuing Date:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @Model.Shareholder.CreatedDate
                            </span>
                        </div>
                    </div>

                    <div class="text-white-dark font-semibold">Gatii aksiyoona tokko</div>
                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            Per Value:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">100</span>
                        </div>
                    </div>

                    <div class="text-white-dark font-semibold"> • Kaapitaala Hayyamame Qr.</div>
                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            Authorized Capital Birr:
                            <span style="color: #007bff; font-weight: bold;">@Model.TotalPaidupAmount</span>
                        </div>
                    </div>

                    <div class="text-white-dark font-semibold"> • Kaapitaala Malattaa'e Qr.</div>
                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            Subscribed Capital Birr:
                            <span style="color: #007bff; font-weight: bold;">
                                @(Model.Shareholder.Subscribtions.FirstOrDefault().SubAmount)
                            </span>
                        </div>
                    </div>

                    <div class="text-white-dark font-semibold">• Kaapitaala Kaffalame Qr.</div>
                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            • Paid-up Capital Birr:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.Payments != null && Model.Shareholder.Payments.Any()
                                                    ? Model.Shareholder.Payments.Sum(p => p.PaidAmount)
                                                    : 0)
                            </span><br>
                        </div>
                    </div>

                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            Maqaa Abba Qabeenyaa:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">@Html.DisplayFor(model => model.Shareholder.FullNameEng)</span>
                        </div>
                    </div>

                    <div class="mb-2 flex w-full items-center">
                        <div class="text-white-dark">
                            In the Owner of:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.Proxies.FirstOrDefault() != null ? Model.Shareholder.Proxies.FirstOrDefault().FullName : "No Proxy Available")
                            </span>
                        </div>
                    </div>


                    <div class="text-white-dark">
                        Aksiyoonii Lakkofsi isaanii:
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">@Html.DisplayFor(model => model.EndingSerial)</span>
                    </div>
                    <div class="text-white-dark">
                        Hanga
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                            @Model.BeginingSerial
                        </span>
                    </div>
                    <div class="text-white-dark">
                        Gatin Isaanii Qarshii:
                    </div>
                    <div>
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                            @Model.Shareholder.Payments.FirstOrDefault().PaidAmount
                        </span>
                    </div>
                    <div class="text-white-dark">
                        Baay'inni Isaanii:
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                            @(Model.Shareholder.Subscribtions.FirstOrDefault() != null ? Model.Shareholder.Subscribtions.FirstOrDefault().SubNumShares.ToString() : "N/A")
                        </span>
                        ti
                    </div>
                    <div class="text-white-dark">
                        Share form:
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                            @Model.EndingSerial
                        </span>
                    </div>
                    <div class="text-white-dark">
                        to:
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                            @Model.BeginingSerial
                        </span>
                        for an amount of Birr
                        <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                            @Model.Shareholder.Payments.FirstOrDefault().PaidAmount
                        </span>
                    </div>
                </div>


            </div>

            <div class="panel flex-1 p-0" style="border: 4px solid #007bff; border-radius: 4px;" style="border: 4px solid #007bff; border-radius: 4px; margin-left: 12px;">
                <div class="flex-wrap items-center p-4 md:flex">
                    <div class="flex flex-1 items-start ltr:pr-4 rtl:pl-4">
                        <div class="flex items-center justify-between w-full gap-4 px-4">

                            <div>
                                <div class="text-white-dark font-semibold">
                                    Lakk. Abbaa Aksiyoonaa:
                                    <span style="color: #007bff; font-weight: bold; text-decoration: underline">@Html.DisplayFor(model => model.Shareholder.ShareID)</span>
                                </div>
                                <div class="text-white-dark">
                                    Baay'ina Aksiyoonaa:
                                    <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                        @((Model.TotalPaidupAmount.HasValue ? Model.TotalPaidupAmount.Value / 100 : 0).ToString("N0")) <!-- No decimals -->
                                    </span>
                                </div>
                            </div>
                            <!-- Centered Logo and Bank Name Next to Each Other -->
                            <div class="flex items-center space-x-2">
                                <!-- Logo Image -->
                                <div class="shrink-0">
                                    <img src="~/assets/images/coop_logo.png" alt="Coop Logo" class="w-14">
                                </div>
                                <!-- Bank Name -->
                                <p class="text-white-dark text-2xl font-semibold">
                                    Cooperative Bank of Oromia
                                </p>
                            </div>

                            <div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">
                                        Lakk. waraqaa ragaa
                                        <span style="color: #007bff; font-weight: bold;">@Model.CertNum</span>
                                    </div>
                                </div>
                                <div class="text-white-dark font-semibold">
                                    Share Holder No.:
                                    <span style="color: #007bff; font-weight: bold; text-decoration: underline">@Html.DisplayFor(model => model.Shareholder.ShareID)</span>
                                </div>
                                <div class="text-white-dark">
                                    Number of Shares:
                                    <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                        @((Model.TotalPaidupAmount.HasValue ? Model.TotalPaidupAmount.Value / 100 : 0).ToString("N0")) <!-- No decimals -->
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div style="text-align: center; font-weight: bold;">
                    <p>
                        (Akkaataa Seera Itiyoophiyaatti Yeroo hin Murtoofneef kan dhaabbate)<br>
                        (Incorporated for indefinite duration under the laws of Ethiopia)<br>
                        Waajjira Muummichaa: LSP, 16936, Finfinnee/AA, Itiyoophiyaa<br>
                        Head Office: P.O.Box 16936 Finfinnee/AA, Ethiopia
                    </p>
                </div>
                <div style="display: flex; gap: 10px;">
                    <div style="padding: 5px; margin: 10px; flex: 1; padding-right: 10px; border-right: 2px solid black;">
                        <p style="font-weight: bold; text-align: center; text-decoration: underline;">RAGAA ABBUMMAA AKSIYOONAA</p>
                        <p style="margin-bottom: 20px;">
                            Bankiin Hojii Gamtaa Oromiyaa(W.A). akkaataa Labsii Hojii Bankii hayyamuu fi to'achuuf
                            bahe lakkoofsa 84/1994 tiin Baankii Bayyoolessaa Itiyoophiyaatiin lakk. Galmee LBB/008/04
                            ta'een ONkolooleessaa 29 bara 2004(ALA) galmmeaffamee, akkasumas Biiroo Daldalaa fi
                            Misooma Induustirili Bulchinsa Magaalaa Finfinneetti lakk. Galmee daldalaa 104782 ta'e
                            irratti Sadaasa 3 bara 2004 (ALA) galmaa'uudhaan kan hundaa'eedha.
                        </p>

                        <p style="margin-bottom: 20px; padding-left: 20px;">
                            Hanga guyyaa ragaan kun kennametti:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.CertGenerationDate)
                            </span><br>
                            • aappitaala Hayyamame Qarshii:<br>
                            • Kaappitaala Mallatta'e Qarshii: <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.Subscribtions.FirstOrDefault() != null ? Model.Shareholder.Subscribtions.FirstOrDefault().SubAmount.ToString() : "N/A")
                            </span><br>
                            bayy'ina aksiyoona:   tii kan<br>
                            hirame gatin aksiyoona tokkoo qarshii: dha.<br>
                            •  Kappitaala Kaffalame Qarshii:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.TotalPaidupAmount)
                            </span><br>
                        </p>
                        <p style="margin-bottom: 20px">
                            Ragaan kun:
                            Abba qabeenya aksiyoona baay'inni isaa:
                            ta'ee tartiiba lakkoofsa: hanga: ta'uusaanii kan
                            mirkaneessu dha. Aksiyoonni armaan oliittti xuqaman kun akkaataa barreeffama hundeeffamaa
                            fi bulmaata hundeessitootaa Fulbaana 1 bara 2004(ALA)tti mailattaa'een
                            aksiyoona guutummaa guutuutti kaffalaman kan gatinsaa qarshii:  ()
                            ta'e kan qabanidha Waraqaan Ragaa kun har'a: bara:  Finfinneetti kenname.
                        </p>
                        <p style=" padding-left: 60px">
                            Pirezidaantii<br>
                            President
                        </p>
                    </div>
                    <div style="flex: 1;">
                        <p style="font-weight: bold; text-align: center; text-decoration: underline;">SHARE CERTIFICATE</p>
                        <p style="margin-bottom: 20px;">
                            The Cooperative Bank of Oromia(S.C.) licensed under the Licensing and Supervision of Banking
                            Business Proclamation No. B4/1994 Registration Number LBB/008/2024 with the National Bank of
                            Ethiopia on the 29th day of October, 2004 and also registered under commercial Registration
                            No. 104782 with the Trade and Industrial Development Bureau of Addis Ababa City Government
                            on the 3rd day of November 2004.
                        </p>

                        <p style="margin-bottom: 20px; padding-left: 20px;">
                            As of date of issuance of this certificate:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.CertGenerationDate)
                            </span><br>
                            • Authorized Capital Birr:<br>
                            • Subscribed Capital Birr: <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.Subscribtions.FirstOrDefault() != null ? Model.Shareholder.Subscribtions.FirstOrDefault().SubAmount.ToString() : "N/A")
                            </span>
                            divided into:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.Subscribtions.FirstOrDefault() != null ?
                                                              string.Format("{0:F2}", Model.Shareholder.Subscribtions.FirstOrDefault().SubAmount / 100) :
                                                              "N/A")

                            </span>
                            <br>
                            share with par value of Birr:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                100
                            </span>
                            each<br>
                            • Paid-up Capital Birr:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.Payments.FirstOrDefault().PaidAmount)
                            </span><br>
                        </p>

                        <p style="margin-bottom: 20px;">
                            This is to certify that:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.FullNameEng)
                            </span><br>
                            is a registered holder of:
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.Shareholder.Payments.FirstOrDefault()?.PaidAmount / 100)
                            </span><br>
                            (@((Model.TotalPaidupAmount.HasValue ? Model.TotalPaidupAmount.Value / 100 : 0).ToString("N0")) )ordinary shares in Cooperative Bank of Oromia S.C. With
                            serial number from
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.BeginingSerial)
                            </span> to
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.EndingSerial)
                            </span>
                            inclusive, all fully paid-up totaling
                            Birr
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                (@(Model.TotalPaidupAmount))
                            </span>
                            pursuant to the Memorandum and Article of Association
                            signed by the founder on the 1st day of September, 2004 and the amendment thereto, issued on this
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.CreatedDate.Day)
                            </span>
                            day of
                            <span style="color: #007bff; font-weight: bold; text-decoration: underline">
                                @(Model.CreatedDate.Year)
                            </span>
                            in Finfinnee/AA.
                        </p>
                        <p style=" padding-left: 60px">
                            Dura taa'aa Boordii<br>
                            Board Chairperson
                        </p>
                    </div>
                </div>

            </div>


        </div>
    </div>

    <!-- Action Links -->
    <p>
        @Html.ActionLink("Back to List", "Index")
    </p>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script>
    function printDiv() {
        const cryptoDiv = document.querySelector('[x-data="crypto"]');
        cryptoDiv.classList.remove('hidden'); // Make it visible

        const content = cryptoDiv.outerHTML;

        const printWindow = window.open('', '', 'height=600,width=800');

        Array.from(document.styleSheets).forEach(styleSheet => {
            try {
                const href = styleSheet.href;
                if (href) {
                    printWindow.document.write(`<link rel="stylesheet" href="${href}">`);
                }
            } catch (e) {
                // Skip cross-origin stylesheets
            }
        });

        printWindow.document.write('<html><head><title>Print</title></head><body>');
        printWindow.document.write(content);
        printWindow.document.write('</body></html>');

        printWindow.document.close();
        printWindow.print();

        // Optionally, hide it again after printing
        cryptoDiv.classList.add('hidden');
    }
</script>
