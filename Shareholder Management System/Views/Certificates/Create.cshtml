$(document).ready(function () {
    // Listen for checkbox selection on dynamically loaded checkboxes
    $(document).on('change', 'input[name="selectedPayments"]', function () {

        // Retrieve the selected ShID from the dropdown
        var selectedShID = $('#seachable-select').val();// Get the value of the selected ShID
        console.log(selectedShID);
        // Retrieve all selected payment IDs
        var selectedPayIDs = [];
        $('input[name="selectedPayments"]:checked').each(function () {
            selectedPayIDs.push($(this).val());
        }); // Get an array of selected payment IDs
        // Set the selected ShID into the hidden input field

        if (selectedPayIDs.length > 0) {
            console.log('Selected PayIDs:', selectedPayIDs); // Log selected IDs
            console.log('Selected ShID:', selectedShID); // Log selected ShID

            // Make an AJAX GET request to retrieve payment details for selected IDs
            $.ajax({
                url: '@Url.Action("GetPaymentDetails", "Certificates")',
                type: 'GET',
                traditional: true, // Send array as a traditional query string (important for MVC)
                data: {
                    payIDs: selectedPayIDs,
                    shID: selectedShID // Send selected ShID to the server
                },
                success: function (data) {
                    console.log('Data received:', data); // Check the received data
                    // Clear previous payment details
                    $('#paymentsTableBody2').empty();

                    let totalShares = 0;
                    let totalPaidAmount = 0;

                    if (data && data.length > 0) {
                        // Append new rows to the table body
                        data.forEach(function (payment) {
                            $('#paymentsTableBody2').append(
                                '<tr class="hover:bg-gray-100">' +
                                '<td class="border p-2 ltr:text-right">' + payment.PaymentDate + '</td>' +
                                '<td class="border p-2">' + payment.PayID + '</td>' +
                                '<td class="border p-2">' + payment.ReferenceNum + '</td>' +
                                '<td class="border p-2">' + payment.NoofShares + '</td>' +
                                '<td class="border p-2 ltr:text-right">' + payment.PaidAmount + '</td>' +
                                '</tr>'
                            );

                            // Calculate total shares and total paid amount
                            totalShares += parseInt(payment.NoofShares, 10) || 0;
                            totalPaidAmount += parseFloat(payment.PaidAmount) || 0;
                        });

                        // Update the total number of shares and total paid-up amount in the HTML
                        $('#totalNumberOfShares').text(totalShares);
                        $('#totalPaidUpAmount').text(totalPaidAmount.toFixed(2));

                        // Assuming Per Share Value is constant or comes from somewhere else
                        // If it needs to be calculated, add the logic here
                        var perShareValue = 1000.00; // Example value
                        $('#perShareValue').text(perShareValue.toFixed(2));
                    } else {
                        $('#paymentsTableBody2').append('<tr><td colspan="5">No payment details available.</td></tr>');
                        $('#totalNumberOfShares').text('0');
                        $('#totalPaidUpAmount').text('0.00');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', status, error); // Log errors
                    $('#paymentsTableBody2').append('<tr><td colspan="5">Error retrieving payment details.</td></tr>');
                    $('#totalNumberOfShares').text('0');
                    $('#totalPaidUpAmount').text('0.00');
                }
            });
        } else {
            // Clear table if no payments are selected
            $('#paymentsTableBody2').empty().append('<tr><td colspan="5">Payment details will appear here.</td></tr>');
            $('#totalNumberOfShares').text('0');
            $('#totalPaidUpAmount').text('0.00');
        }
    });
});
</script>
