@model Shareholder_Management_System.Models.Certificate

@{
    ViewBag.Title = "Create";
}

<link rel="stylesheet" href="~/Content/CSS/highlight.min.css">
<link rel="stylesheet" type="text/css" media="screen" href="~/Content/CSS/style.css">
<link defer="" rel="stylesheet" type="text/css" media="screen" href="~/Content/CSS/animate.css">
<link rel="stylesheet" type="text/css" href="~/Content/CSS/nice-select2.css">
<script src="~/Scripts/JS/perfect-scrollbar.min.js"></script>
<script src="~/Scripts/JS/nice-select2.js"></script>
<script src="~/Scripts/JS/highlight.min.js"></script>
<script src="~/Scripts/JS/alpine-collaspe.min.js"></script>
<script src="~/Scripts/JS/alpine-persist.min.js"></script>
<script defer="" src="~/Scripts/JS/alpine-ui.min.js"></script>
<script defer="" src="~/Scripts/JS/alpine-focus.min.js"></script>
<script defer="" src="~/Scripts/JS/alpine.min.js"></script>
<script src="~/Scripts/JS/custom.js"></script>

<div x-data="form">
    <div class="grid grid-cols-2 gap-6 pt-5 lg:grid-cols-2">
        <!-- Basic -->
        <div class="panel">
            <div class="mb-5 flex items-center justify-between">
                <h5 class="text-lg font-semibold dark:text-white-light" style="padding:7px;">Generate Certificate</h5>
            </div>
            <div class="relative w-full">
                @using (Html.BeginForm("Create", "Certificates", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div x-data="search">
                        <div>
                            <label for="shid">Shareholder</label>
                            @Html.DropDownList("ShID",
                                new SelectList((IEnumerable<SelectListItem>)ViewBag.Shareholders, "Value", "Text"),
                                htmlAttributes: new { id = "seachable-select", required = "required" }
                            )
                            @Html.ValidationMessageFor(model => model.ShID, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Hidden field to store the selected ShID -->
                    @Html.HiddenFor(model => model.ShID, new { @id = "ShID" })

                    <!-- Table for Payments -->
                    <label style="margin: 20px 0;">Payments</label>
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto; margin: 20px 0;">
                        <table class="table-auto w-full border-collapse border border-gray-300">
                            <thead>
                                <tr class="bg-gray-200">
                                    <th class="border p-2"><input type="checkbox" class="form-checkbox" /></th>
                                    <th class="border p-2">Payment ID</th>
                                    <th class="border p-2">Shareholder Name</th>
                                    <th class="border p-2">Payment Mode</th>
                                    <th class="border p-2">Branch</th>
                                    <th class="border p-2">Paid Amount</th>
                                    <th class="border p-2">Blocked Amount</th>
                                    <th class="border p-2">Reference Number</th>
                                    <th class="border p-2">Payment Date</th>
                                </tr>
                            </thead>
                            <tbody id="paymentsTableBody">
                                <!-- Dynamic content filled by Ajax -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Remark -->
                    <div class="mb-5">
                        @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.TextAreaFor(model => model.Remark, new { @class = "form-input" })
                            @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary mt-6" style="background:#00adef;">Submit</button>
                }
            </div>
        </div>

        <!-- Preview Section -->
        <div>
            <div class="mb-5 flex items-center justify-between">
                <h5 class="text-lg font-semibold dark:text-white-light" style="padding:7px;">Preview</h5>
            </div>
            <hr />
            <div class="mb-5">
                <div x-data="invoicePreview">
                    <!-- Logo and Bank Name Section -->
                    <div class="flex items-center gap-2 px-4">
                        <div class="shrink-0 mt-4">
                            <img src="~/assets/images/coop_logo.png" alt="image" class="w-14">
                        </div>
                        <div class="text-2xl font-semibold mt-4">
                            Cooperative Bank of Oromia
                        </div>
                    </div>

                    <!-- Certificate Number and Date -->
                    <div class="flex items-center gap-2 px-4 lg:justify-end">
                        <div class="mt-4 order-first lg:order-1">
                            Certificate No: @(ViewBag.NewCertNum ?? "Not assigned")
                        </div>
                        <div class="mt-4">
                            Date: @System.DateTime.Now.Date.ToString("yyyy-MM-dd")
                        </div>
                    </div>
                    <hr class="my-6 border-[#e0e6ed] dark:border-[#1b2e4b]">

                    <!-- Shareholder Details -->
                    <div class="lg:flex-row">
                        <div class="flex flex-col gap-6 lg:flex-row lg:gap-2">
                            <div class="flex-1 lg:w-1/2 lg:pr-4">
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Shareholder Name:</div>
                                    <div id="SHName" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Shareholder Number:</div>
                                    <div id="SHNum" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Region:</div>
                                    <div id="SHRegion" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Zone:</div>
                                    <div id="SHZone" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">City:</div>
                                    <div id="SHCity" class="whitespace-nowrap ml-3"></div>
                                </div>
                            </div>
                            <div class="flex-1 lg:w-1/2 lg:pl-4">
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Subcity:</div>
                                    <div id="SHSubcity" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Woreda:</div>
                                    <div id="SHWoreda" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Kebele:</div>
                                    <div id="SHKebele" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">House Number:</div>
                                    <div id="SHHouseNo" class="whitespace-nowrap ml-3"></div>
                                </div>
                                <div class="mb-2 flex w-full items-center">
                                    <div class="text-white-dark">Phone Number:</div>
                                    <div id="SHPhoneNo" class="whitespace-nowrap ml-3"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="my-6 border-[#e0e6ed] dark:border-[#1b2e4b]">

                    <!-- Payment Details -->
                    <div class="table-responsive mt-6">
                        <table class="table-striped w-full">
                            <thead>
                                <tr>
                                    <th class="p-2">Payment Date</th>
                                    <th class="p-2">Pay ID</th>
                                    <th class="p-2">Reference Number</th>
                                    <th class="p-2">Number of Shares</th>
                                    <th class="p-2">Paid Amount</th>
                                </tr>
                            </thead>
                            <tbody id="paymentsTableBody2">
                                <!-- Rows will be dynamically added here -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Totals -->
                    <div class="mt-6 grid grid-cols-1 px-4 sm:grid-cols-2">
                        <div></div>
                        <div class="space-y-2 ltr:text-right rtl:text-left">
                            <div class="flex items-center">
                                <div class="flex-1">Total Number of Shares</div>
                                <div class="w-[37%]" id="totalNumberOfShares">0</div>
                            </div>
                            <div class="flex items-center">
                                <div class="flex-1">Per Share Value</div>
                                <div class="w-[37%]" id="perShareValue">1000.00</div>
                            </div>
                            <div class="flex items-center text-lg font-semibold">
                                <div class="flex-1">Total Paid Up Amount</div>
                                <div class="w-[37%]" id="totalPaidUpAmount">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@*<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />*@

<script src="~/Scripts/select2/js/select2.full.js"></script>
<script src="~/Scripts/select2/js/select2.min.js"></script>
<link href="~/css/select2.min.css" rel="stylesheet" />

<script>
    $(document).ready(function () {
        // Initialize Select2 with custom search handling
        $('#seachable-select').select2({
            placeholder: "Select a Shareholder",
            allowClear: true,
            width: '100%',
            matcher: function (params, data) {
                if ($.trim(params.term) === '') {
                    return data;
                }

                // Match against each part of the search term
                const terms = params.term.toLowerCase().split(' ');
                const text = data.text.toLowerCase();

                return terms.every(term => text.includes(term)) ? data : null;
            }
        });

        // Event listener for dropdown change
        $('#seachable-select').change(function () {
            var selectedValue = $(this).val(); // Get selected value

            if (selectedValue) {
                $('#paymentsTableBody2').empty();
                $('#totalNumberOfShares').text('0');
                $('#totalPaidUpAmount').text('0.00');
                clearDisplayData();
                // Call fetchPayments with the selected ID
                fetchPayments(selectedValue);
            }
        });

        // Handle checkbox selection for payments
        $(document).on('change', 'input[name="selectedPayments"]', function () {
            updatePreview();
        });
    });

    // Clear the displayed shareholder and payment data
    function clearDisplayData() {
        $('#ShID').val('');
        $('#SHName').empty();
        $('#SHNum').empty();
        $('#SHRegion').empty();
        $('#SHZone').empty();
        $('#SHCity').empty();
        $('#SHSubcity').empty();
        $('#SHWoreda').empty();
        $('#SHKebele').empty();
        $('#SHHouseNo').empty();
        $('#SHPhoneNo').empty();
        var tbody = $('#paymentsTableBody');
        tbody.empty(); // Clear previous payments data
    }

    // Fetch payments for the selected shareholder by ID
    function fetchPayments(shID) {
        $.ajax({
            url: '@Url.Action("GetPaymentsByShID", "Certificates")',
            type: 'GET',
            data: { shID: shID }, // Pass the correct ShID to the controller
            success: function (data) {
                console.log(data);
                if (data) {
                    // Update shareholder details
                    $('#SHName').text(data.Shareholder.SHName);
                    $('#SHNum').text(data.Shareholder.ShareNum);
                    $('#SHRegion').text(data.Shareholder.Region);
                    $('#SHZone').text(data.Shareholder.Zone);
                    $('#SHCity').text(data.Shareholder.City);
                    $('#SHSubcity').text(data.Shareholder.Subcity);
                    $('#SHWoreda').text(data.Shareholder.Woreda);
                    $('#SHKebele').text(data.Shareholder.Kebele);
                    $('#SHHouseNo').text(data.Shareholder.HouseNo);
                    $('#SHPhoneNo').text(data.Shareholder.PhoneNo);

                    // Populate the payments table
                    var tbody = $('#paymentsTableBody');
                    tbody.empty(); // Clear the previous content
                    $.each(data.Payments, function (index, payment) {
                        var row = `<tr>
                            <td class="border p-2"><input type="checkbox" name="selectedPayments" value="${payment.PayID}" class="form-checkbox" /></td>
                            <td class="border p-2">${payment.PayID}</td>
                            <td class="border p-2">${payment.SHName}</td>
                            <td class="border p-2">${payment.PaymentMode}</td>
                            <td class="border p-2">${payment.Branch}</td>
                            <td class="border p-2">${payment.PaidAmount}</td>
                            <td class="border p-2">${payment.BlockedAmount}</td>
                            <td class="border p-2">${payment.ReferenceNum}</td>
                            <td class="border p-2">${payment.PaymentDate}</td>
                        </tr>`;
                        tbody.append(row);
                    });

                    // Update the preview section
                    updatePreview();
                }
            },
            error: function () {
                console.error('Error fetching payments');
            }
        });
    }

    // Update the preview section with selected payments
    function updatePreview() {
        var selectedShID = $('#seachable-select').val();
        var selectedPayIDs = [];
        $('input[name="selectedPayments"]:checked').each(function () {
            selectedPayIDs.push($(this).val());
        });

        if (selectedPayIDs.length > 0) {
            $.ajax({
                url: '@Url.Action("GetPaymentDetails", "Certificates")',
                type: 'GET',
                traditional: true,
                data: { payIDs: selectedPayIDs, shID: selectedShID },
                success: function (data) {
                    var tbody = $('#paymentsTableBody2');
                    tbody.empty(); // Clear previous content

                    let totalShares = 0;
                    let totalPaidAmount = 0;

                    if (data && data.length > 0) {
                        $.each(data, function (index, payment) {
                            tbody.append(
                                `<tr>
                                    <td class="p-2">${payment.PaymentDate}</td>
                                    <td class="p-2">${payment.PayID}</td>
                                    <td class="p-2">${payment.ReferenceNum}</td>
                                    <td class="p-2">${payment.NoofShares}</td>
                                    <td class="p-2">${payment.PaidAmount}</td>
                                </tr>`
                            );

                            totalShares += parseInt(payment.NoofShares, 10) || 0;
                            totalPaidAmount += parseFloat(payment.PaidAmount) || 0;
                        });

                        $('#totalNumberOfShares').text(totalShares);
                        $('#totalPaidUpAmount').text(totalPaidAmount.toFixed(2));
                    } else {
                        tbody.append('<tr><td colspan="5">No payment details available.</td></tr>');
                        $('#totalNumberOfShares').text('0');
                        $('#totalPaidUpAmount').text('0.00');
                    }
                },
                error: function () {
                    console.error('Error fetching payment details');
                }
            });
        } else {
            $('#paymentsTableBody2').empty().append('<tr><td colspan="5">Payment details will appear here.</td></tr>');
            $('#totalNumberOfShares').text('0');
            $('#totalPaidUpAmount').text('0.00');
        }
    }
</script>