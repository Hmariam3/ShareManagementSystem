<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('search', () => ({
            search: '',  // Search input model
            items: [],  // Will store the fetched shareholders
            selectedShareholder: null,  // Store the selected shareholder ID

            // Computed property to filter search results based on the search input
            get searchResults() {
                return this.items.filter(item => {
                    return item.Text.toLowerCase().includes(this.search.toLowerCase());
                });
            },

            // Fetch shareholders from the server using the keyup event and jQuery
            setupSearchListener() {
                const self = this;

                $('#shareholder-search').on('keyup', function () {
                    var query = $(this).val();

                    if (query.length > 0) {
                        $.ajax({
                            url: '@Url.Action("GetShareholders", "Certificates")',  // Correct action to fetch shareholders
                            type: 'GET',
                            data: { term: query },
                            success: function (data) {
                                console.log(data);
                                if (Array.isArray(data)) {
                                    self.items = data.map(function (shareholder) {
                                        return {
                                            Value: shareholder.Value,  // Ensure Value is used for ID
                                            Text: shareholder.Text  // Use Text for the displayed name
                                        };
                                    });
                                } else {
                                    self.items = [];  // Clear items if the response is not an array
                                }
                            },
                            error: function () {
                                console.error('Error fetching shareholders');
                                self.items = []; // Clear items on error
                            }
                        });
                    } else {
                        self.items = []; // Clear items if the query is empty
                    }
                });
            },

  
            // Clear the displayed shareholder and payment data
            clearDisplayData() {
                $('#ShID').val();
                $('#SHName').empty();
                $('#SHNum').empty();
                $('#SHRegion').empty();
                $('#SHZone').empty();
                $('#SHCity').empty();
                $('#SHSubcity').empty();
                $('#SHWoreda').empty();
                $('#SHKebele').empty();
                $('#SHHouseNo').empty();
                $('#SHPhoneNo').empty();
                var tbody = $('#paymentsTableBody');
                tbody.empty(); // Clear previous payments data
            },

            // Fetch payments for the selected shareholder by ID
            fetchPayments(shID) {
                const self = this; // Save context for the AJAX callback
                $.ajax({
                    url: '@Url.Action("GetPaymentsByShID", "Certificates")',
                    type: 'GET',
                    data: { shID: shID },  // Pass the correct ShID to the controller
                    success: function (data) {
                        console.log(data)
                        if (data) {

                            $('#SHName').append(data.Shareholder.SHName);
                            $('#SHNum').append(data.Shareholder.ShareNum);
                            $('#SHRegion').append(data.Shareholder.Region);
                            $('#SHZone').append(data.Shareholder.Zone);
                            $('#SHCity').append(data.Shareholder.City);
                            $('#SHSubcity').append(data.Shareholder.Subcity);
                            $('#SHWoreda').append(data.Shareholder.Woreda);
                            $('#SHKebele').append(data.Shareholder.Kebele);
                            $('#SHHouseNo').append(data.Shareholder.HouseNo);
                            $('#SHPhoneNo').append(data.Shareholder.PhoneNo);
                            var tbody = $('#paymentsTableBody');
                            tbody.empty();  // Clear the previous content

                            // Populate the table with payment data
                            $.each(data.Payments, function (index, payment) {
                                    var row = `<tr>
                                <td class="border p-2"><input type="checkbox" name="selectedPayments" value="${payment.PayID}" class="form-checkbox" /></td>
                                <td class="border p-2">${payment.PayID}</td>
                                <td class="border p-2">${payment.SHName}</td>
                                <td class="border p-2">${payment.PaymentMode}</td>
                                <td class="border p-2">${payment.Branch}</td>
                                <td class="border p-2">${payment.PaidAmount}</td>
                                <td class="border p-2">${payment.BlockedAmount}</td>
                                <td class="border p-2">${payment.ReferenceNum}</td>
                                <td class="border p-2">${payment.PaymentDate}</td>
                            </tr>`;
                                    tbody.append(row);
                            });

                        }

                    },
                    error: function () {
                        console.error('Error fetching payments');
                    }
                });
            },

            // Initialization to set up the keyup event
            init() {
                this.setupSearchListener();
            },
      

        }));
