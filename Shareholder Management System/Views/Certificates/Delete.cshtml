@model Shareholder_Management_System.Models.Certificate

@{
    ViewBag.Title = "Delete";
}


<div class="main-container min-h-screen text-black dark:text-white-dark" :class="[$store.app.navbar]">
    <div class="animate__animated p-6" :class="[$store.app.animation]">
        <div class="text-2xl font-extrabold uppercase mb-4">Delete Certificate</div>

        <div class="panel">
            <!-- Shareholder Details -->
            <div class="section mb-6">
                <h2 class="text-lg font-semibold">shareholder Details</h2>
                <hr class="my-4 border-[#e0e6ed] dark:border-[#1b2e4b]">
                <div class="flex flex-wrap justify-between gap-4 px-4">
                    <div class="w-full lg:w-1/2 xl:w-1/4">
                        <div class="px-4 ltr:text-left rtl:text-left">
                            <div class="mb-2 flex justify-between">
                                <span>Shareholder Fullname:</span>
                                <span>@Html.DisplayFor(model => model.Shareholder.FullNameAfanOromo)</span>
                            </div>
                            <div class="mb-2 flex justify-between">
                                <span>Shareholder ID:</span>
                                <span>@Html.DisplayFor(model => model.Shareholder.ShareID)</span>
                            </div>
                            <div class="mb-2 flex justify-between">
                                <span>Subscription Status:</span>
                                <span>@Html.DisplayFor(model => model.Shareholder.FullNameEng)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Details -->
            <div class="section mb-6">
                <h2 class="text-lg font-semibold">Subscribtion and Payment Details</h2>
                <hr class="my-4 border-[#e0e6ed] dark:border-[#1b2e4b]">
                <div class="flex flex-wrap justify-between gap-4 px-4">
                    <div class="w-full lg:w-1/3 xl:w-1/2">
                        <div class="px-4 ltr:text-left rtl:text-left">
                            <div class="mb-2 flex justify-between">
                                <span>Number of Shares:</span>
                                <span> @(Model.Shareholder.Subscribtions.FirstOrDefault() != null ? Model.Shareholder.Subscribtions.FirstOrDefault().SubNumShares.ToString() : "N/A")</span>
                            </div>
                            <div class="mb-2 flex justify-between">
                                <span>Issung Date:</span>
                                <span>@Model.Shareholder.CreatedDate.ToString()</span>
                            </div>
                            <div class="mb-2 flex justify-between">
                                <span> Subscribed Capital Birr:</span>
                                <span> @(Model.Shareholder.Subscribtions.FirstOrDefault().SubAmount)</span>
                            </div>

                        </div>
                    </div>

                    <div class="w-full lg:w-1/2 xl:w-1/3">
                        <div class="px-4 ltr:text-right rtl:text-right">
                            <div class="mb-2 flex justify-between">
                                <span> Paid Capital Birr:</span>
                                <span>  @(Model.Shareholder.Payments.FirstOrDefault().PaidAmount)</span>
                            </div>
                            <div class="mb-2 flex justify-between">
                                <span>Remarks:</span>
                                <span>@Html.DisplayFor(model => model.Remark)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Authorization Information -->
            <div class="section mb-6">
                <h2 class="text-lg font-semibold">Authorization Information</h2>
                <hr class="my-4 border-[#e0e6ed] dark:border-[#1b2e4b]">
                <div class="flex flex-wrap justify-between gap-4 px-4">
                    <div class="w-full lg:w-1/3 xl:w-1/2">
                        <div class="px-4 ltr:text-left rtl:text-left">
                            <div class="mb-2 flex justify-between">
                                <span> Created By:</span>
                                <span>@Html.DisplayFor(model => model.CreatedBy)</span>
                            </div>
                            <div class="mb-2 flex justify-between">
                                <span>Authorization Status:</span>
                                <span>@Html.DisplayFor(model => model.CertAuthorizationStatus)</span>
                            </div>


                        </div>
                    </div>
                    <div class="w-full lg:w-1/2 xl:w-1/3">
                        <div class="mb-2 flex justify-between">
                            <span>Creation Date:</span>
                            <span>@Html.DisplayFor(model => model.CreatedDate)</span>
                        </div>


                    </div>
                </div>
            </div>



            <div class="w-full flex justify-between mt-6">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <input type="submit" value="Delete" class="btn btn-danger px-4 py-2 bg-red-500 hover:bg-red-600 rounded text-white cursor-pointer" />

                    <!-- Back to List Button (Left Side) -->
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success px-4 py-2 bg-green-500 hover:bg-green-600 rounded text-white mr-4" })

                }
            </div>


        </div>
    </div>
</div>

