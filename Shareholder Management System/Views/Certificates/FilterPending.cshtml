@model IEnumerable<Shareholder_Management_System.Models.Certificate>
@{
    /**/

    ViewBag.Title = "Index";
}



<script src="~/Scripts/JS/simple-datatables.js"></script>
<script src="~/Scripts/JS/perfect-scrollbar.min.js"></script>
<script defer="" src="~/Scripts/JS/popper.min.js"></script>
<script defer="" src="~/Scripts/JS/tippy-bundle.umd.min.js"></script>
<script defer="" src="~/Scripts/JS/sweetalert.min.js"></script>

@*<p>
        @Html.ActionLink("Create New", "Create")
    </p>*@


<div class="animate__animated p-4" :@class="[$store.app.animation]">
    <!-- start main content section -->
    <div x-data="multipleTable">
        <div class="panel mt-1">
            <h5 class="mb-5 text-lg font-semibold dark:text-white-light md:absolute md:top-[25px] md:mb-0">Certificates for Authorization</h5>
            <table id="myTable1" class="table-auto w-full border-collapse border border-gray-300">
                <thead>
                    <tr>
                        <th>CertNum</th>
                        <th>ShareID</th>
                        <th>FullNameEng</th>
                        <th>FullNameAfanOromo</th>
                        <th>SHCategory</th>
                        <th>BeginingSerial</th>
                        <th>EndingSerial</th>
                        <th>Total Paidup Amount</th>
                        <th>CreatedBy</th>
                        <th>CertGenerationDate</th>
                        <th>Remark</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>

        </div>

    </div>
</div>

