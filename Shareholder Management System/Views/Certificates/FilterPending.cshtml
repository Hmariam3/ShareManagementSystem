<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('multipleTable', () => ({
            datatable1: null,
            init() {
                this.datatable1 = new simpleDatatables.DataTable('#myTable1', {
                    data: {
                        headings: [
                            'CertNum',
                            'ShareID',
                            'FullNameEng',
                            'FullNameAfanOromo',
                            'SHCategory',
                            'BeginingSerial',
                            'EndingSerial',
                            'Total Paidup Amount',
                            'CreatedBy',
                            'CertGenerationDate',
                            'Remark',
                            'Action'
                        ],
                       data: [
    @foreach (var item in Model)
    {

<text>
    [
        "@item.CertNum", // CertNum
        "@item.Shareholder.ShareID", // Shareholder.ShareID
        "@item.Shareholder.FullNameEng", // FullNameEng
        "@item.Shareholder.FullNameAfanOromo", // FullNameAfanOromo
        "@item.Shareholder.SHCategory", // SHCategory
        "@item.BeginingSerial", // BeginingSerial
        "@item.EndingSerial", // EndingSerial
        "@item.TotalPaidupAmount", // PaymentIDs
        "@item.User.FullName", // DeliveredBy
        "@(item.CertGenerationDate.HasValue ? item.CertGenerationDate.Value.ToString("yyyy-MM-dd") : "")", // CertGenerationDate
        "@item.Remark", // Remark
        `<a href="@Url.Action("Authorize", new { id = item.CertID })"
   class="btn btn-primary"
   style="padding: 8px 12px; border-radius: 4px; font-weight: bold;">
   Authorize
</a>`



],
</text>

    }
]

   },
   searchable: true,
   perPage: 10,
   columns: [
                //{ select: 10, render: (data) => this.formatDate(data) }, // DeliveryDate column
                //{ select: 11, render: (data) => this.formatDate(data) }, // CertGenerationDate column
                    ],
                    firstLast: true,
                    labels: {
                        perPage: '{select}',
                    },
                    layout: {
                        top: '{search}',
                        bottom: '{info}{select}{pager}',
                    },
                });
            },
            formatDate(date) {
                if (date) {
                    const dt = new Date(date);
                    const month = dt.getMonth() + 1 < 10 ? '0' + (dt.getMonth() + 1) : dt.getMonth() + 1;
                    const day = dt.getDate() < 10 ? '0' + dt.getDate() : dt.getDate();
                    return day + '/' + month + '/' + dt.getFullYear();
                }
                return '';
            }
        }));
    });
</script>




