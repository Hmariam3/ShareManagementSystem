@model IEnumerable<Shareholder_Management_System.Models.Certificate>

@{
    ViewBag.Title = "Certificates";

    string GetStatusClass(string status)
    {
        switch (status)
        {
            case "Approved": return "badge-outline-success";
            case "Pending": return "badge-outline-warning";
            case "Rejected": return "badge-outline-danger";
            case "Revoked": return "badge-outline-danger";
            default: return "";
        }
    }

    string FormatDate(string date)
    {
        if (string.IsNullOrWhiteSpace(date))
        {
            return "";
        }

        if (date.StartsWith("/Date(") && date.EndsWith(")/"))
        {
            try
            {
                var timestamp = long.Parse(System.Text.RegularExpressions.Regex.Match(date, @"\d+").Value);
                var dt = DateTimeOffset.FromUnixTimeMilliseconds(timestamp).DateTime;
                return dt.ToString("dd/MM/yyyy");
            }
            catch
            {
                return "";
            }
        }

        if (DateTime.TryParse(date, out var parsedDate))
        {
            return parsedDate.ToString("dd/MM/yyyy");
        }

        if (System.Text.RegularExpressions.Regex.IsMatch(date, @"^\d{2}/\d{2}/\d{4}$") ||
            System.Text.RegularExpressions.Regex.IsMatch(date, @"^\d{4}-\d{2}-\d{2}"))
        {
            if (DateTime.TryParseExact(date, new[] { "dd/MM/yyyy", "yyyy-MM-dd" },
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out parsedDate))
            {
                return parsedDate.ToString("dd/MM/yyyy");
            }
        }

        return "";
    }
}

