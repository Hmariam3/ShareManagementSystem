                            customClass: {
                                confirmButton: 'btn btn-danger',
                                cancelButton: 'btn btn-secondary'
                            }
                        }).then(result => {
                            if (result.isConfirmed) {
                                console.log('Revoking certificate #', certNum);
                                window.location.href = url;
                            } else {
                                console.log('Revoke cancelled for certificate #', certNum);
                            }
                        }).catch(err => {
                            console.error('SweetAlert error:', err);
                            if (confirm(`Are you sure you want to revoke certificate #${certNum}? This action cannot be undone.`)) {
                                console.log('Revoking certificate #', certNum, 'via confirm');
                                window.location.href = url;
                            }
                        });
                    });
                });
            }

            setupSweetAlert();
        });
    </script>

