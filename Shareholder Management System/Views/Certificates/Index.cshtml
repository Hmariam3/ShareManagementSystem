    <script>
    $(document).ready(function () {
        @if (ViewBag.ErrorMessage != null)
        {
<text>
                Swal.fire({
                    toast: true,
                    position: 'top',
                    icon: 'error',
                    title: '@ViewBag.ErrorMessage',
                    showConfirmButton: false,
                    timer: 5000,
                    padding: '10px 20px'
                });
</text>
        }
        // Initialize Select2 with AJAX
        $('#ShIDSelect').select2({
            placeholder: "Select a Shareholder",
            allowClear: true,
            width: '100%',
            minimumInputLength: 3,
            ajax: {
                url: '@Url.Action("SearchShareholders", "Certificates")',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { term: params.term };
                },
                processResults: function (data) {
                    return { results: data.results };
                },
                cache: true
            }
        });
        // Function to update button states
        function updateButtonStates() {
            var hasSelection = !!$('#ShIDSelect').val();
            var hasShareID = !!$('#shareID').val().trim();
            var enableButtons = hasSelection || hasShareID;
            $('#clearBtn').prop('disabled', !enableButtons);
            $('#filterBtn').prop('disabled', !enableButtons);
        }

        // Store shareID when a shareholder is selected
        $('#ShIDSelect').on('select2:select', function (e) {
            var data = e.params.data;
            $('#shareID').val(data.shareID || '');
            updateButtonStates();
        });

        // Clear shareID when dropdown is cleared
        $('#ShIDSelect').on('select2:clear', function () {
            $('#shareID').val('');
            updateButtonStates();
        });

        // Update buttons when shareID input changes
        $('#shareID').on('input', function () {
            updateButtonStates();
        });

        // Clear button click
        $('#clearBtn').click(function () {
            $('#ShIDSelect').val(null).trigger('change'); // Clear Select2
            $('#shareID').val(''); // Clear shareID input
            updateButtonStates();
            $('#filterForm').submit(); // Submit form
        });

        // Initial button state
        updateButtonStates();

    });
    </script>
