@model Shareholder_Management_System.Models.ShareTransfer
<link rel="stylesheet" type="text/css" href="~/Content/CSS/select2.min.css">
<script src="~/Scripts/JS/select2.min.js"></script>
<script src="~/Scripts/JS/sweetalert.min.js"></script>

@section Scripts {
    <script>
    // Store TempData messages in JavaScript variables
    var successMessage = '@TempData["SuccessMessage"]';
    var errorMessage = '@Html.Raw(TempData["ErrorMessage"])';

    document.addEventListener("DOMContentLoaded", function () {
        // Show success alert
        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'Submitted!',
                html: `<p style="font-size: 18px;">${successMessage}</p>`,
                confirmButtonText: 'OK',
                width: '30rem'
            });
        }

        // Show error alert
        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'Transfer Not Submitted!',
                html: `<div style="text-align: left; font-size: 18px; line-height: 1.5;">${errorMessage.replace(/\n/g, "<br>")}</div>`,
                confirmButtonText: 'Understood',
                width: '30rem'
            });
        }
    });
    </script>
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="animate__animated p-3" :class="[$store.app.animation]">
        <!-- Start main content section -->
        <div x-data="form">
            <div class="flex items-center justify-between"
                 style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                <h5 class="text-lg font-semibold dark:text-white-light" style="padding:7px;">Share Transfer Form</h5>
            </div>
            <div class="grid grid-cols-1 gap-6 pt-5">
                <div class="hidden">
                    <!-- Hidden inputs -->
                    <input class="form-input" id="selectedSubscriptionIds" name="selectedSubscriptionIds"
                           style="width: 200px" placeholder="Sub ID Populate here" readonly />
                    <input class="form-input" id="selectedPaymentIds" name="selectedPaymentIds" style="width: 500px"
                           placeholder="Pay ID Populate here" readonly />
                    <input class="form-input" id="transferType" name="TransferType" style="width: 500px"
                           placeholder="Transfer Type is here" value="" readonly required />
                </div>

                <!-- Column One -->
                <div class="panel">
                    <div class="mb-5">
                        <div class="panel">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 ">
                                <div>
                                    <label for="TransferrorShID">Transfer From</label>
                                    <select name="TransferrorShID" id="TransferrorShID"
                                            class="form-select transferror-select">
                                        <option value="">Select a Shareholder</option>
                                    </select>
                                    <span class="text-danger"></span>
                                </div>
                                <div>
                                    <label for="TransfareeShID">Transfer To</label>
                                    <select name="TransfareeShID" id="TransfareeShID" class="form-select transferee-select">
                                        <option value="">Select a Shareholder</option>
                                    </select>
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <br />
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <!-- Transfer Category Dropdown -->
                            <div class="col-md-10">
                                <label>Transfer Category <span style="color:red">*</span></label>
                                @Html.DropDownListFor(model => model.TransferCategory,
                                new List<SelectListItem>
                                    {
                                    new SelectListItem { Text = "Subscription", Value = "Subscription" },
                                    new SelectListItem { Text = "Payment", Value = "Payment" },
                                    new SelectListItem { Text = "Full Transfer", Value = "Full Transfer" }
                                    }, "Select Transfer Category", new { @class = "form-input", id =
                                    "transferCategoryDropdown" })
                                <span class="text-danger"></span>
                            </div>
                            <!-- Transfer Type Radio Buttons -->
                            <div class="flex flex-col sm:flex-row mt-6" id="transferTypeDiv" style="display: none;">
                                <label class="rtl:ml-2 sm:w-1/4 sm:ltr:mr-2">
                                    Transfer Type <span style="color:red">*</span>
                                </label>
                                <div class="flex-1">
                                    <div class="mb-2">
                                        <label class="mt-1 inline-flex cursor-pointer">
                                            <input type="radio" name="transferType" value="Full" class="form-radio"
                                                   id="transferTypeFull">
                                            <span>Full</span>
                                        </label>
                                    </div>
                                    <div class="mb-2">
                                        <label class="mt-1 inline-flex cursor-pointer">
                                            <input type="radio" name="transferType" value="Partial" class="form-radio"
                                                   id="transferTypePartial">
                                            <span>Partial</span>
                                        </label>
                                    </div>
                                    <div class="mb-2">
                                        <label class="mt-1 inline-flex cursor-pointer">
                                            <input type="radio" name="transferType" value="PaidUp" class="form-radio"
                                                   id="transferTypePaidUp">
                                            <span>Paid Up</span>
                                        </label>
                                    </div>
                                    <div class="mb-2">
                                        <label class="mt-1 inline-flex cursor-pointer">
                                            <input type="radio" name="transferType" value="Right" class="form-radio"
                                                   id="transferTypeRight">
                                            <span>Right</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="grid grid-cols-1 gap-6 xl:grid-cols-2 mt-4">
                                <div class="panel">
                                    <div class="mb-5 flex items-center justify-between">
                                        <h5 class="text-lg font-semibold dark:text-white-light">Subscription Status</h5>
                                    </div>
                                    <div class="mb-5">
                                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                            <table id="subscriptionsTable">
                                                <thead style="position: sticky; top: 0; background-color: #f3f4f6; z-index: 1;">
                                                    <tr>
                                                        <th style="width: 20px;"></th>
                                                        <th>Sub ID</th>
                                                        <th>Share Amount</th>
                                                        <th>Paid Shares</th>
                                                        <th>Unpaid Shares</th>
                                                        <th class="partial-transfer-col">Right Transfer</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="panel">
                                    <div class="mb-5 flex items-center justify-between">
                                        <h5 class="text-lg font-semibold dark:text-white-light">Payment Status</h5>
                                    </div>
                                    <div class="mb-5">
                                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                            <table id="paymentsTable">
                                                <thead style="position: sticky; top: 0; background-color: #f3f4f6; z-index: 1;">
                                                    <tr>
                                                        <th style="width: 20px;"></th>
                                                        <th>Pay ID</th>
                                                        <th>Paid Amount</th>
                                                        <th class="partial-transfer-col">Partial Transfer</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mt-4">
                            <div class="col-md-10">
                                <label>No of Shares Transferred</label>
                                @Html.TextBoxFor(model => model.NumSharesTransferred, new { @class = "form-input", @readonly = "readonly", @id = "numSharesTransferred" })
                                @Html.ValidationMessageFor(model => model.NumSharesTransferred, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-10">
                                <label>Amount Per Share</label>
                                @Html.TextBoxFor(model => model.AmountPerShare, new { @class = "form-input", @Value = "100", @readonly = "readonly", @id = "amountPerShare" })
                                @Html.ValidationMessageFor(model => model.AmountPerShare, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-10">
                                <label>Paid Amount for Share</label>
                                <div class="flex">
                                    <div class="bg-[#eee] flex justify-center items-center ltr:rounded-l-md rtl:rounded-r-md px-3 font-semibold border ltr:border-r-0 rtl:border-l-0 border-[#e0e6ed] dark:border-[#17263c] dark:bg-[#1b2e4b]">ETB</div>
                                    @Html.TextBoxFor(model => model.PaidAmountForTransfer, new { @class = "form-input rounded-none", @readonly = "readonly", @id = "paidAmountForTransfer" })
                                    @Html.ValidationMessageFor(model => model.PaidAmountForTransfer, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                            <div class="col-md-10">
                                <label>Dividend For <span style="color:red">*</span></label>
                                @Html.DropDownListFor(model => model.DividenedFor,
                                new List<SelectListItem>
                                    {
                                    new SelectListItem { Text = "Transferor", Value = "Transferor" },
                                    new SelectListItem { Text = "Transferee", Value = "Transferee" },
                                    new SelectListItem { Text = "Both", Value = "Both" }
                                    }, "Select Dividend For", new { @class = "form-input", @id = "dividendFor" })
                                @Html.ValidationMessageFor(model => model.DividenedFor, "", new { @class = "text-danger"
                                })
                            </div>
                            <div class="col-md-10">
                                <label>Reason for Transfer <span style="color:red">*</span></label>
                                @Html.DropDownListFor(model => model.TransferReason,
                                new List<SelectListItem>
                                    {
                                    new SelectListItem { Text = "Sale", Value = "Sale" },
                                    new SelectListItem { Text = "Gift", Value = "Gift" },
                                    new SelectListItem { Text = "Heir", Value = "Heir" },
                                    new SelectListItem { Text = "Court Decision", Value = "Court Decision" },
                                    }, "Select Transfer Reason", new { @class = "form-input", @id = "transferReason" })
                                @Html.ValidationMessageFor(model => model.TransferReason, "", new { @class =
                                "text-danger" })
                            </div>
                            <div class="col-md-10">
                                <label>Transfer Date <span style="color:red">*</span></label>
                                @Html.TextBoxFor(model => model.TransferDate, new { @class = "form-input", @type = "date",
                                @id = "transferDate" })
                                @Html.ValidationMessageFor(model => model.TransferDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <br />
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div class="mb-5">
                                <label>Upload Document <span style="color:red">*</span></label>
                                <div class="custom-file-container" data-upload-id="myFirstImage">
                                    <div class="custom-file-container__image-preview">
                                        <input type="file"
                                               class="form-input file:py-2 file:px-4 file:border-0 file:font-semibold p-0 file:bg-primary/90 ltr:file:mr-5 rtl:file:ml-5 file:text-white file:hover:bg-primary"
                                               accept="*" name="uploadedFile" required>
                                        <span class="custom-file-container__custom-file__custom-file-control"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-10">
                                <label>Remark</label>
                                @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @class = "form-input", @id = "remark" } })
                                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit the form -->
            <button type="submit" class="btn btn-primary !mt-6">Submit Transfer</button>
        </div>
    </div>
}



