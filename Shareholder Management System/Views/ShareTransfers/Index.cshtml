@model IEnumerable<Shareholder_Management_System.Models.ShareTransfer>

@{
    ViewBag.Title = "Index";
}




<div class="animate__animated p-4" :@class="[$store.app.animation]">
    <!-- start main content section -->
    <div x-data="multipleTable">
        <div class="panel mt-1">
            <h5 class="mb-5 text-lg font-semibold dark:text-white-light md:absolute md:top-[25px] md:mb-0">Share Transfer Table</h5>
            <table id="myTable1" class="table-auto w-full border-collapse border border-gray-300">
                <thead>
                    <tr>
                        <th>Transfer From</th>
                        <th>Transfer To</th>
                        <th>Transfer Type</th>
                        @*<th>Subscription Status</th>*@
                        <th>Num of Shares transferred</th>
                        <th>Amount per Share</th>
                        <th>Paid Amount for Transfer</th>
                        <th>Transfer Reason</th>
                        <th>Dividend for</th>
                        <th>Transfer DOc</th>
                        <th>Transfer Date</th>
                        <th>Creation Date</th>
                        <th>Transfer Authorization Status</th>
                        <th>Transfer Authorization Date</th>
                        <th>Remark</th>
                        @*<th>Payment Mode</th>*@
                        @*<th>User Fullname</th>
        <th>User Fullname1</th>*@
                    </tr>
                </thead>
            </table>

        </div>

    </div>
</div>

<script src="~/Scripts/JS/simple-datatables.js"></script>
<script src="~/Scripts/JS/perfect-scrollbar.min.js"></script>
<script defer="" src="~/Scripts/JS/popper.min.js"></script>
<script defer="" src="~/Scripts/JS/tippy-bundle.umd.min.js"></script>
<script defer="" src="~/Scripts/JS/sweetalert.min.js"></script>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('multipleTable', () => ({
            datatable1: null,
            init() {
                this.datatable1 = new simpleDatatables.DataTable('#myTable1', {
                    data: {
                        headings: [
                            'Transfer From',
                            'Transfer To',
                            //'SubStatus',
                            'Sub ID',
                            'Pay ID',
                            'Transfer Type',
                            'Shares Transferred',
                            'Amount Per Share',
                            'Paid Amount for Transfer',
                            'Transfer Reason',
                            'Dividened For',
                            'Transfered Date',
                            'Creation Date',
                            'Authorization Status',
                            'Authorization Date',
                            'Remark',
                            'Action'
                            //'PaymentMode',
                            //'FullName',
                            //'FullName1'
                        ],
                       data: [
    @foreach (var item in Model)
    {
        <text>
        [
            
            "@item.Shareholder.FullNameEng", // Shareholder.ShareID
            "@item.Shareholder1.FullNameEng", // Shareholder.ShareID
            "@item.SubID",
            "@item.PayID",
            "@item.TransferType", 
            @*"@item.Shareholder.FullNameEng", // FullNameEng*@
            @*"@item.Subscribtion.SubStatus", // FullNameAfanOromo*@
            "@item.NumSharesTransferred", 
            "@item.AmountPerShare", 
            "@item.PaidAmountForTransfer", 
            "@item.TransferReason", 
            "@item.DividenedFor", 
            "@item.TransferDate",
            "@item.CreationDate", 
            "@item.TransferAuthorizationStatus", 
            "@item.TransferAuthorizationDate", 
            "@item.Remark", 
            @*"@item.Payment.PaymentMode", // CertGenerationDate*@
            @*"@item.User.FullName", // Remark
            "@item.User1.FullName", // CertGenerationDate*@


            `<a href="@Url.Action("Edit", new { id = item.TransferID })">Edit</a> |
             <a href="@Url.Action("Details", new { id = item.TransferID })">Details</a> |
             <a href="@Url.Action("Delete", new { id = item.TransferID })">Delete</a>`
        ],
        </text>
    }
]

                    },
                    searchable: true,
                    perPage: 5,
                    columns: [
                        { select: 10, render: (data) => this.formatDate(data) }, // DeliveryDate column
                        { select: 11, render: (data) => this.formatDate(data) }, // CertGenerationDate column
                    ],
                    firstLast: true,
                    labels: {
                        perPage: '{select}',
                    },
                    layout: {
                        top: '{search}',
                        bottom: '{info}{select}{pager}',
                    },
                });
            },
            formatDate(date) {
                if (date) {
                    const dt = new Date(date);
                    const month = dt.getMonth() + 1 < 10 ? '0' + (dt.getMonth() + 1) : dt.getMonth() + 1;
                    const day = dt.getDate() < 10 ? '0' + dt.getDate() : dt.getDate();
                    return day + '/' + month + '/' + dt.getFullYear();
                }
                return '';
            }
        }));
    });
</script>