@model IEnumerable<Shareholder_Management_System.Models.ShareTransfer>

@{
    ViewBag.Title = "Authorize";
}

<script src="~/Scripts/JS/sweetalert.min.js"></script>
@section Scripts {
    <script>
    // Store TempData message in a JavaScript variable
    var successMessage = '@TempData["SuccessMessage"]';
    var errorMessage = '@TempData["ErrorMessage"]';

    document.addEventListener("DOMContentLoaded", function () {
        // Display success message if it exists
        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'Approved!',
                html: `<p style="font-size: 18px;">${successMessage}</p>`,
                confirmButtonText: 'OK',
                width: '30rem' // Adjust modal size
            });
        }

        // Display error message if it exists
        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'Rejected!',
                html: `<p style="font-size: 18px;">${errorMessage}</p>`,
                confirmButtonText: 'OK',
                width: '30rem',
                showCloseButton: true
            }).then(() => {
                // Reload the page after the error message is dismissed
                window.location.reload();
            });
        }
    });
</script>

}

<style>

    /* Hover effect */
    button[title="Approve"]:hover svg {
        transform: scale(1.5);
        cursor: pointer;
    }

    button[title="Reject"]:hover svg {
        transform: scale(1.5);
        cursor: pointer;
    }

    .swal2-popup.colored-toast {
        padding: 15px 20px;
        font-size: 0.9rem;
        border-radius: 10px;
    }

        .swal2-popup.colored-toast.success {
            background-color: #1abc9c !important; /* Success color */
            color: white;
        }

        .swal2-popup.colored-toast.error {
            background-color: #e74c3c !important; /* Error color */
            color: white;
        }
</style>



<div class="animate__animated p-6" :class="[$store.app.animation]">
    <!-- start main content section -->
    <div x-data="basic">
        <div class="panel mt-6 sticky-column">
            <h5 class="text-lg font-semibold dark:text-white-light">ShareTransfer Table</h5>
            <table id="myTable" class="table-hover whitespace-nowrap"></table>
        </div>
    </div>
    <!-- end main content section -->
</div>


<script src="~/Scripts/JS/simple-datatables.js"></script>
<script src="~/Scripts/JS/perfect-scrollbar.min.js"></script>
<script defer="" src="~/Scripts/JS/popper.min.js"></script>
<script defer="" src="~/Scripts/JS/tippy-bundle.umd.min.js"></script>
<script defer="" src="~/Scripts/JS/sweetalert.min.js"></script>
<script src="assets/js/highlight.min.js"></script>
<script src="assets/js/alpine-collaspe.min.js"></script>
<script src="assets/js/alpine-persist.min.js"></script>
<script defer="" src="assets/js/alpine-ui.min.js"></script>
<script defer="" src="assets/js/alpine-focus.min.js"></script>
<script defer="" src="assets/js/alpine.min.js"></script>
<script src="assets/js/custom.js"></script>
<script defer="" src="assets/js/apexcharts.js"></script>
<script src="assets/js/simple-datatables.js"></script>
<script>
    document.addEventListener('alpine:init', () => {
        // main section
        Alpine.data('scrollToTop', () => ({
            showTopButton: false,
            init() {
                window.onscroll = () => {
                    this.scrollFunction();
                };
            },

            scrollFunction() {
                if (document.body.scrollTop > 50 || document.documentElement.scrollTop > 50) {
                    this.showTopButton = true;
                } else {
                    this.showTopButton = false;
                }
            },

            goToTop() {
                document.body.scrollTop = 0;
                document.documentElement.scrollTop = 0;
            },
        }));

        // theme customization
        Alpine.data('customizer', () => ({
            showCustomizer: false,
        }));

        // sidebar section
        Alpine.data('sidebar', () => ({
            init() {
                const selector = document.querySelector('.sidebar ul a[href="' + window.location.pathname + '"]');
                if (selector) {
                    selector.classList.add('active');
                    const ul = selector.closest('ul.sub-menu');
                    if (ul) {
                        let ele = ul.closest('li.menu').querySelectorAll('.nav-link');
                        if (ele) {
                            ele = ele[0];
                            setTimeout(() => {
                                ele.click();
                            });
                        }
                    }
                }
            },
        }));

        // header section
        Alpine.data('header', () => ({
            init() {
                const selector = document.querySelector('ul.horizontal-menu a[href="' + window.location.pathname + '"]');
                if (selector) {
                    selector.classList.add('active');
                    const ul = selector.closest('ul.sub-menu');
                    if (ul) {
                        let ele = ul.closest('li.menu').querySelectorAll('.nav-link');
                        if (ele) {
                            ele = ele[0];
                            setTimeout(() => {
                                ele.classList.add('active');
                            });
                        }
                    }
                }
            },
        }));

        Alpine.data('basic', () => ({
            datatable: null,
            init() {
                this.datatable = new simpleDatatables.DataTable('#myTable', {
                    data: {
                        headings: ['Transfer From', 'Transfer To', 'TID', 'Transfer Category', 'Transfer Type', 'Shares Transferred', 'Paid Amount', 'Transfer Reason','Dividened For','Authorization Status','Take Action'],
                        data: [
                        @foreach (var item in Model)
                        {

                                <text>
                                [
                                    
                                    "@item.Shareholder.FullNameEng" + " " + "(@item.Shareholder.ShareID)",
                                    "@item.Shareholder1.FullNameEng" + " " + "(@item.Shareholder1.ShareID)",
                                    "@item.TransferID",
                                    "@item.TransferCategory",
                                    "@item.TransferType",
                                    "@item.NumSharesTransferred",
                                    "@item.PaidAmountForTransfer",
                                    "@item.TransferReason",
                                    "@item.DividenedFor",
                                    `@if (item.TransferAuthorizationStatus == "Pending")
                                        {
                                            <span class="badge badge-outline-primary" style="font-size: 0.9em; padding: 0.5em 1em; align-items: center;">Pending</span>
                                        }
                                        else if (item.TransferAuthorizationStatus == "Approved")
                                        {
                                            <span class="badge badge-outline-success" style="font-size: 0.9em; padding: 0.5em 1em;">Approved</span>
                                        }
                                        else if (item.TransferAuthorizationStatus == "Rejected")
                                        {
                                            <span class="badge badge-outline-danger" style="font-size: 0.9em; padding: 0.5em 1em;">Rejected</span>
                                        }
                                        `,
                                    `@if (item.TransferAuthorizationStatus == "Pending")
                                        {
                                            <a href="@Url.Action("Authorize_Details", new { id = item.TransferID }) " class="btn btn-primary  gap-2">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-success">

                                                    <path d="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3z" stroke="white" stroke-width="1.5" fill="none"></path>
                                                    <circle cx="8" cy="8" r="1" fill="white"></circle>
                                                    <path d="M12 13v3" stroke="white" stroke-width="1.5" stroke-linecap="round"></path>
                                                </svg>
                                                Authorize
                                            </a>
                                    }
                                    else
                                    {
                                        
                                        <a href="@Url.Action("Details", new { id = item.TransferID }) " class="btn btn-secondary  gap-2">
                                            <svg width="5" height="5" viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-success">
                                                <path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.5" fill="none" />
                                                <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.5" fill="none" />
                                            </svg>
                                            Authorized
                                        </a>
                                        
                                    }
                                        `,
                                ],
                                </text>
                            }
                        ],
                    },
                    searchable: true,
                    perPage: 5,
                    perPageSelect: [5, 10, 20,],
                    columns: [

                    ],
                    firstLast: true,
                    firstText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M13 19L7 12L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> <path opacity="0.5" d="M16.9998 19L10.9998 12L16.9998 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    lastText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M11 19L17 12L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> <path opacity="0.5" d="M6.99976 19L12.9998 12L6.99976 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    prevText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M15 5L9 12L15 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    nextText:
                        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 rtl:rotate-180"> <path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>',
                    labels: {
                        perPage: '{select}',
                    },
                    layout: {
                        top: '{search}',
                        bottom: '{info}{select}{pager}',
                    },
                });

            },
        }));
    });
</script>


