@model IEnumerable<Shareholder_Management_System.Models.AuditLog>

@{
    ViewBag.Title = "Audit Log Records";
}

<link href="~/css/jquery-1.13.4.dataTables.min.css" rel="stylesheet" />
<script src="~/js/jquery.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>

<script src="~/Scripts/JS/simple-datatables.js"></script>

<h5 class="mb-5 text-lg font-semibold dark:text-white-light md:absolute md:top-[25px] md:mb-0">
    Audit Log Records
</h5>

<div class="animate__animated p-6" :class="[$store.app.animation]" :class="grid grid-cols-2 gap-6 pt-5 lg:grid-cols-2">
    <!-- Main Content Section -->
    <div x-data="miscellaneous">
        <div class="space-y-6">
            <div class="panel">

                <!-- Filter Form with Static Layout -->
                <form method="get" action="@Url.Action("RecordLog")" class="flex flex-col md:flex-row justify-between items-center mb-4 space-y-4 md:space-y-0">
                    <!-- Left: Filter Fields -->
                    <div class="flex flex-wrap space-x-4">
                        <!-- Branch Filter -->
                        <div class="flex flex-col">
                            <label for="branch" class="block text-sm font-medium dark:text-white-light">Branch</label>
                            <select id="branch" name="branch" class="form-select dark:bg-[#1b2e4b] dark:text-white-light" style="width: 200px;" @(ViewBag.Branches == null || ((List<string>)ViewBag.Branches).Count == 0 ? "disabled" : "")>
                                <option value="">All Branches</option>
                                @foreach (var b in ViewBag.Branches as List<string>)
                                {
                                    <option value="@b" @(Request.QueryString["branch"] == b ? "selected" : "")>@b</option>
                                }
                            </select>
                        </div>
                        <!-- User Name Filter -->
                        <div class="flex flex-col">
                            <label for="userName" class="block text-sm font-medium dark:text-white-light">User Name</label>
                            <select id="userName" name="userName" class="form-select dark:bg-[#1b2e4b] dark:text-white-light" style="width: 200px;" @(ViewBag.Users == null || ((List<string>)ViewBag.Users).Count == 0 ? "disabled" : "")>
                                <option value="">All Users</option>
                                @foreach (var u in ViewBag.Users as List<string>)
                                {
                                    <option value="@u" @(Request.QueryString["userName"] == u ? "selected" : "")>@u</option>
                                }
                            </select>
                        </div>
                        <!-- Table Name Filter -->
                        <div class="flex flex-col">
                            <label for="tableName" class="block text-sm font-medium dark:text-white-light">Table Name</label>
                            <input type="text" id="tableName" name="tableName" placeholder="Search Table Name..." class="form-input bg-white dark:bg-[#1b2e4b] dark:text-white-light h-full p-2 border border-gray-300 rounded-md" value="@Request.QueryString["tableName"]" />
                        </div>
                        <!-- Start Date Filter -->
                        <div class="flex flex-col">
                            <label for="startDate" class="block text-sm font-medium dark:text-white-light">Start Date</label>
                            <input type="date" id="startDate" name="startDate" class="form-input bg-white dark:bg-[#1b2e4b] dark:text-white-light h-full p-2 border border-gray-300 rounded-md" value="@Request.QueryString["startDate"]" />
                        </div>
                        <!-- End Date Filter -->
                        <div class="flex flex-col">
                            <label for="endDate" class="block text-sm font-medium dark:text-white-light">End Date</label>
                            <input type="date" id="endDate" name="endDate" class="form-input bg-white dark:bg-[#1b2e4b] dark:text-white-light h-full p-2 border border-gray-300 rounded-md" value="@Request.QueryString["endDate"]" />
                        </div>
                    </div>

                    <!-- Right: Filter and Reset Buttons -->
                    <div class="flex space-x-2 mt-4 md:mt-0">
                        <!-- Filter Button -->
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            Filter
                        </button>

                        <!-- Reset Button -->
                        <button type="button" class="btn btn-secondary px-4 py-2" onclick="window.location = '@Url.Action("RecordLog")'">
                            Reset
                        </button>
                    </div>
                </form>

                <!-- Display Filtered Data -->
                @if (Model.Any())
                {
                    <div class="table-responsive mt-4" style="max-height: 600px; overflow-y: auto; margin: 20px 0;">
                        <table id="auditLogTable" class="table table-bordered table-striped table-hover dark:bg-[#1b2e4b] dark:text-white-light">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Message</th>
                                    <th>Action Type</th>
                                    <th>Transaction ID</th>
                                    <th>Table Name</th>
                                    <th>Performer Branch</th>
                                    <th>Transaction Date</th>
                                    <th>Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Message)</td>
                                        <td>@Html.DisplayFor(modelItem => item.ActionType)</td>
                                        <td>@Html.DisplayFor(modelItem => item.TransactionID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.TableName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.PerformerBranch)</td>
                                        <td>@Html.DisplayFor(modelItem => item.TransactionDate)</td>
                                        <td>@Html.DisplayFor(modelItem => item.User.FullName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <script>
                        $(document).ready(function () {
                            $('#auditLogTable').DataTable();
                            $('#branch').select2({
                                placeholder: 'All Branches',
                                allowClear: true,
                                width: 'resolve'
                            });
                            $('#userName').select2({
                                placeholder: 'All Users',
                                allowClear: true,
                                width: 'resolve'
                            });
                        });
                    </script>
                }
                else if (Request.QueryString.Count > 0)
                {
                    <div class="mt-6 text-center text-gray-500 dark:text-white-light">No audit logs found for the selected filter(s).</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/JS/select2.min.js"></script>
    <link rel="stylesheet" href="~/Content/CSS/select2.min.css" />
    <script>
        $(document).ready(function () {
            $('#auditLogTable').DataTable();
            $('#branch').select2({
                placeholder: 'All Branches',
                allowClear: true,
                width: 'resolve'
            });
            $('#userName').select2({
                placeholder: 'All Users',
                allowClear: true,
                width: 'resolve'
            });
        });
    </script>
}
