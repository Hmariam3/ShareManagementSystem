                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            <span>Transactions</span>
                        </h2>
                        <li class="nav-item">
                            <ul>
                                <li class="menu nav-item">
                                    <button type="button"
                                            class="nav-link group"
                                            :class="{'active' : activeDropdown === 'Subscription'}"
                                            @@click="activeDropdown === 'Subscription' ? activeDropdown = null : activeDropdown = 'Subscription'">
                                        <div class="flex items-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">

                                                <path d="M502.3 190.8l-211.8 211.8c-15 15-41 15-56 0L9.7 190.8C3.5 184.7 0 176.4 0 167.4V96c0-35.3 28.7-64 64-64h384c35.3 0 64 28.7 64 64v71.4c0 9-3.5 17.3-9.7 23.4zM448 48H64c-26.5 0-48 21.5-48 48v71.4L251.3 364.6c4.7 4.7 12.3 4.7 17 0L496 167.4V96c0-26.5-21.5-48-48-48zm8 320H56c-35.3 0-64 28.7-64 64v32c0 35.3 28.7 64 64 64h400c35.3 0 64-28.7 64-64v-32c0-35.3-28.7-64-64-64z"
                                                      fill="white" />
                                            </svg>

                                            <span class="text-white ltr:pl-3 rtl:pr-3 dark:text-[#506690] dark:group-hover:text-white-dark">Subscription</span>
                                        </div>
                                        <div class="rtl:rotate-180"
                                             :class="{'!rotate-90' : activeDropdown === 'Subscription'}">
                                            <svg width="16"
                                                 height="16"
                                                 viewbox="0 0 24 24"
                                                 fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <path d="M9 5L15 12L9 19"
                                                      stroke="currentColor"
                                                      stroke-width="1.5"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round"></path>
                                            </svg>
                                        </div>
                                    </button>
                                    <ul x-cloak=""
                                        x-show="activeDropdown === 'Subscription'"
                                        x-collapse=""
                                        class="sub-menu text-white">
                                        <li>
                                            <a href="~/Subscribtions/Create">Create Subscription</a>
                                        </li>
                                        <li>
                                            <a href="~/Subscribtions/AddSubscriprion">Add On Subscription</a>
                                        </li>
                                        <li>
                                            <a href="~/Subscribtions/Index">View Subscription</a>
                                        </li>
                                        <li>
                                            <a href="~/Subscribtions/Filter">Subscription Payment</a>
                                        </li>
                                        <li>
                                            <a href="~/Subscribtions/Compiledsubs">Compiled Subscription</a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="menu nav-item">
                                    <button type="button"
                                            class="nav-link group"
                                            :class="{'active' : activeDropdown === 'Payment'}"
                                            @@click="activeDropdown === 'Payment' ? activeDropdown = null : activeDropdown = 'Payment'">
                                        <div class="flex items-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">

                                                <path d="M0 144v-16C0 57.3 57.3 0 128 0h320c70.7 0 128 57.3 128 128v16H0zm0 64h576v240c0 70.7-57.3 128-128 128H128C57.3 512 0 454.7 0 384V208zm96 96a16 16 0 1 1 32 0 16 16 0 1 1-32 0zm320 64a16 16 0 1 1 32 0 16 16 0 1 1-32 0zm-96 0a16 16 0 1 1 32 0 16 16 0 1 1-32 0z"
                                                      fill="white" />
                                            </svg>

                                            <span class="text-white ltr:pl-3 rtl:pr-3 dark:text-[#506690] dark:group-hover:text-white-dark">Payment</span>
                                        </div>
                                        <div class="rtl:rotate-180"
                                             :class="{'!rotate-90' : activeDropdown === 'Payment'}">
                                            <svg width="16"
                                                 height="16"
                                                 viewbox="0 0 24 24"
                                                 fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <path d="M9 5L15 12L9 19"
                                                      stroke="currentColor"
                                                      stroke-width="1.5"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round"></path>
                                            </svg>
                                        </div>
                                    </button>
                                    <ul x-cloak=""
                                        x-show="activeDropdown === 'Payment'"
                                        x-collapse=""
                                        class="sub-menu text-white">
