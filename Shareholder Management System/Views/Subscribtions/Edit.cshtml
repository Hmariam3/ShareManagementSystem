
@model Shareholder_Management_System.Models.Subscribtion

@{
    ViewBag.Title = "Edit Subscription";
}

<link href="~/Scripts/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/datatables.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/select2/js/select2.min.js"></script>
<script src="~/Scripts/datatables/datatables.min.js"></script>

<link rel="stylesheet" type="text/css" media="screen" href="~/css/all.min.css" />
<!-- Include SweetAlert Library -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/sweetalert2.min.css">
<script src="~/js/sweetalert.js"></script>
<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>
<link href="~/css/tailwind.min.css" rel="stylesheet" />
<!-- CSS Includes -->
<link rel="stylesheet" href="~/css/all.min.css" />
<link rel="stylesheet" href="~/css/select2.min.css" />
<link rel="stylesheet" href="~/css/jquery.dataTables.min.css" />

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    .container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 20px;
    }

    .panel {
        width: 100%;
        max-width: 1200px;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: white;
    }

    .select2-container {
        width: 100% !important;
    }
</style>

<!-- Pop-up Modal for Success/Error Messages -->
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div id="popup-message" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
        <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md text-center">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-4 p-4 text-green-800 bg-green-100 rounded-lg">
                    <p class="text-sm font-semibold">@TempData["SuccessMessage"]</p>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-4 p-4 text-red-800 bg-red-100 rounded-lg">
                    <p class="text-sm font-semibold">@TempData["ErrorMessage"]</p>
                </div>
            }
            <button id="close-popup" class="mt-4 px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">Close</button>
        </div>
    </div>
}

<div class="container">
    @using (Html.BeginForm("Edit", "Subscribtions", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 gap-6 pt-5">
            <div class="panel">
                <div class="mb-5 flex items-center justify-between" style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                    <h5 class="text-lg font-semibold uppercase" style="padding:7px;">Edit Subscription</h5>
                </div>

                @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm mt-1" })
                @Html.HiddenFor(model => model.SubID)

                <div class="grid grid-cols-2 gap-4">
                    <!-- Left Column -->
                    <div>
                        <div class="mb-5">
                            @Html.LabelFor(model => model.ShID, "Shareholder Name", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            <select id="ShID" name="ShID" class="form-input block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" required="required">
                                <option value="@Model.ShID" selected>@ViewData["ShIDDisplayText"]</option>
                            </select>
                            @Html.ValidationMessageFor(model => model.ShID, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <div class="mb-5">
                            @Html.LabelFor(model => model.SubNumShares, "Number of Shares", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            @Html.EditorFor(model => model.SubNumShares, new { htmlAttributes = new { @class = "form-input w-full border-gray-300 rounded-md shadow-sm", @required = "required", min = "1" } })
                            @Html.ValidationMessageFor(model => model.SubNumShares, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <div class="mb-5">
                            @Html.LabelFor(model => model.Premium, "Premium", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            @Html.EditorFor(model => model.Premium, new { htmlAttributes = new { @class = "form-input w-full border-gray-300 rounded-md shadow-sm" } })
                            @Html.ValidationMessageFor(model => model.Premium, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <div class="mb-5">
                            @Html.LabelFor(model => model.SubDate, "Subscribed Date", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            @Html.EditorFor(model => model.SubDate, new { htmlAttributes = new { @class = "form-input w-full border-gray-300 rounded-md shadow-sm", type = "date", @required = "required", Value = Model.SubDate.HasValue ? Model.SubDate.Value.ToString("yyyy-MM-dd") : "" } })
                            @Html.ValidationMessageFor(model => model.SubDate, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <div class="mb-5">
                            @Html.LabelFor(model => model.SubStatus, "Subscription Status", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            @Html.EditorFor(model => model.SubStatus, new { htmlAttributes = new { @class = "form-input w-full border-gray-300 rounded-md shadow-sm", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.SubStatus, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div>
                        <div class="mb-5">
                            @Html.LabelFor(model => model.SubTransferFrom, "Share Transfer From", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            <select id="SubTransferFrom" name="SubTransferFrom" class="form-input block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                <option value="" @(Model.SubTransferFrom == null ? "selected" : "")>Not Transferred</option>
                                @if (Model.SubTransferFrom.HasValue)
                                {
                                    <option value="@Model.SubTransferFrom" selected>@ViewData["SubTransferFromDisplayText"]</option>
                                }
                            </select>
                            @Html.ValidationMessageFor(model => model.SubTransferFrom, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <div class="mb-5">
                            @Html.LabelFor(model => model.PaidSubscription, "Paid Subscription", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            @Html.EditorFor(model => model.PaidSubscription, new { htmlAttributes = new { @class = "form-input w-full border-gray-300 rounded-md shadow-sm", @required = "required" } })
                            @Html.ValidationMessageFor(model => model.PaidSubscription, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <div class="mb-5">
                            @Html.LabelFor(model => model.PaymentDueDate, "Subscription Due Date", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            @Html.EditorFor(model => model.PaymentDueDate, new { htmlAttributes = new { @class = "form-input w-full border-gray-300 rounded-md shadow-sm", type = "date", @required = "required", Value = Model.PaymentDueDate.HasValue ? Model.PaymentDueDate.Value.ToString("yyyy-MM-dd") : "" } })
                            @Html.ValidationMessageFor(model => model.PaymentDueDate, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <div class="mb-5">
                            @Html.LabelFor(model => model.Remark, "Remark", new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                            @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @class = "form-input w-full border-gray-300 rounded-md shadow-sm" } })
                            @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>
                    </div>
                </div>

                <div class="flex justify-between mt-6">
                    <input type="submit" value="Update" class="btn btn-primary px-4 py-2 bg-blue-500 hover:bg-blue-600 rounded text-white" />
                    <a href="@Url.Action("Viewall", "Subscribtions")" class="btn btn-success px-4 py-2 bg-green-500 hover:bg-green-600 rounded text-white">Back to List</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize Select2 for ShID
            $('#ShID').select2({
                placeholder: "Search for a shareholder",
                allowClear: true,
                width: '100%',
                minimumInputLength: 3,
                ajax: {
                    url: '@Url.Action("SearchShareholders", "Subscribtions")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        return {
                            results: data.items,
                            pagination: { more: data.hasMore }
                        };
                    },
                    cache: true
                }
            });

            // Initialize Select2 for SubTransferFrom
            $('#SubTransferFrom').select2({
                placeholder: "Select transfer from shareholder (optional)",
                allowClear: true,
                width: '100%',
                minimumInputLength: 3,
                ajax: {
                    url: '@Url.Action("SearchShareholders", "Subscribtions")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        return {
                            results: data.items,
                            pagination: { more: data.hasMore }
                        };
                    },
                    cache: true
                }
            });

            // Handle popup close button
            $('#close-popup').on('click', function () {
                $('#popup-message').hide();
            });

            // Auto-hide popup after 5 seconds
            if ($('#popup-message').length) {
                setTimeout(function () {
                    $('#popup-message').hide();
                }, 5000);
            }
        });
    </script>
}
