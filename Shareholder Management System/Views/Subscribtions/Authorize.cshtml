            @using (Html.BeginForm("Authorize", "Subscribtions", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="flex justify-center mt-5">
                    <div>
                        <div class="flex justify-between">
                            @if (Model.SubAuthorizationStatus == "Approved")
                            {
                                <button type="submit" class="btn btn-primary mt-6" disabled>Authorize</button>
                            }
                            else
                            {
                                <button type="submit" name="action" value="approve" class="btn btn-primary mt-6">Authorize</button>
                            }
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between" style="margin-left:5px">
                            @if (Model.SubAuthorizationStatus == "Rejected")
                            {
                                <button type="submit" class="btn btn-danger mt-6" disabled>Reject</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-danger mt-6" onclick="showRemarkField()">Reject</button>
                            }
                        </div>
                    </div>
                </div>

                <div id="remarkSection" style="display:none; margin-top: 20px;">
                    <label for="remark">Please provide a remark:</label>
                    <textarea id="remark" name="remark" rows="4" class="form-input border border-gray-300 rounded-md p-2" placeholder="Enter your remark..."></textarea>
                </div>

                <input type="hidden" name="action" id="hiddenAction" value="" />

                <button type="submit" name="action" value="reject" class="btn btn-danger mt-6" id="submitReject" style="display:none;" onclick="return validateRemark()">Submit Reject</button>
            }

            <div class="mt-8 text-right">
                <a href="@Url.Action("PendingSubscription")" class="btn btn-primary w-32 py-1 bg-green-200 hover:bg-green-200 rounded text-white text-sm text-center">Back to List</a>
            </div>

        </div>
    </div>
</div>



<script>
    function showRemarkField() {
        document.getElementById('remarkSection').style.display = 'block';
        document.getElementById('submitReject').style.display = 'inline-block';
    }

    function validateRemark() {
        var remark = document.getElementById('remark').value;
        if (!remark) {
            alert('Please Fill in the Remark Before Rejecting.');
            return false; // Prevent form submission
        }
        document.getElementById('hiddenAction').value = 'reject'; // Set hidden action for form submission
        return true; // Allow form submission
    }
</script>
