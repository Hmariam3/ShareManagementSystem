@model IEnumerable<Shareholder_Management_System.Models.Subscribtion>

@if (Model != null && Model.Any())
{
    <div class="bg-white shadow-md rounded-lg overflow-hidden panel">

        <div class="p-6 overflow-x-auto">
            <table id="subscriptionTable" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>FullName</th>
                        <th>Sub ID</th>

                        <th>
                            Number of Shares
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Premium)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SubAmount)
                        </th>
                        <th>
                            Paid Subscription
                        </th>
                        <th>
                            Unpaid Subscription
                        </th>
                        <th>
                            Due Date
                        </th>
                        <th>
                            SubStatus
                        </th>

                        <th>
                            Auth. Status
                        </th>
                        <th>Amount</th>

                        <th>Action</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Shareholder.FullNameEng)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SubID)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.SubNumShares) Shares
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Premium)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SubAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PaidSubscription)
                            </td>
                            <td style="background-color:cyan">
                                @Html.DisplayFor(modelItem => item.UnpaidSubscription)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PaymentDueDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SubStatus)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.SubAuthorizationStatus)
                            </td>

                            <td>
                                <!-- PaidAmount input field for each row -->
                                <input type="number" id="paidAmount-@item.SubID" class="form-input" placeholder="Enter Paid Amount" min="0" max="@item.UnpaidSubscription" style="width: 150px;" />

                            </td>
                            <td>
                                <div class="flex space-x-2">

                                    <!-- Pay button with JavaScript click handler -->
                                    <a href="javascript:void(0);" onclick="payNow(@item.SubID, @item.ShID)" class="btn btn-warning px-4 py-2 text-white bg-yellow-500 hover:bg-yellow-600 rounded mt-2">
                                        Pay
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <p>No subscriptions found for the given Share ID.</p>
}

<script>
        function payNow(subID, shID) {
            // Get the PaidAmount value from the input field associated with the SubID
            var paidAmount = document.getElementById('paidAmount-' + subID).value;

            // Check if a valid PaidAmount is entered
            if (paidAmount && paidAmount > 0) {
                // Redirect to the Payments Create action with SubID, ShID, and PaidAmount
                var url = '@Url.Action("CreateSubPayment", "Payments")' + '?id=' + subID + '&shareid=' + shID + '&paidAmount=' + encodeURIComponent(paidAmount);
                window.location.href = url;
            } else {
                alert('Please enter a valid Paid Amount.');
            }
        }

        // Initialize DataTables
        $(document).ready(function () {
            $('#subscriptionTable').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    'csvHtml5', 'excelHtml5', 'pdfHtml5', 'print'
                ]
            });
        });
</script>

