@model Shareholder_Management_System.Models.Subscribtion

@{
    ViewBag.Title = "Enter New Due Date";
}

<!-- Include Select2 CSS and JS -->
<link href="~/Scripts/select2/css/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/select2/js/select2.min.js"></script>

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 200px;
    }

    .panel {
        width: 900px;
        max-width: 900px;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: white;
    }
</style>

@{
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<!-- Pop-up Modal -->
@if (!string.IsNullOrEmpty(successMessage) || !string.IsNullOrEmpty(errorMessage))
{
<div id="popup-message" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md text-center">
        @if (!string.IsNullOrEmpty(successMessage))
            {
        <div class="mb-4 p-4 text-green-800 bg-green-200 rounded">
            <p class="text-lg font-semibold">@successMessage</p>
        </div>
            }

        @if (!string.IsNullOrEmpty(errorMessage))
            {
        <div class="mb-4 p-4 text-red-800 bg-red-200 rounded">
            <p class="text-lg font-semibold">@errorMessage</p>
        </div>
            }

        <button id="close-popup" class="mt-4 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
            Close
        </button>
    </div>
</div>

<script>
    document.getElementById("close-popup").addEventListener("click", function () {
        document.getElementById("popup-message").style.display = "none";
    });

    setTimeout(function () {
        document.getElementById("popup-message").style.display = "none";
    }, 1000); // Adjust timeout as needed
</script>
}

<div class="container">
    @using (Html.BeginForm("UpdateDuedate", "Subscribtions", FormMethod.Post))
    {
    @Html.AntiForgeryToken()

    <div class="panel">
        <h2 class="text-lg font-semibold mb-4">Enter New Payment Due Date For All at Once</h2>

        <div class="form-group mb-5">
            <label for="NewDueDate">Payment Due Date:</label>
            <input type="date" name="NewDueDate" class="form-input border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
        </div>

        <input type="submit" value="Set Due Date" class="btn btn-primary mt-4" />
    </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize Select2 if needed for other dropdowns
        });
    </script>
}
