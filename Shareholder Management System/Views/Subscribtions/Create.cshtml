@model Shareholder_Management_System.Models.Subscribtion

@{
    ViewBag.Title = "Create";
}

<link href="~/Scripts/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/datatables.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/select2/js/select2.min.js"></script>
<script src="~/Scripts/datatables/datatables.min.js"></script>

<link rel="stylesheet" type="text/css" media="screen" href="~/css/all.min.css" />
<!-- Include SweetAlert Library -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/sweetalert2.min.css">
<script src="~/js/sweetalert.js"></script>
<!-- Add Select2 CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/select2.min.css" />
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.11.5.dataTables.min.css" />
<link rel="stylesheet" type="text/css" media="screen" href="~/css/jquery-1.13.4.dataTables.min.css" />
<script src="~/js/jquery-3.6.0.min.js"></script>
<script src="~/js/jquery.dataTables.min.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/alpine.js"></script>
<script src="~/js/jquery-1.11.5.dataTables.min.js"></script>
<link href="~/css/tailwind.min.css" rel="stylesheet" />
<!-- CSS Includes -->
<link rel="stylesheet" href="~/css/all.min.css" />
<link rel="stylesheet" href="~/css/select2.min.css" />
<link rel="stylesheet" href="~/css/jquery.dataTables.min.css" />

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    .container {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .panel {
        width: 1200px;
        max-width: 1000px;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: white;
    }

    .select2-container {
        width: 100% !important;
    }
</style>

<!-- Pop-up Modal -->
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div id="popup-message" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
        <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md text-center">
            <!-- Success Message -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-4 p-4 text-green-800 bg-green-200 rounded">
                    <p class="text-lg font-semibold">@TempData["SuccessMessage"]</p>
                </div>
            }

            <!-- Error Message -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-4 p-4 text-red-800 bg-red-200 rounded">
                    <p class="text-lg font-semibold">@TempData["ErrorMessage"]</p>
                </div>
            }

            <!-- Close Button -->
            <button id="close-popup" class="mt-4 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                Close
            </button>
        </div>
    </div>
}

<div class="container">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-2 gap-6 pt-5 lg:grid-cols-1 mt-20">
            <div class="panel">
                <div class="mb-5 flex items-center justify-between" style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                    <h5 class="text-lg font-semibold dark:text-white-light uppercase" style="padding:7px;">Create Subscription</h5>
                </div>

                <!-- Searchable Dropdown for Shareholder -->
                <div class="mb-5 flex flex-wrap">
                    <div class="flex-1 mr-2">
                        <label>Shareholder Name<span style="color:red">*</span></label>
                        <div class="relative">
                            <select id="ShID" name="ShID" class="form-input block w-full border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" required="required"></select>
                            @Html.ValidationMessageFor(model => model.ShID, "", new { @class = "text-red-500 text-xs mt-1" })
                        </div>
                    </div>

                    <!-- Number of Shares -->
                    <div class="flex-1 ml-2">
                        <label>Number of Share Sub <span style="color:red">*</span></label>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.SubNumShares, new { htmlAttributes = new { @class = "form-input", @required = "required", @placeholder = "Enter Number of Shares", min = "1" } })
                            @Html.ValidationMessageFor(model => model.SubNumShares, "", new { @class = "text-red-500 text-xs mt-1" })
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap mb-5">
                    <!-- Subscription Due Date -->
                    <div class="flex-1 mr-2">
                        <label>Subscription Due Date <span style="color:red">*</span></label>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.PaymentDueDate, new { htmlAttributes = new { type = "date", @class = "form-input border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500", @required = "required" } })
                            @Html.ValidationMessageFor(model => model.PaymentDueDate, "", new { @class = "text-red-500 text-xs mt-1" })
                        </div>
                    </div>

                    <!-- Premium -->
                    <div class="flex-1 ml-2">
                        <label>Premium</label>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Premium, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Premium Amount" } })
                            @Html.ValidationMessageFor(model => model.Premium, "", new { @class = "text-red-500 text-xs mt-1" })
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <label>Remark</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Remark" } })
                        @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary mt-6 mx-auto">Submit</button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize Select2 for the shareholder dropdown
            $('#ShID').select2({
                placeholder: "Search for a shareholder",
                allowClear: true,
                width: '100%',
                minimumInputLength: 3,
                ajax: {
                    url: '@Url.Action("SearchShareholders", "Subscribtions")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        return {
                            results: data.items,
                            pagination: { more: data.hasMore }
                        };
                    },
                    cache: true
                }
            });

            // Handle popup close button
            $('#close-popup').on('click', function () {
                $('#popup-message').hide();
            });

            // Automatically hide the popup after 5 seconds
            if ($('#popup-message').length) {
                setTimeout(function () {
                    $('#popup-message').hide();
                }, 1000);
            }
        });
    </script>
}
