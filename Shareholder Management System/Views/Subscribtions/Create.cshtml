@model Shareholder_Management_System.Models.Subscribtion

@{
    ViewBag.Title = "Create";
}

<!-- Include Select2 CSS and JS -->
<link href="~/Scripts/select2/css/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/select2/js/select2.min.js"></script>

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    .container {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .panel {
        width: 600px;
        max-width: 600px;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: white;
    }
</style>

<div class="container">

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-2 gap-6 pt-5 lg:grid-cols-1 mt-20">
            <div class="panel">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="success-message font-semibold">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div class="mb-5 flex items-center justify-between" style="background: linear-gradient(to right, #0e1726 2%, #00adef 98%); color:white;">
                    <h5 class="text-lg font-semibold dark:text-white-light" style="padding:7px;">Create Subscription</h5>
                </div>

                <!-- Searchable Dropdown for Shareholder -->
                <div class="mb-5">
                    @Html.LabelFor(model => model.ShID, "ShID", htmlAttributes: new { @class = "block text-sm font-medium text-gray-700 mb-2" })
                    <div class="relative">
                        @Html.DropDownList("ShID", null, "Select Shareholder", new { @class = "form-input block w-full border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", @required = "required", @id = "shareholderDropdown" })
                        @Html.ValidationMessageFor(model => model.ShID, "", new { @class = "text-red-500 text-xs mt-1" })


                    </div>
                </div>

                <!-- Other Form Fields -->
                <div class="mb-5">
                    @Html.LabelFor(model => model.SubNumShares, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.SubNumShares, new { htmlAttributes = new { @class = "form-input", @required = "required", @placeholder = "Enter Number of Shares", min = "1" } })
                        @Html.ValidationMessageFor(model => model.SubNumShares, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-5">
                    @Html.LabelFor(model => model.Premium, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Premium, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Premium Amount" } })
                        @Html.ValidationMessageFor(model => model.Premium, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-5">
                    @Html.LabelFor(model => model.PaymentDueDate, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.PaymentDueDate, new { htmlAttributes = new { type = "date", @class = "form-input border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.PaymentDueDate, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="mb-5">
                    @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @class = "form-input", @placeholder = "Enter Remark" } })
                        @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                    </div>
                </div>


                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary mt-6 mx-auto">Submit</button>
            </div>
        </div>
    }
</div>


