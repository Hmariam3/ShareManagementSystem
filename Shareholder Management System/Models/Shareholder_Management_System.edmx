    [Payment_Staging].[TranferedPayId] AS [TranferedPayId], 
    [Payment_Staging].[TranferId] AS [TranferId], 
    [Payment_Staging].[TranferAmount] AS [TranferAmount], 
    [Payment_Staging].[TempID] AS [TempID]
    FROM [dbo].[Payment_Staging] AS [Payment_Staging]</DefiningQuery>
